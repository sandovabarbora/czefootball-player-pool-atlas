# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
ENV/

# Data — large files, regenerable from sources
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Notebook artifacts
.ipynb_checkpoints/

# Build outputs
dist/
build/
*.egg-info/
outputs/*.html
outputs/*.pdf
outputs/*.svg
outputs/*.png
!outputs/.gitkeep

# Fetch run logs
fetch.log
fetch_history.log
photos.log

# SeleniumBase runtime artifacts (soccerdata's FBref reader uses seleniumbase)
downloaded_files/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

node_modules/

# Secrets (none expected, defensive)
.env
.env.*
!.env.example
secrets/

# Czech render (build output)
outputs/cs/

# Site build outputs (regenerated by site/build.sh; docs/ is the published site)
outputs/benchmark_narrative.md
outputs/style.css
.worktrees/
