# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
ENV/

# Data — large files, regenerable from sources
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Notebook artifacts
.ipynb_checkpoints/

# Build outputs -- outputs/<nation>/... (e.g. outputs/cze/index.html,
# outputs/eng/atlas_FW.svg); every nation writes under its own subdirectory
# (Task 14a), so one pattern covers all of them.
dist/
build/
*.egg-info/
outputs/*/
!outputs/.gitkeep

# Fetch run logs
fetch.log
fetch_history.log
photos.log

# SeleniumBase runtime artifacts (soccerdata's FBref reader uses seleniumbase)
downloaded_files/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

node_modules/

# Secrets (none expected, defensive)
.env
.env.*
!.env.example
secrets/

.worktrees/

# SDD working notes (task briefs/reports/review diffs) -- local scratch for
# the orchestrating session, never part of the shipped repo.
.superpowers/
