+        {"player_key": "c|2002", "player": "Foreign Player", "season": "2025-2026",
+         "cluster_style": "C0", "home_eligible": False, "min": 3000},
+        {"player_key": "d|2003", "player": "Karel Dvorak", "season": "2025-2026",
