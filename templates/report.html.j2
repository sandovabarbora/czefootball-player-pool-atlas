{#- ---------------------------------------------------------------------------
   Czech football · Player pool atlas — report template, rendered once per
   language (`lang`, `t()` and `term()` come from src/i18n.py; every static
   string goes through t(), every data label through term()).
   Structure and class names follow the hockey report (docs/style.css,
   docs/modern.css, docs/atlas.js and site/ key off them). Every number on the
   page comes from the context; the only literals are years, K = 10 and ±20 %.
   --------------------------------------------------------------------------- -#}
{%- macro f2(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.2f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro f3(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.3f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro g(x) -%}{%- if x is none -%}—{%- else -%}{{ '%g' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro pct(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.0f' | format(x * 100) }} %{%- endif -%}{%- endmacro -%}
{%- macro pct1(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.1f' | format(x * 100) }} %{%- endif -%}{%- endmacro -%}
{%- macro signed(x) -%}{%- if x is none -%}—{%- else -%}{{ '%+.3f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- set topn = headline_leagues | length -%}
{%- set cze = per_capita | selectattr('country', 'equalto', 'CZE') | list | first -%}
{%- set gt = {} -%}
{%- for grp in groups %}{% set _ = gt.update({grp: term(group_titles[grp])}) %}{% endfor -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t('meta.title') }}</title>
  <meta name="description" content="{{ t('meta.description', n=hero.n_peers - 1) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ assets }}style.css">
</head>
<body>

<a class="skip-link" href="#summary">{{ t('skip') }}</a>

<nav class="toc-sticky" aria-label="{{ t('toc.aria') }}" id="toc">
  <button type="button" class="toc-toggle" aria-controls="toc" aria-expanded="true"
          aria-label="{{ t('toc.hide') }}" data-label-show="{{ t('toc.show') }}" data-label-hide="{{ t('toc.hide') }}">
    <span class="toc-toggle-glyph" aria-hidden="true"></span>
  </button>
  <p class="toc-heading">{{ t('toc.heading') }}</p>
  <ol>
    <li><a href="#summary">{{ t('toc.summary') }}</a>
      <ol>
        <li><a href="#benchmark">{{ t('toc.benchmark') }}</a></li>
        <li><a href="#observations">{{ t('toc.observations') }}</a></li>
        <li><a href="#clusters">{{ t('toc.clusters') }}</a></li>
        <li><a href="#trajectories">{{ t('toc.trajectories') }}</a></li>
      </ol>
    </li>
    <li><a href="#pathways">{{ t('toc.pathways') }}</a></li>
    <li><a href="#cards">{{ t('toc.cards_chapter') }}</a>
      <ol>
        <li><a href="#cards">{{ t('toc.cards') }}</a></li>
        <li><a href="#analogs">{{ t('toc.analogs') }}</a></li>
        <li><a href="#players">{{ t('toc.players') }}</a></li>
      </ol>
    </li>
    <li><a href="#methodology">{{ t('toc.methodology') }}</a>
      <ol>
        <li><a href="#multipliers">{{ t('toc.multipliers') }}</a></li>
        <li><a href="#shrinkage">{{ t('toc.shrinkage') }}</a></li>
        <li><a href="#pca-loadings">{{ t('toc.pca') }}</a></li>
        <li><a href="#sensitivity">{{ t('toc.sensitivity') }}</a></li>
        <li><a href="#limitations">{{ t('toc.limitations') }}</a></li>
        <li><a href="#reproducibility">{{ t('toc.reproducibility') }}</a></li>
      </ol>
    </li>
  </ol>
</nav>

<header class="report-header">
  <div class="container">
    <p class="masthead-kicker">{{ t('mast.kicker', season=seasons.current) }}</p>
    <h1>{{ t('mast.title') }}</h1>
    <p class="masthead-subtitle">{{ t('mast.subtitle') }}</p>
    <dl class="masthead-meta">
      <div><dt>{{ t('mast.pool') }}</dt> <dd>{{ t('mast.pool_value', n=facts.n_pool) }}</dd></div>
      <div><dt>{{ t('mast.with_metrics', season=seasons.metrics) }}</dt> <dd><strong>{{ facts.n_with_metrics }}</strong></dd></div>
      <div><dt>{{ t('mast.nt', nt_years=facts.nt_years) }}</dt> <dd><strong>{{ facts.n_nt_flagged }}</strong></dd></div>
    </dl>

    <details class="toc-mobile" open>
      <summary>{{ t('toc.aria') }}</summary>
      <ol>
        <li><a href="#summary">{{ t('toc.summary') }}</a> · <a href="#benchmark">{{ t('toc.short.benchmark') }}</a> · <a href="#observations">{{ t('toc.observations') }}</a> · <a href="#clusters">{{ t('toc.clusters') }}</a> · <a href="#trajectories">{{ t('toc.trajectories') }}</a></li>
        <li><a href="#pathways">{{ t('toc.pathways') }}</a> · <a href="#cards">{{ t('toc.short.cards') }}</a> · <a href="#analogs">{{ t('toc.short.analogs') }}</a> · <a href="#players">{{ t('toc.players') }}</a></li>
        <li><a href="#methodology">{{ t('toc.methodology') }}</a> · <a href="#multipliers">{{ t('toc.short.multipliers') }}</a> · <a href="#shrinkage">{{ t('toc.short.shrinkage') }}</a> · <a href="#pca-loadings">{{ t('toc.short.pca') }}</a> · <a href="#sensitivity">{{ t('toc.short.sensitivity') }}</a> · <a href="#limitations">{{ t('toc.short.limitations') }}</a></li>
      </ol>
    </details>
  </div>
</header>

{# =============================================================================
   HERO BAND — drenched navy with the headline number
   ============================================================================= #}
<section class="hero" id="summary">
  <aside class="hero-stamp" aria-label="{{ t('hero.stamp.aria') }}">
    <p class="hero-stamp-line">{{ t('hero.stamp.report') }}</p>
    <p class="hero-stamp-line"><strong>{{ t('hero.stamp.atlas', season=seasons.current) }}</strong></p>
    <p class="hero-stamp-line">{{ t('hero.stamp.edition') }}</p>
  </aside>
  <div class="container">
    <p class="hero-kicker">{{ t('hero.kicker') }}</p>
    <h2>{{ t('hero.h2') }}</h2>
    <div class="hero-grid">
      <div class="hero-num">
        <span class="hero-num-figure">{{ '%.2f' | format(hero.per_million) }}<span class="ast" aria-hidden="true">*</span></span>
        <span class="hero-num-unit">{{ t('hero.unit', topn=topn, season=seasons.metrics) }}</span>
      </div>
      <div class="hero-lead">
        <p>
          {{ t('hero.lead', topn=topn, rank=ordinal(hero.rank), n=hero.n_peers, top=term(hero.top.name),
               top_pm=f2(hero.top.per_million), ratio=('%.1f' | format(hero.top.per_million / hero.per_million))) }}
        </p>
        <p class="hero-sublead">
          {% if hero.gap %}{{ t('hero.sublead.gap', group=gt[hero.gap.pos_group] | lower, cohort=hero.gap.cohort, cze_n=hero.gap.cze_n,
                                s=('' if hero.gap.cze_n == 1 or lang != 'en' else 's'), topn=topn, peer=g(hero.gap.peer_median_n)) }}{% endif %}
          {% if hero.export_cze and hero.export_den %}{{ t('hero.sublead.export', topn=topn, cze=g(hero.export_cze.median_export_age_recent), den=g(hero.export_den.median_export_age_recent)) }}{% endif %}
          {{ t('hero.sublead.close') }}
        </p>
      </div>
    </div>
    <ul class="hero-tiles" aria-label="{{ t('hero.tiles.aria') }}">
      <li><strong>{{ hero.rank }}<span>/{{ hero.n_peers }}</span></strong><span class="hero-tile-label">{{ t('hero.tile.rank') }}</span></li>
      {% if hero.gap %}<li><strong>{{ hero.gap.cze_n }}</strong><span class="hero-tile-label">{{ t('hero.tile.gap', group=gt[hero.gap.pos_group] | lower, cohort=hero.gap.cohort, topn=topn, peer=g(hero.gap.peer_median_n)) }}</span></li>{% endif %}
      {% if hero.export_cze and hero.export_den %}<li><strong>{{ g(hero.export_cze.median_export_age_recent) }}</strong><span class="hero-tile-label">{{ t('hero.tile.export', den=g(hero.export_den.median_export_age_recent)) }}</span></li>{% endif %}
    </ul>
    <p class="hero-footnote">{{ t('hero.footnote', n=hero.n_players, season=seasons.metrics, topn=topn, pop=('%.1f' | format(hero.population_m))) }}</p>
    <dl class="hero-meta">
      <div><dt>{{ t('hero.meta.pool') }}</dt> <dd>{{ t('hero.meta.pool_value', n=facts.n_with_metrics, season=seasons.metrics) }}</dd></div>
      <div><dt>{{ t('hero.meta.nt', nt_years=facts.nt_years) }}</dt> <dd>{{ t('hero.meta.nt_value', n=facts.n_nt_flagged) }}</dd></div>
      <div><dt>{{ t('hero.meta.frame') }}</dt> <dd>{{ t('hero.meta.frame_value', previous=seasons.previous, metrics=seasons.metrics, current=seasons.current) }}</dd></div>
    </dl>
  </div>
</section>

{# =============================================================================
   CHAPTER I — EXECUTIVE SUMMARY
   ============================================================================= #}
<section class="exec-summary">
  <div class="container">
    <p class="framing">{{ t('ch1.framing', n=facts.n_with_metrics, season=seasons.metrics, peers=hero.n_peers - 1) }}</p>

    <h3 id="benchmark">{{ t('ch1.benchmark.h3') }}</h3>
    <p>{{ t('ch1.benchmark.p') }}</p>

    <h4>{{ t('ch1.capita.h4', topn=topn, season=seasons.current) }}</h4>
    <div class="capita" role="list" aria-label="{{ t('ch1.capita.aria') }}">
      {% for r in per_capita %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.per_million }}; --max: {{ max_per_million }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ term(r.name) }}
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ f2(r.per_million) }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="capita-note">
      {{ t('ch1.capita.note', season=seasons.current, topn=topn, leagues=headline_leagues | join(', '), n=cze.n_players,
           pop=('%.2f' | format(cze.population_m)), pm=f2(cze.per_million), rank=cze.rank, total=per_capita | length) }}
    </p>

    <figure class="figure-bleed" data-atlas="heatmap">
      <img src="{{ assets }}intl_cohort_heatmap.svg"
           alt="{{ t('ch1.heatmap.alt', n=hero.n_peers, season=seasons.metrics) }}">
      <figcaption>{{ t('ch1.heatmap.caption', season=seasons.metrics) }}</figcaption>
    </figure>

    {% for grp in groups %}
    <h4>{{ t('ch1.cohorts.h4', group=gt[grp] | lower) }}</h4>
    <table class="cohort-table">
      <thead>
        <tr>
          <th>{{ t('ch1.cohorts.th') }}</th>
          {% for cc in cohort_countries %}<th{% if cc == 'CZE' %} class="cohort-cze"{% endif %}>{{ cc }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for r in cohorts[grp] %}
        <tr>
          <td>{{ r.cohort }}</td>
          {% for cc in cohort_countries %}
            {% set cell = r.cells[cc] %}
            <td{% if cc == 'CZE' %} class="cohort-cze"{% endif %}>
              {% if cell.n > 0 %}
                <span class="cohort-cell-n">{{ cell.n }}</span><span class="cohort-cell-median">{{ f2(cell.median) }}</span>
              {% else %}
                <span class="muted" title="{{ t('ch1.cohorts.none') }}">—</span>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endfor %}
    {% set gap_items = [] %}
    {% for r in cohort_gaps[:3] %}{% set _ = gap_items.append(t('ch1.cohorts.gap_item', group=gt[r.pos_group] | lower, cohort=r.cohort, cze=r.cze_n, peer=g(r.peer_median_n))) %}{% endfor %}
    <p class="capita-note">
      {{ t('ch1.cohorts.note', topn=topn, season=seasons.metrics, min=feature_defs.min_minutes, shown=cohort_countries | length,
           n=hero.n_peers, gaps=gap_items | join(', ')) }}
    </p>

    {% for grp in groups %}
    {% set note = atlas_notes[grp] %}
    <figure class="figure-bleed" data-atlas="{{ grp | lower }}" data-cluster-names='{{ cluster_names.get(grp, {}) | tojson }}'>
      <img src="{{ assets }}atlas_{{ grp }}.svg"
           alt="{{ t('ch1.atlas.alt', group=gt[grp] | lower, season=seasons.metrics, corpus=note.n_corpus, czech=note.n_czech, nt=note.n_nt) }}">
      <figcaption>{{ t('ch1.atlas.caption', group=gt[grp] | lower, season=seasons.metrics, corpus=note.n_corpus, czech=note.n_czech, nt=note.n_nt, nt_years=facts.nt_years) }}</figcaption>
    </figure>
    {% endfor %}

    <h3 id="observations">{{ t('ch1.observations.h3') }}</h3>
    <div class="observations">
      {% for obs in observations %}
      <div class="observation">
        <h4>{{ obs.title }}</h4>
        <p>{{ obs.body }}</p>
      </div>
      {% endfor %}
    </div>

    <h3 id="clusters">{{ t('ch1.clusters.h3') }}</h3>
    <p>{{ t('ch1.clusters.p', season=seasons.metrics) }}</p>
    {% for grp in groups %}
    <h4>{{ gt[grp] }}</h4>
    <dl class="cluster-list" data-atlas-clusters="{{ grp | lower }}">
      {% for c in clusters[grp] %}
      <dt>
        <span class="cluster-id">{{ c.id }}</span>
        <span>
          {{ c.label }}
          <span class="cluster-meta-inline">
            {{ t('ch1.clusters.meta', n=c.n, corpus=c.n_corpus, nt=c.nt_pool, born=('—' if c.median_born is none else c.median_born)) }}
          </span>
        </span>
      </dt>
      <dd>
        {{ t('ch1.clusters.medians', npg=f2(c.medians.npg_p90), ast=f2(c.medians.ast_p90), share=pct(c.medians.min_share), age=g(c.medians.age), cards=f2(c.medians.cards_p90)) }}
        {% if c.tactical %}
        <span class="cluster-tactical"><span class="cluster-tactical-label">{{ t('ch1.clusters.tactical') }}</span>{{ c.tactical }}</span>
        {% endif %}
        {% if c.top %}<span class="cluster-top">{% for name in c.top %}<span class="cluster-top-name" data-player-key="{{ c.top_keys[loop.index0] }}">{{ name }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
      </dd>
      {% endfor %}
    </dl>
    {% endfor %}

    <h3 id="trajectories">{{ t('ch1.traj.h3', previous=seasons.previous, metrics=seasons.metrics, min=thresholds.min_minutes) }}</h3>
    <p>{{ t('ch1.traj.p', band=f2(thresholds.direction)) }}</p>
    {% for grp in groups %}
    {% set m = movers[grp] %}
    <h4>{{ t('ch1.traj.h4', group=gt[grp], n=m.n_czech, up=m.directions.improving, stable=m.directions.stable, down=m.directions.declining) }}</h4>
    <div class="movers-grid">
      <div class="movers-col">
        <h4>{{ t('ch1.traj.up') }}</h4>
        <table class="movers-table">
          <thead><tr><th>{{ t('ch1.traj.th.player') }}</th><th>{{ t('ch1.traj.th.league') }}</th><th>{{ t('ch1.traj.th.min', previous=seasons.previous, metrics=seasons.metrics) }}</th><th>Δ</th></tr></thead>
          <tbody>
            {% for r in m.up %}
            <tr>
              <td data-player-key="{{ r.player_key }}">{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-up">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">{{ t('ch1.traj.none_up') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="movers-col">
        <h4>{{ t('ch1.traj.down') }}</h4>
        <table class="movers-table">
          <thead><tr><th>{{ t('ch1.traj.th.player') }}</th><th>{{ t('ch1.traj.th.league') }}</th><th>{{ t('ch1.traj.th.min', previous=seasons.previous, metrics=seasons.metrics) }}</th><th>Δ</th></tr></thead>
          <tbody>
            {% for r in m.down %}
            <tr>
              <td data-player-key="{{ r.player_key }}">{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-down">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">{{ t('ch1.traj.none_down') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endfor %}

    <p class="continue">{{ t('ch1.continue') }}</p>
  </div>
</section>

{# =============================================================================
   CHAPTER II — WHERE THE TRAIN LEAVES (pathways and differences)
   ============================================================================= #}
{% set pw = pathways %}
<aside class="chapter-divider" role="separator" aria-label="{{ t('ch2.aria') }}">
  <p class="chapter-numeral">II</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">{{ t('ch2.title') }}</p>
  <p class="chapter-synopsis">{{ t('ch2.synopsis', topn=topn) }}</p>
</aside>

<section class="ai-layer">
  <div class="container">
    <h2 id="pathways">{{ t('toc.pathways') }}</h2>
    <p class="framing">{{ t('ch2.framing', n=pw.n_countries - 1) }}</p>

    <h3>{{ t('ch2.a.h3') }}</h3>
    <p>
      {{ t('ch2.a.p', season=seasons.metrics) }}
      {% if pw.youth_cze and pw.youth_cze.share_u21 is not none %}{{ t('ch2.a.cze', share=pct1(pw.youth_cze.share_u21), rank=ordinal(pw.youth_rank),
           n=pw.youth | selectattr('share_u21', 'ne', none) | list | length, top=term(pw.youth_top.name), top_share=pct1(pw.youth_top.share_u21)) }}{% endif %}
    </p>
    {% set youth_max = pw.youth | map(attribute='share_u21') | reject('none') | max %}
    <div class="capita" role="list" aria-label="{{ t('ch2.a.aria') }}">
      {% for r in pw.youth %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.share_u21 if r.share_u21 is not none else 0 }}; --max: {{ youth_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ r.league }}
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{% if r.share_u21 is none %}<span class="muted" title="{{ t('ch2.a.nodata') }}">—</span>{% else %}{{ pct1(r.share_u21) }}{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    {% set u23 = [] %}
    {% for r in pw.youth if r.share_u23 is not none %}{% set _ = u23.append(r.country ~ ' ' ~ pct1(r.share_u23)) %}{% endfor %}
    <p class="capita-note">{{ t('ch2.a.note', season=seasons.metrics, u23=u23 | join(', ')) }}</p>

    <h3>{{ t('ch2.b.h3') }}</h3>
    <p>
      {{ t('ch2.b.p', current=seasons.current, topn=topn) }}
      {% if pw.export_cze %}{{ t('ch2.b.cze', n=pw.export_cze.n, age=g(pw.export_cze.median_export_age), n_recent=pw.export_cze.n_recent,
           age_recent=g(pw.export_cze.median_export_age_recent), domestic=pct(pw.export_cze.origin.domestic)) }}{% endif %}
    </p>
    <table class="kv-table">
      <thead>
        <tr>
          <th>{{ t('ch2.b.th.country') }}</th><th>n</th><th>{{ t('ch2.b.th.recent') }}</th>
          <th>{{ t('ch2.b.th.age_all') }}</th><th>{{ t('ch2.b.th.age_recent') }}</th>
          <th>{{ t('ch2.b.th.domestic') }}</th><th>{{ t('ch2.b.th.stepping') }}</th><th>{{ t('ch2.b.th.other', topn=topn) }}</th><th>{{ t('ch2.b.th.not_covered') }}</th>
          <th>{{ t('ch2.b.th.censored') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in pw.export %}
        <tr{% if r.country == 'CZE' %} class="cohort-cze"{% endif %}>
          <td><span class="capita-code">{{ r.country }}</span> {{ term(r.name) }}</td>
          <td>{{ r.n }}</td>
          <td>{{ r.n_recent }}</td>
          <td>{{ g(r.median_export_age) }}</td>
          <td>{{ g(r.median_export_age_recent) }}</td>
          <td>{{ pct(r.origin.domestic) }}</td>
          <td>{{ pct(r.origin.stepping_stone) }}</td>
          <td>{{ pct(r.origin.other_top9) }}</td>
          <td>{{ pct(r.origin.not_covered) }}</td>
          <td class="muted">{{ pct(r.censored_share) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">
      {{ t('ch2.b.note', start=seasons.history_start, topn=topn, metrics=seasons.metrics, current=seasons.current, coverage=facts.coverage_start, stepping=stepping_stone | join(', ')) }}
    </p>

    <h3>{{ t('ch2.c.h3') }}</h3>
    <p>
      {{ t('ch2.c.p', topn=topn, season=seasons.metrics) }}
      {% if pw.fare_min_cze and pw.fare_goals_cze %}{{ t('ch2.c.cze', share=pct(pw.fare_min_cze.value), rank_min=ordinal(pw.fare_min_rank), n_min=pw.fare_min | length,
           goals=pct(pw.fare_goals_cze.value), rank_goals=ordinal(pw.fare_goals_rank), n_goals=pw.fare_goals | length) }}{% endif %}
    </p>
    <h4>{{ t('ch2.c.h4.min', topn=topn) }}</h4>
    {% set fare_min_max = pw.fare_min | map(attribute='value') | max %}
    <div class="capita" role="list" aria-label="{{ t('ch2.c.aria.min') }}">
      {% for r in pw.fare_min %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.value }}; --max: {{ fare_min_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ term(r.name) }} <span class="muted small">n = {{ r.n }}</span>
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(r.value) }}</div>
      </div>
      {% endfor %}
    </div>
    <h4>{{ t('ch2.c.h4.goals') }}</h4>
    {% set fare_goals_max = pw.fare_goals | map(attribute='value') | max %}
    <div class="capita" role="list" aria-label="{{ t('ch2.c.aria.goals') }}">
      {% for r in pw.fare_goals %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.value }}; --max: {{ fare_goals_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ term(r.name) }} <span class="muted small">n = {{ r.n }}</span>
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(r.value) }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="capita-note">{{ t('ch2.c.note', season=seasons.metrics, proxy=term(pw.club_strength_proxy)) }}</p>

    <h3>{{ t('ch2.d.h3') }}</h3>
    <p>{{ t('ch2.d.p', season=seasons.metrics, topn=topn) }}</p>
    <details class="fold fold-table">
      <summary>{{ t('ch2.d.summary') }}</summary>
      <table class="kv-table">
        <thead>
          <tr><th>{{ t('ch2.d.th.tier') }}</th><th>{{ t('ch2.d.th.group') }}</th><th>{{ t('ch2.d.th.cze_n') }}</th><th>{{ t('ch2.d.th.cze_median') }}</th><th>{{ t('ch2.d.th.peer_n') }}</th><th>{{ t('ch2.d.th.peer_median') }}</th></tr>
        </thead>
        <tbody>
          {% for r in pw.profile %}
          <tr>
            <td>{{ term(r.tier_label) }}</td>
            <td>{{ r.pos_group }}</td>
            <td class="cohort-cze">{{ r.cze_n }}</td>
            <td class="cohort-cze">{{ f2(r.cze_median) }}</td>
            <td>{{ g(r.peer_median_n) }}</td>
            <td>{{ f2(r.peer_median) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    <p class="capita-note">{{ t('ch2.d.note', season=seasons.metrics) }}</p>

    {% if pathways.destinations %}
    {% set dest = pathways.destinations %}
    <h3>{{ t('ch2.e.h3') }}</h3>
    {% set bucket_items = [] %}
    {% for b in dest.buckets %}{% set _ = bucket_items.append(term(b.label) ~ ' ' ~ pct(b.share_of_abroad)) %}{% endfor %}
    <p>
      {{ t('ch2.e.p', total=dest.n_total, abroad=dest.n_abroad) }}{% if dest.buckets %} {{ t('ch2.e.buckets', buckets=bucket_items | join(', '), sideways=pct(dest.sideways_share), definition=term(dest.sideways_definition)) }}{% endif %}
    </p>
    {% if dest.buckets %}
    {% set dest_max = dest.buckets | map(attribute='share_of_abroad') | max %}
    <div class="capita" role="list" aria-label="{{ t('ch2.e.aria') }}">
      {% for b in dest.buckets %}
      <div class="capita-row" role="listitem" style="--value: {{ b.share_of_abroad }}; --max: {{ dest_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ b.n }}</span>
          {{ term(b.label) }}{% if b.median_multiplier is not none %} <span class="muted small">{{ t('ch2.e.median_mult', m=f3(b.median_multiplier)) }}</span>{% endif %}
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(b.share_of_abroad) }}</div>
      </div>
      {% endfor %}
    </div>
    <ul class="small dest-examples">
      {% for b in dest.buckets if b.examples %}
      <li><span class="capita-code">{{ term(b.label) }}</span> <code>{{ b.examples | join(' · ') }}</code></li>
      {% endfor %}
    </ul>
    <p class="capita-note">{{ t('ch2.e.note', season=seasons.metrics, definition=term(dest.sideways_definition)) }}</p>
    {% endif %}
    {% endif %}
  </div>
</section>

{# =============================================================================
   CHAPTER III — CARDS AND ANALOGS
   ============================================================================= #}
<aside class="chapter-divider" role="separator" aria-label="{{ t('ch3.aria') }}">
  <p class="chapter-numeral">III</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">{{ t('ch3.title') }}</p>
  <p class="chapter-synopsis">{{ t('ch3.synopsis', n=cards | length, topn=topn) }}</p>
</aside>

<section class="ai-layer">
  <div class="container">
    <h2 id="cards">{{ t('ch3.cards.h2') }}</h2>
    <p class="framing">{{ t('ch3.cards.framing', metrics=seasons.metrics, previous=seasons.previous, n=(cards[0].analogs | length if cards else 0), current=seasons.current) }}</p>
    {% for row in card_rows %}
    <p class="cycle-row-kicker">{{ row.kicker }}</p>
    <div class="cycle-grid">
      {% for p in row.cards %}
      <article class="cycle-card" id="card-{{ p.fbref_id }}" data-player-key="{{ p.player_key }}" data-fbref-id="{{ p.fbref_id }}" data-rule="{{ p.reason }}" data-pos="{{ p.pos }}" data-club="{{ p.club }}">
        <header class="cycle-card-head">
          <h4 class="cycle-card-name">{{ p.name }}</h4>
          <p class="cycle-card-meta">
            {{ p.pos }} &middot; {{ p.age_current }} &middot; {{ p.club }} ({{ t('ch3.card.latest_known') if p.club_label == 'latest known' else p.club_label }}){% if p.nt_flag %} &middot; {{ t('ch3.card.nt', nt_years=facts.nt_years) }}{% endif %}
          </p>
        </header>

        <p class="cycle-card-meta cycle-stats-head">{{ seasons.metrics }} &middot; {{ p.club_season }} &middot; {{ p.league }}</p>
        <dl class="cycle-stats">
          <div><dt>{{ t('ch3.card.stat.q') }}</dt><dd>{{ f2(p.stats.npg_ast_q) }}</dd></div>
          <div><dt>{{ t('ch3.card.stat.rates') }}</dt><dd>{{ f2(p.stats.npg_p90) }} / {{ f2(p.stats.ast_p90) }}</dd></div>
          <div><dt>{{ t('ch3.card.stat.min') }}</dt><dd>{{ p.stats.min }} ({{ pct(p.stats.min_share) }})</dd></div>
        </dl>

        <div class="cycle-cluster">
          <span class="cycle-cluster-row">
            <span class="cycle-cluster-tag">{{ t('ch3.card.style') }}</span>
            <span class="cycle-cluster-pill">{{ p.clusters.style.id }}</span>
            <span class="cycle-cluster-label">{{ p.clusters.style.label }}</span>
          </span>
          <span class="cycle-cluster-row">
            <span class="cycle-cluster-tag">{{ t('ch3.card.quality') }}</span>
            <span class="cycle-cluster-pill">{{ p.clusters.quality.id }}</span>
            <span class="cycle-cluster-label">{{ p.clusters.quality.label }}</span>
          </span>
        </div>

        {% if p.tactical %}
        <div class="cycle-section">
          <p class="cycle-section-label">{{ t('ch3.card.tactical') }}</p>
          <p class="cycle-tactical">{{ p.tactical }}</p>
        </div>
        {% endif %}

        {% if p.trajectory %}
        <div class="cycle-section">
          <p class="cycle-section-label">{{ t('ch3.card.traj', previous=seasons.previous, metrics=seasons.metrics) }}</p>
          <p class="cycle-traj">
            <span class="cycle-traj-delta">Δ {{ signed(p.trajectory.delta) }} npG+A/90</span>
            <span class="cycle-traj-dir">{{ term(p.trajectory.direction) }}</span>
            <span class="cycle-traj-detail">{{ p.trajectory.min_prev }} {{ t('ch3.card.min') }} &rarr; {{ p.trajectory.min_curr }} {{ t('ch3.card.min') }}</span>
          </p>
        </div>
        {% endif %}

        {% if p.analogs %}
        <div class="cycle-section">
          <p class="cycle-section-label">{{ t('ch3.card.analogs', age=p.analog_age) }}</p>
          <ol class="cycle-analogs">
            {% for a in p.analogs %}
            <li>
              <span class="cycle-analog-name">{{ a.name }}</span>
              <span class="cycle-analog-country">{{ a.nation }}</span>
              <span class="cycle-analog-stats">
                {{ a.league }} {{ a.season }} &middot; {{ a.min }} {{ t('ch3.card.min') }} &middot; {{ f2(a.npg_ast_q) }} &middot;
                d&nbsp;=&nbsp;{{ f2(a.distance) }}
              </span>
            </li>
            {% endfor %}
          </ol>
        </div>
        {% endif %}

        {% if p.nt_events %}
        <p class="cycle-card-meta">{{ p.nt_events | join(' · ') }}</p>
        {% endif %}
        <p class="muted small">{{ t('ch3.card.selected', reason=reason(p.reason)) }}</p>
      </article>
      {% endfor %}
    </div>
    {% endfor %}
    <p class="capita-note">{{ t('ch3.cards.note', current=seasons.current, latest=t('ch3.card.latest_known')) }}</p>

    <h3 id="analogs">{{ t('ch3.analogs.h3') }}</h3>
    <p>{{ t('ch3.analogs.p', n=(analog_blocks[0].analogs | length if analog_blocks else 0), topn=topn, start=seasons.history_start, coverage=facts.coverage_start) }}</p>
    {% for tb in analog_blocks %}
    <div class="analog-block" data-player-key="{{ tb.player_key }}">
      <div class="analog-target">
        <p class="analog-label">{{ t('ch3.analogs.target') }}</p>
        <p class="analog-name">{{ tb.target.name }}</p>
        <p class="analog-stats">
          {{ t('ch3.analogs.target_stats', group=tb.pos_group, age=tb.target.age, league=tb.target.league, season=tb.target.season, min=tb.target.min, q=f2(tb.target.npg_ast_q)) }}
        </p>
        <p class="analog-cohort">{{ t('ch3.analogs.cohort', n=tb.analogs | length) }}</p>
      </div>
      <ol class="analog-list">
        {% for a in tb.analogs %}
        <li class="analog-row">
          <div class="analog-row-head">
            <span class="analog-rank">{{ a.rank }}</span>
            <span class="analog-row-name">{{ a.name }}</span>
            <span class="analog-row-country">{{ a.nation }}</span>
            <span class="analog-row-context">
              {{ t('ch3.analogs.row', league=a.league, season=a.season, min=a.min, q=f2(a.npg_ast_q), d=f2(a.distance)) }}
            </span>
          </div>
          {% if a.followed %}
          <div class="analog-row-trajectory">
            <span class="analog-traj-label">{{ t('ch3.analogs.followed') }}</span>
            {% for s in a.followed %}
            <span class="analog-traj-step">
              {{ s.season }}&nbsp;
              <span class="analog-traj-detail">{{ s.league }}&nbsp;&middot;&nbsp;{{ s.min }}&nbsp;{{ t('ch3.card.min') }}&nbsp;&middot;&nbsp;{{ f2(s.npg_ast_q) }}</span>
            </span>
            {% endfor %}
          </div>
          {% else %}
          <div class="analog-row-trajectory"><span class="analog-traj-label">{{ t('ch3.analogs.none') }}</span></div>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
    <p class="capita-note">{{ t('ch3.analogs.note', min=feature_defs.min_minutes, start=seasons.history_start, current=seasons.current, coverage=facts.coverage_start) }}</p>
  </div>
</section>

{# =============================================================================
   PLAYER INDEX — every mapped Czech player with the metrics-season numbers
   ============================================================================= #}
<section class="player-index" id="players">
  <div class="container">
    <h2>{{ t('pi.h2') }}</h2>
    <p class="framing">{{ t('pi.framing', season=seasons.metrics, n=player_index | length) }}</p>
    <div class="player-index-tools">
      <label for="player-search">{{ t('pi.search') }}</label>
      <input type="search" id="player-search" placeholder="{{ t('pi.search.placeholder') }}" autocomplete="off" spellcheck="false">
      <span class="player-index-count" aria-live="polite" data-total="{{ player_index | length }}">{{ player_index | length }}</span>
    </div>
    <details class="fold fold-table player-index-fold">
      <summary>{{ t('pi.summary', n=player_index | length) }}</summary>
    <table class="player-index-table">
      <thead>
        <tr>
          <th>{{ t('pi.th.player') }}</th><th>{{ t('pi.th.pos') }}</th><th>{{ t('pi.th.age') }}</th>
          <th>{{ t('pi.th.club') }}</th><th>{{ t('pi.th.league') }}</th><th>{{ t('pi.th.min') }}</th>
          <th>{{ t('pi.th.q') }}</th><th>{{ t('pi.th.cluster') }}</th><th>{{ t('pi.th.nt') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in player_index %}
        <tr data-player-key="{{ r.player_key }}" data-fbref-id="{{ r.fbref_id }}" data-name="{{ r.ascii_name }}">
          <td>{% if r.card_id %}<a href="#card-{{ r.card_id }}">{{ r.player }}</a>{% else %}{{ r.player }}{% endif %}</td>
          <td>{{ r.pos_group }}</td>
          <td>{{ r.age if r.age is not none else '—' }}</td>
          <td>{{ r.club }}</td>
          <td class="muted">{{ r.league }}</td>
          <td>{{ r.min }}</td>
          <td>{{ f2(r.npg_ast_q) }}</td>
          <td><span class="cluster-id">{{ r.cluster_style }}</span> {{ r.cluster_label }}</td>
          <td>{% if r.nt_flag %}{{ t('pi.nt_yes') }}{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </details>
    <p class="capita-note">{{ t('pi.note', season=seasons.metrics, min=feature_defs.min_minutes, nt_years=facts.nt_years) }}</p>
  </div>
</section>

{# =============================================================================
   CHAPTER IV — METHODOLOGY
   ============================================================================= #}
<aside class="chapter-divider" role="separator" aria-label="{{ t('ch4.aria') }}">
  <p class="chapter-numeral">IV</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">{{ t('ch4.title') }}</p>
  <p class="chapter-synopsis">{{ t('ch4.synopsis') }}</p>
</aside>

<section class="methodology">
  <div class="container">
    <h2 id="methodology">{{ t('ch4.h2') }}</h2>

    <h3 id="data-sources">{{ t('ch4.sources.h3') }}</h3>
    <ul>
      <li>{{ t('ch4.sources.fbref', topn=topn) }}</li>
      <li>{{ t('ch4.sources.wikipedia', events=facts.nt_events) }}</li>
      <li>{{ t('ch4.sources.wikidata') }}</li>
      <li>{{ t('ch4.sources.uefa') }}</li>
      <li>{{ t('ch4.sources.eurostat') }}</li>
    </ul>

    <h3 id="multipliers">{{ t('ch4.mult.h3') }}</h3>
    <p class="formula" data-tex="{{ t('ch4.mult.tex') }}">{{ t('ch4.mult.formula') }}</p>
    <table class="kv-table">
      <thead><tr><th>{{ t('ch4.mult.th.league') }}</th><th>{{ t('ch4.mult.th.value') }}</th></tr></thead>
      <tbody>
        {% for r in multipliers %}
        <tr><td>{{ r.league }}</td><td>{{ f3(r.value) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="muted small">{{ t('ch4.mult.method', method=multiplier_method, source=term(multiplier_source)) }}</p>

    <h3 id="shrinkage">{{ t('ch4.shrink.h3') }}</h3>
    <p>{{ t('ch4.shrink.p1', phantom=feature_defs.phantom_minutes) }}</p>
    <p class="formula" data-tex="{{ t('ch4.shrink.tex') }}">{{ t('ch4.shrink.formula') }}</p>
    <p>{{ t('ch4.shrink.p2', min=feature_defs.min_minutes, weight=pct(feature_defs.phantom_minutes / (feature_defs.min_minutes + feature_defs.phantom_minutes)), phantom=feature_defs.phantom_minutes) }}</p>

    <h3 id="pca-loadings">{{ t('ch4.pca.h3') }}</h3>
    <p>{{ t('ch4.pca.p', features=feature_defs.features | join(', ')) }}</p>
    <table class="loadings-table">
      <thead>
        <tr>
          <th>{{ t('ch4.pca.th.group') }}</th><th>{{ t('ch4.pca.th.projection') }}</th><th>PC</th><th>{{ t('ch4.pca.th.variance') }}</th>
          <th>npG/90</th><th>A/90</th><th>{{ t('ch4.pca.th.share') }}</th><th>{{ t('ch4.pca.th.age') }}</th><th>cards/90</th>
        </tr>
      </thead>
      <tbody>
        {% for r in loadings %}
        <tr>
          <td>{{ r.position }}</td>
          <td>{{ r.projection }}</td>
          <td>{{ r.pc }}</td>
          <td>{{ r.explained_pct }} %</td>
          <td>{{ f3(r.npg_p90) }}</td>
          <td>{{ f3(r.ast_p90) }}</td>
          <td>{{ f3(r.min_share) }}</td>
          <td>{{ f3(r.age) }}</td>
          <td>{{ f3(r.cards_p90) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h3 id="sensitivity">{{ t('ch4.sens.h3') }}</h3>
    <p>
      {{ t('ch4.sens.p', groups=groups | length, base=sensitivity.baseline_top10, n=sensitivity.n_scenarios, zero=sensitivity.n_zero_churn, churn=sensitivity.max_churn,
           worst=(t('ch4.sens.worst', description=sensitivity.worst.description, delta=f2(sensitivity.worst.mean_delta)) if sensitivity.worst else '')) }}
    </p>
    <table class="sensitivity-table">
      <thead>
        <tr>
          <th>{{ t('ch4.sens.th.scenario') }}</th><th>{{ t('ch4.sens.th.description') }}</th>
          <th>{{ t('ch4.sens.th.overlap') }}</th><th>{{ t('ch4.sens.th.churn') }}</th><th>{{ t('ch4.sens.th.delta') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in sensitivity.rows %}
        <tr>
          <td>{{ r.scenario }}</td>
          <td>{{ r.description }}</td>
          <td>{{ r.overlap }} / {{ sensitivity.baseline_top10 }}</td>
          <td>{{ r.churn }}</td>
          <td>{{ f2(r.mean_delta) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">{{ t('ch4.sens.note') }}</p>

    <h3 id="limitations">{{ t('ch4.lim.h3') }}</h3>
    <div class="limitations">
      {% for l in limitations %}
      <p><strong>{{ l.title }}.</strong> {{ l.body }}</p>
      {% endfor %}
    </div>

    <h3 id="reproducibility">{{ t('ch4.repro.h3') }}</h3>
    <p>{{ t('ch4.repro.p', url=repo_url, url_short=repo_url | replace('https://', ''), seed=seed) }}</p>
  </div>
</section>

<footer>
  <div class="container">
    <div class="role-block">
      <p class="role-kicker">{{ t('foot.kicker') }}</p>
      <p class="role-body">{{ t('foot.body') }}</p>
      <p class="role-author">
        <span class="role-author-name">Barbora Šandová</span>
        <span class="role-author-contact">
          <a href="mailto:barbora@datasimply.eu">barbora@datasimply.eu</a>
          &middot;
          <a href="{{ repo_url }}">{{ repo_url | replace('https://', '') }}</a>
        </span>
      </p>
    </div>
    <div class="photo-credits" id="photo-credits">
      <details class="fold">
        <summary>{{ t('foot.credits', n=photo_credits | length) }}</summary>
        <ul class="small">
          {% for c in photo_credits %}
          <li data-fbref-id="{{ c.fbref_id }}" data-player-key="{{ c.player_key }}">
            {{ c.name }} — <a href="https://commons.wikimedia.org/wiki/File:{{ c.credit | replace(' ', '_') }}">{{ c.credit }}</a>, {{ c.license }}
          </li>
          {% endfor %}
        </ul>
      </details>
    </div>
    <p class="rendered-at">{{ t('foot.rendered', at=rendered_at) }}</p>
  </div>
</footer>

<script>
  (() => {
    const toc = document.getElementById('toc');
    if (!toc) return;
    const btn = toc.querySelector('.toc-toggle');
    if (!btn) return;
    const KEY = 'atlas-toc-collapsed';
    const apply = (collapsed) => {
      toc.dataset.collapsed = collapsed ? 'true' : 'false';
      btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      btn.setAttribute('aria-label', collapsed ? btn.dataset.labelShow : btn.dataset.labelHide);
    };
    try {
      apply(localStorage.getItem(KEY) === 'true');
    } catch (e) {
      apply(false);
    }
    btn.addEventListener('click', () => {
      const next = toc.dataset.collapsed !== 'true';
      apply(next);
      try { localStorage.setItem(KEY, next ? 'true' : 'false'); } catch (e) {}
    });
  })();
</script>

</body>
</html>
