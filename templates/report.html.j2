      <li>{{ t('ch4.related.nuts', cite=cite.hoffman_gelman_2014) }}</li>
      <li>{{ t('ch4.related.rapm', cite=cite_multi(['kharrat_mchale_pena_2020', 'hvattum_2019'])) }}</li>
