{#- ---------------------------------------------------------------------------
   Player pool atlas — report template, rendered once per home nation and
   language (`lang`, `t()` and `term()` come from src/i18n.py; every static
   string goes through t(), every data label through term()).
   Structure and class names follow the hockey report (docs/style.css,
   docs/modern.css, docs/atlas.js and site/ key off them). Every number on the
   page comes from the context; the only literals are years, K = 10 and ±20 %.
   --------------------------------------------------------------------------- -#}
{%- macro f2(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.2f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro f3(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.3f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro g(x) -%}{%- if x is none -%}—{%- else -%}{{ '%g' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro pct(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.0f' | format(x * 100) }} %{%- endif -%}{%- endmacro -%}
{%- macro pct1(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.1f' | format(x * 100) }} %{%- endif -%}{%- endmacro -%}
{%- macro signed(x) -%}{%- if x is none -%}—{%- else -%}{{ '%+.3f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro signed2(x) -%}{%- if x is none -%}—{%- else -%}{{ '%+.2f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro trend_arrow(dir) -%}{%- if dir == 'improving' -%}↑{%- elif dir == 'declining' -%}↓{%- else -%}→{%- endif -%}{%- endmacro -%}
{%- macro card_article(p) -%}
  <article class="cycle-card" id="card-{{ p.fbref_id }}" data-player-key="{{ p.player_key }}" data-fbref-id="{{ p.fbref_id }}" data-rule="{{ p.reason }}" data-pos="{{ p.pos }}" data-club="{{ p.club }}">
    <header class="cycle-card-head">
      <h4 class="cycle-card-name">{{ p.name }}</h4>
      <p class="cycle-card-meta">
        {{ p.pos }} &middot; {{ p.age_current }} &middot; {{ p.club }} ({{ t('ch3.card.latest_known') if p.club_label == 'latest known' else p.club_label }}){% if p.nt_flag %} &middot; {{ t('ch3.card.nt', nt_years=facts.nt_years) }}{% endif %}
      </p>
    </header>

    <p class="cycle-card-meta cycle-stats-head">{{ seasons.metrics }} &middot; {{ p.club_season }} &middot; {{ p.league }}</p>
    <dl class="cycle-stats">
      <div><dt title="{{ t('metric.prod') }}">{{ t('metric.prod.short') }}</dt><dd>{{ f2(p.stats.npg_ast_q) }}</dd></div>
      <div><dt>{{ t('ch3.card.stat.rates') }}</dt><dd>{{ f2(p.stats.npg_p90) }} / {{ f2(p.stats.ast_p90) }}</dd></div>
      <div><dt>{{ t('ch3.card.stat.min') }}</dt><dd>{{ p.stats.min }} ({{ pct(p.stats.min_share) }})</dd></div>
    </dl>

    <div class="cycle-cluster">
      <span class="cycle-cluster-row" title="{{ p.clusters.style.id }}">
        <span class="cycle-cluster-tag">{{ t('ch3.card.style') }}</span>
        <span class="cycle-cluster-label">{{ p.clusters.style.label }}</span>
      </span>
      <span class="cycle-cluster-row" title="{{ p.clusters.quality.id }}">
        <span class="cycle-cluster-tag">{{ t('ch3.card.quality') }}</span>
        <span class="cycle-cluster-label">{{ p.clusters.quality.label }}</span>
      </span>
    </div>

    {% if p.tactical %}
    <div class="cycle-section">
      <p class="cycle-section-label">{{ t('ch3.card.tactical') }}</p>
      <p class="cycle-tactical">{{ p.tactical }}</p>
    </div>
    {% endif %}

    {% if p.trajectory %}
    <div class="cycle-section">
      <p class="cycle-section-label">{{ t('ch3.card.traj', previous=seasons.previous, metrics=seasons.metrics) }}</p>
      <p class="cycle-traj">
        <span class="cycle-traj-arrow" aria-hidden="true">{{ trend_arrow(p.trajectory.direction) }}</span>
        <span class="cycle-traj-dir">{{ term(p.trajectory.direction) }}</span>
        <span class="cycle-traj-delta">{{ signed2(p.trajectory.delta) }}</span>
        <span class="cycle-traj-unit">{{ t('metric.prod.short') }}</span>
        <span class="cycle-traj-detail">{{ p.trajectory.min_prev }} {{ t('ch3.card.min') }} &rarr; {{ p.trajectory.min_curr }} {{ t('ch3.card.min') }}</span>
      </p>
    </div>
    {% endif %}

    {% if p.analogs %}
    <div class="cycle-section">
      <p class="cycle-section-label">{{ t('ch3.card.analogs', age=p.analog_age) }}</p>
      <ol class="cycle-analogs">
        {% for a in p.analogs %}
        <li>
          <span class="cycle-analog-name">{{ a.name }}</span>
          <span class="cycle-analog-country">{{ a.nation }}</span>
          <span class="cycle-analog-stats">
            {{ a.league }} {{ a.season }} &middot; {{ a.min }} {{ t('ch3.card.min') }} &middot; {{ f2(a.npg_ast_q) }} &middot;
            d&nbsp;=&nbsp;{{ f2(a.distance) }}
          </span>
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endif %}

    {% if p.nt_events %}
    <p class="cycle-card-meta">{{ p.nt_events | join(' · ') }}</p>
    {% endif %}
    <p class="muted small">{{ t('ch3.card.selected', reason=reason(p.reason)) }}</p>
  </article>
{%- endmacro -%}
{%- macro gk_card_article(p) -%}
  {#- Deliberately class="gk-card", NOT "cycle-card": site/enrich_index.py's
     CARD_RE/TILE_ARTICLE_RE (the outfield-showcase tile system, which labels
     a card's first <dd> as the quality metric) and docs/modern.css's
     ".cycle-card > :not(.cycle-tile) { display: none }" collapse rule both
     key off the literal class="cycle-card" — this card intentionally sits
     outside that site-specific machinery (its own box styling is
     `.gk-card` in style.css) rather than risk either mislabeling GA/90 as
     the outfield metric or rendering collapsed-empty with no tile to open
     it. Inner sub-component classes (cycle-card-head, cycle-stats, ...) are
     still reused -- they are not scoped to a `.cycle-card` parent. -#}
  <article class="gk-card" id="gk-card-{{ p.player_key | replace('|', '-') | replace(' ', '_') }}" data-player-key="{{ p.player_key }}" data-pos="GK" data-club="{{ p.team }}">
    <header class="cycle-card-head">
      <h4 class="cycle-card-name">{{ p.player }}</h4>
      <p class="cycle-card-meta">
        GK &middot; {{ p.team }} ({{ p.league }}){% if p.nt_flag %} &middot; {{ t('ch3.card.nt', nt_years=facts.nt_years) }}{% endif %}
      </p>
    </header>

    <p class="cycle-card-meta cycle-stats-head">{{ seasons.metrics }} &middot; {{ p.min }} {{ t('ch3.card.min') }}</p>
    <dl class="cycle-stats">
      <div><dt>{{ t('gk.stat.ga90') }}</dt><dd>{{ f2(p.stats.ga90) }}</dd></div>
      <div><dt>{{ t('gk.stat.saves90') }}</dt><dd>{{ f2(p.stats.saves90) }}</dd></div>
      <div><dt>{{ t('gk.stat.savepct') }}</dt><dd>{% if p.stats.save_pct is not none %}{{ '%.1f' | format(p.stats.save_pct) }} %{% else %}—{% endif %}</dd></div>
    </dl>

    <div class="cycle-section">
      <p class="cycle-section-label">{{ t('gk.card.tier') }}</p>
      <p class="cycle-tactical">
        {% if p.club_goals_pct is not none %}{{ t('gk.card.tier_line', club=p.team, league=p.league, club_pct=pct(p.club_goals_pct)) }}
        {%- else %}{{ t('gk.card.tier_line_na') }}{% endif %}
      </p>
    </div>

    {% if p.nt_events %}
    <p class="cycle-card-meta">{{ p.nt_events | join(' · ') }}</p>
    {% endif %}
    <p class="muted small">{{ t('ch3.card.selected', reason=term(p.reason)) }}</p>
  </article>
{%- endmacro -%}
{%- set topn = headline_leagues | length -%}
{%- set cze = per_capita | selectattr('country', 'equalto', home_code) | list | first -%}
{%- set gt = {} -%}
{%- for grp in groups %}{% set _ = gt.update({grp: term(group_titles[grp])}) %}{% endfor -%}
{#- slide 8's compare-country names (Task 14c: hoisted here, not just inside
   the slide-8 section, so the TOC's toc.q8 entry -- rendered much earlier in
   the page -- can name the actual configured pair (e.g. "France and Spain"
   for NATION=eng) instead of a hardcoded "Norway and Denmark" left over
   from the cze-only original -#}
{%- set pc_a = term(peer_compare.names[peer_compare.countries[1]]) -%}
{%- set pc_b = term(peer_compare.names[peer_compare.countries[2]]) -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t('meta.title') }}</title>
  <meta name="description" content="{{ t('meta.description', n=hero.n_peers - 1) }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ assets }}style.css">
</head>
<body>

<a class="skip-link" href="#summary">{{ t('skip') }}</a>

<nav class="toc-sticky" aria-label="{{ t('toc.aria') }}" id="toc">
  <button type="button" class="toc-toggle" aria-controls="toc" aria-expanded="true"
          aria-label="{{ t('toc.hide') }}" data-label-show="{{ t('toc.show') }}" data-label-hide="{{ t('toc.hide') }}">
    <span class="toc-toggle-glyph" aria-hidden="true"></span>
  </button>
  <p class="toc-heading">{{ t('toc.heading') }}</p>
  <ol>
    <li><a href="#q1">{{ t('toc.q1') }}</a></li>
    <li><a href="#q2">{{ t('toc.q2') }}</a></li>
    <li><a href="#q3">{{ t('toc.q3') }}</a></li>
    <li><a href="#q4">{{ t('toc.q4') }}</a></li>
    <li><a href="#q5">{{ t('toc.q5') }}</a></li>
    <li><a href="#q6">{{ t('toc.q6') }}</a></li>
    <li><a href="#q7">{{ t('toc.q7') }}</a></li>
    <li><a href="#q8">{{ t('toc.q8', a=pc_a, b=pc_b) }}</a></li>
    {% if gk %}<li><a href="#q8b">{{ t('toc.q8b') }}</a></li>{% endif %}
    <li><a href="#q9">{{ t('toc.q9') }}</a></li>
    <li><a href="#explore">{{ t('toc.explore') }}</a></li>
    <li><a href="#methodology">{{ t('toc.methodology') }}</a>
      <ol>
        <li><a href="#multipliers">{{ t('toc.multipliers') }}</a></li>
        <li><a href="#league-strength">{{ t('toc.strength') }}</a></li>
        <li><a href="#model-comparison">{{ t('toc.compare') }}</a></li>
        <li><a href="#series-model">{{ t('toc.series') }}</a></li>
        <li><a href="#shrinkage">{{ t('toc.shrinkage') }}</a></li>
        <li><a href="#pca-loadings">{{ t('toc.pca') }}</a></li>
        <li><a href="#sensitivity">{{ t('toc.sensitivity') }}</a></li>
        <li><a href="#limitations">{{ t('toc.limitations') }}</a></li>
        <li><a href="#validation-robustness">{{ t('toc.validation') }}</a></li>
        <li><a href="#reproducibility">{{ t('toc.reproducibility') }}</a></li>
        <li><a href="#references">{{ t('toc.references') }}</a></li>
      </ol>
    </li>
  </ol>
</nav>

<header class="report-header">
  <div class="container">
    <p class="masthead-kicker">{{ t('mast.kicker') }}</p>
    <h1>{{ t('mast.title') }}</h1>
    <p class="masthead-subtitle">{{ t('mast.subtitle') }}</p>
    <dl class="masthead-meta">
      <div><dt>{{ t('mast.pool') }}</dt> <dd>{{ t('mast.pool_value', n=facts.n_pool) }}</dd></div>
      <div><dt>{{ t('mast.with_metrics', season=seasons.metrics) }}</dt> <dd><strong>{{ facts.n_with_metrics }}</strong></dd></div>
      <div><dt>{{ t('mast.nt', nt_years=facts.nt_years) }}</dt> <dd><strong>{{ facts.n_nt_flagged }}</strong></dd></div>
    </dl>
    <p class="masthead-facts">{{ t('mast.facts', n_leagues=facts.n_leagues, n_seasons=facts.n_seasons, n_tests=facts.n_tests) }}</p>

    <details class="toc-mobile" open>
      <summary>{{ t('toc.aria') }}</summary>
      <ol>
        <li><a href="#q1">{{ t('toc.q1') }}</a> · <a href="#q2">{{ t('toc.q2') }}</a> · <a href="#q3">{{ t('toc.q3') }}</a> · <a href="#q4">{{ t('toc.q4') }}</a> · <a href="#q5">{{ t('toc.q5') }}</a> · <a href="#q6">{{ t('toc.q6') }}</a> · <a href="#q7">{{ t('toc.q7') }}</a> · <a href="#q8">{{ t('toc.q8', a=pc_a, b=pc_b) }}</a>{% if gk %} · <a href="#q8b">{{ t('toc.q8b') }}</a>{% endif %} · <a href="#q9">{{ t('toc.q9') }}</a></li>
        <li><a href="#explore">{{ t('toc.explore') }}</a> · <a href="#methodology">{{ t('toc.methodology') }}</a> · <a href="#multipliers">{{ t('toc.short.multipliers') }}</a> · <a href="#league-strength">{{ t('toc.short.strength') }}</a> · <a href="#model-comparison">{{ t('toc.short.compare') }}</a> · <a href="#series-model">{{ t('toc.short.series') }}</a> · <a href="#shrinkage">{{ t('toc.short.shrinkage') }}</a> · <a href="#pca-loadings">{{ t('toc.short.pca') }}</a> · <a href="#sensitivity">{{ t('toc.short.sensitivity') }}</a> · <a href="#limitations">{{ t('toc.short.limitations') }}</a> · <a href="#references">{{ t('toc.short.references') }}</a></li>
      </ol>
    </details>
  </div>
</header>

{# =============================================================================
   HERO BAND — drenched navy with the headline number
   ============================================================================= #}
<section class="hero" id="summary">
  <aside class="hero-stamp" aria-label="{{ t('hero.stamp.aria') }}">
    <p class="hero-stamp-line">{{ t('hero.stamp.report') }}</p>
    <p class="hero-stamp-line"><strong>{{ t('hero.stamp.atlas', season=seasons.current) }}</strong></p>
    <p class="hero-stamp-line">{{ t('hero.stamp.edition') }}</p>
  </aside>
  <div class="container">
    <p class="hero-kicker">{{ t('hero.kicker') }}</p>
    <h2>{{ t('hero.h2') }}</h2>
    <div class="hero-grid">
      <div class="hero-num">
        <span class="hero-num-figure">{{ '%.2f' | format(hero.per_million) }}<span class="ast" aria-hidden="true">*</span></span>
        <span class="hero-num-unit">{{ t('hero.unit', topn=topn, season=seasons.metrics) }}</span>
      </div>
      <div class="hero-lead">
        <p>
          {{ t('hero.lead') }}
        </p>
        <p class="hero-sublead">
          {% if hero.gap %}{{ t('hero.sublead.gap', group=gt[hero.gap.pos_group] | lower, cohort=hero.gap.cohort, cze_n=hero.gap.cze_n,
                                s=('' if hero.gap.cze_n == 1 or lang != 'en' else 's'), topn=topn, peer=g(hero.gap.peer_median_n)) }}{% endif %}
          {% if hero.export_cze and hero.export_den %}{{ t('hero.sublead.export', topn=topn, cze=g(hero.export_cze.median_export_age_recent), den=g(hero.export_den.median_export_age_recent), b=pc_b) }}{% endif %}
          {{ t('hero.sublead.close') }}
        </p>
      </div>
    </div>
    <p class="hero-footnote">{{ t('hero.footnote', n=hero.n_players, season=seasons.metrics, topn=topn, pop=('%.1f' | format(hero.population_m))) }}</p>
  </div>
</section>

{% set pw = pathways %}
{% set squad_peer_rows = (squad_lens.rows | rejectattr('country', 'equalto', home_code) | list) if (squad_lens and squad_lens.rows) else [] %}
{% set squad_cze_row = ((squad_lens.rows | selectattr('country', 'equalto', home_code) | list | first)) if (squad_lens and squad_lens.rows) else none %}
{% set squad_best_row = (squad_peer_rows | sort(attribute='top9_pct', reverse=true) | first) if squad_peer_rows else none %}
{# =============================================================================
   SLIDES — nine questions, each one answer sentence + one proof exhibit +
   one "how we know" line. The presentation reads top to bottom; everything
   else (full tables, the remaining exhibits, the player index) is folded
   under "Explore the data" further down.
   ============================================================================= #}
<section class="slide" id="q1">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.1.q') }}</h2>
    <p class="slide-a">{{ t('slide.1.a', rank=ordinal(hero.rank), n=hero.n_peers, pm=f2(hero.per_million), top=term(hero.top.name), top_pm=f2(hero.top.per_million)) }}</p>
    <div class="slide-proof">
      <div class="capita" role="list" aria-label="{{ t('ch1.capita.aria') }}">
        {% for r in per_capita %}
        <div class="capita-row" role="listitem"
             {% if r.country == home_code %}data-highlight="cze"{% endif %}
             style="--value: {{ r.per_million }}; --max: {{ max_per_million }};">
          <div class="capita-country">
            <span class="capita-code">{{ r.country }}</span>
            {{ term(r.name) }}
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{{ f2(r.per_million) }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.1.how', min=feature_defs.min_minutes, season=seasons.metrics, topn=topn) }}</p>
  </div>
</section>

<section class="slide" id="q2">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.2.q') }}</h2>
    {% set gap0 = cohort_gaps[0] %}
    <p class="slide-a">{{ t('slide.2.a', group=term(gap0.group_title), cohort=gap0.cohort, cze=gap0.cze_n, peer=g(gap0.peer_median_n)) }}</p>
    <div class="slide-proof">
      <table class="kv-table cohort-gap-table">
        <thead>
          <tr><th>{{ t('cohortgap.th.group') }}</th><th>{{ t('cohortgap.th.cohort') }}</th><th>{{ t('cohortgap.th.cze') }}</th><th>{{ t('cohortgap.th.peer') }}</th></tr>
        </thead>
        <tbody>
          {% for r in cohort_gaps[:5] %}
          <tr>
            <td>{{ term(r.group_title) }}</td>
            <td>{{ r.cohort }}</td>
            <td class="cohort-cze">{{ r.cze_n }}</td>
            <td>{{ g(r.peer_median_n) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.2.how', min=feature_defs.min_minutes) }}</p>
  </div>
</section>

<section class="slide" id="q3">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.3.q') }}</h2>
    <p class="slide-a">{% if pw.youth_cze and pw.youth_cze.share_u21 is not none %}{{ t('slide.3.a', cze_pct=('%.1f' | format(pw.youth_cze.share_u21 * 100)), best_name=term(pw.youth_top.name), best_pct=('%.1f' | format(pw.youth_top.share_u21 * 100))) }}{% endif %}</p>
    <div class="slide-proof">
      {% set youth_max = pw.youth | map(attribute='share_u21') | reject('none') | max %}
      <div class="capita" role="list" aria-label="{{ t('ch2.a.aria') }}">
        {% for r in pw.youth %}
        <div class="capita-row" role="listitem"
             {% if r.country == home_code %}data-highlight="cze"{% endif %}
             style="--value: {{ r.share_u21 if r.share_u21 is not none else 0 }}; --max: {{ youth_max }};">
          <div class="capita-country">
            <span class="capita-code">{{ r.country }}</span>
            {{ r.league }}
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{% if r.share_u21 is none %}<span class="muted" title="{{ t('ch2.a.nodata') }}">—</span>{% else %}{{ pct1(r.share_u21) }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.3.how', season=seasons.metrics) }}</p>
  </div>
</section>

<section class="slide" id="q4">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.4.q') }}</h2>
    {% if pathways.destinations %}
    {% set dest = pathways.destinations %}
    {% set top9_bucket = (dest.buckets | selectattr('bucket', 'equalto', 'top9') | list | first) %}
    <p class="slide-a">{{ t('slide.4.a', abroad=dest.n_abroad, total=dest.n_total, topn=topn,
                            top9_pct=(('%.0f' | format(top9_bucket.share_of_abroad * 100)) if top9_bucket else '—'),
                            sideways_pct=('%.0f' | format(dest.sideways_share * 100))) }}</p>
    <div class="slide-proof">
      {% if dest.buckets %}
      {% set dest_max = dest.buckets | map(attribute='share_of_abroad') | max %}
      <div class="capita" role="list" aria-label="{{ t('ch2.e.aria') }}">
        {% for b in dest.buckets %}
        <div class="capita-row" role="listitem" style="--value: {{ b.share_of_abroad }}; --max: {{ dest_max }};">
          <div class="capita-country">
            <span class="capita-code">{{ b.n }}</span>
            {{ term(b.label) }}{% if b.median_multiplier is not none %} <span class="muted small">{{ t('ch2.e.median_mult', m=f3(b.median_multiplier)) }}</span>{% endif %}
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{{ pct(b.share_of_abroad) }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.4.how', season=seasons.metrics, home_note=(t('slide.home_note', topn=topn, topn_minus_1=(topn - 1)) if (domestic_league_code in headline_leagues) else '')) }}</p>
  </div>
</section>

<section class="slide" id="q5">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.5.q') }}</h2>
    <p class="slide-a">{% if pw.fare_min_cze %}{{ t('slide.5.a', cze=('%.0f' | format(pw.fare_min_cze.value * 100)), rank=ordinal(pw.fare_min_rank), n=pw.fare_min | length) }}{% endif %}</p>
    <div class="slide-proof">
      {% set fare_min_max = pw.fare_min | map(attribute='value') | max %}
      <div class="capita" role="list" aria-label="{{ t('ch2.c.aria.min') }}">
        {% for r in pw.fare_min %}
        <div class="capita-row" role="listitem"
             {% if r.country == home_code %}data-highlight="cze"{% endif %}
             style="--value: {{ r.value }}; --max: {{ fare_min_max }};">
          <div class="capita-country">
            <span class="capita-code">{{ r.country }}</span>
            {{ term(r.name) }} <span class="muted small">n = {{ r.n }}</span>
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{{ pct(r.value) }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.5.how', home_note=(t('slide.home_note', topn=topn, topn_minus_1=(topn - 1)) if (domestic_league_code in headline_leagues) else '')) }}</p>
  </div>
</section>

<section class="slide" id="q6">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.6.q') }}</h2>
    <p class="slide-a">{% if squad_cze_row and squad_best_row %}{{ t('slide.6.a', cze_pct=('%.0f' | format(squad_cze_row.top9_pct)), event=squad_lens.event, topn=topn,
                            best_name=term(squad_best_row.name), best_pct=('%.0f' | format(squad_best_row.top9_pct))) }}{% endif %}</p>
    <div class="slide-proof">
      {% if squad_lens and squad_lens.rows %}
      <ul class="tier-bar-legend">
        <li><span class="tier-swatch tier-top9" aria-hidden="true"></span>{{ t('ch2.f.th.top9') }}</li>
        <li><span class="tier-swatch tier-stepping" aria-hidden="true"></span>{{ t('ch2.f.th.stepping') }}</li>
        <li><span class="tier-swatch tier-domestic" aria-hidden="true"></span>{{ t('ch2.f.th.domestic') }}</li>
        <li><span class="tier-swatch tier-other" aria-hidden="true"></span>{{ t('ch2.f.th.other') }}</li>
      </ul>
      <div class="tier-bars" role="list" aria-label="{{ t('ch2.f.h3', event=squad_lens.event) }}">
        {% for r in squad_lens.rows %}
        <div class="tier-bar-row" role="listitem"{% if r.country == home_code %} data-highlight="cze"{% endif %}>
          <div class="tier-bar-head">
            <span class="capita-code">{{ r.country }}</span> {{ term(r.name) }}
            <span class="muted small">{{ t('ch2.f.th.squad') }} {{ r.n }}</span>
          </div>
          <div class="tier-bar" role="img" aria-label="{{ term(r.name) }}: {{ t('ch2.f.th.top9') }} {{ '%.0f' | format(r.top9_pct) }} %, {{ t('ch2.f.th.stepping') }} {{ '%.0f' | format(r.stepping_pct) }} %, {{ t('ch2.f.th.domestic') }} {{ '%.0f' | format(r.domestic_pct) }} %, {{ t('ch2.f.th.other') }} {{ '%.0f' | format(r.other_pct) }} %">
            <span class="tier-seg tier-top9" style="flex: {{ r.top9_pct }} 0 0"></span>
            <span class="tier-seg tier-stepping" style="flex: {{ r.stepping_pct }} 0 0"></span>
            <span class="tier-seg tier-domestic" style="flex: {{ r.domestic_pct }} 0 0"></span>
            <span class="tier-seg tier-other" style="flex: {{ r.other_pct }} 0 0"></span>
            {% if r.unmatched_pct %}<span class="tier-seg tier-unmatched" style="flex: {{ r.unmatched_pct }} 0 0"></span>{% endif %}
          </div>
          <div class="tier-bar-value">{{ '%.0f' | format(r.top9_pct) }} %</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.6.how', season=seasons.metrics) }}</p>
  </div>
</section>

<section class="slide" id="q7">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.7.q') }}</h2>
    {% if big5 %}
    <p class="slide-a">{{ t('slide.7.a', min=feature_defs.min_minutes, peak_n=big5.peak_n, peak_season=big5.peak_season, low_n=big5.low_n, low_season=big5.low_season, last_n=big5.last_n, last_season=big5.last_season, break_season=big5.break_season, break_prob=pct(big5.break_prob), delta=f2(big5.delta), lo=f2(big5.delta_lo), hi=f2(big5.delta_hi)) }}</p>
    <div class="slide-proof">
      <figure class="figure-bleed" data-atlas="big5">
        <img src="{{ assets }}big5_series.svg" alt="{{ t('slide.7.alt', min=feature_defs.min_minutes, start=big5.first_season, end=big5.last_season, a=term(big5.contrast_names[0]), b=term(big5.contrast_names[1])) }}">
      </figure>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.7.how', first_season=big5.first_season, last_season=big5.last_season, golden=big5.golden, cite_cp=cite.adams_mackay_2007) }}</p>
    {% endif %}
  </div>
</section>

<section class="slide" id="q8">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.8.q', a=pc_a, b=pc_b) }}</h2>
    <p class="slide-a">{% if peer_compare.nor_u21 is not none and peer_compare.nor_top9 is not none %}{{ t('slide.8.a', a=pc_a, nor_u21=('%.0f' | format(peer_compare.nor_u21 * 100)), cze_u21=('%.0f' | format(peer_compare.cze_u21 * 100)),
                            nor_top9=('%.0f' | format(peer_compare.nor_top9 * 100)), cze_top9=('%.0f' | format(peer_compare.cze_top9 * 100)), topn=topn) }}{% endif %}</p>
    <div class="slide-proof">
      <table class="kv-table peer-compare" aria-label="{{ t('peer_compare.aria', a=pc_a, b=pc_b) }}">
        <thead>
          <tr><th>{{ t('peer_compare.th.metric') }}</th>{% for c in peer_compare.countries %}<th{% if c == home_code %} class="cohort-cze"{% endif %}>{{ c }}</th>{% endfor %}</tr>
        </thead>
        <tbody>
          {% for r in peer_compare.rows %}
          <tr>
            <td>{{ t(r.label_key) }}</td>
            {% for c in peer_compare.countries %}
            {% set cell = r.by_country[c] %}
            <td{% if c == home_code %} class="cohort-cze"{% endif %}>
              {%- if cell.value is none -%}<span class="muted">—</span>
              {%- elif cell.fmt == 'f2' -%}{{ f2(cell.value) }}
              {%- elif cell.fmt == 'pct1' -%}{{ pct1(cell.value) }}
              {%- elif cell.fmt == 'pct' -%}{{ pct(cell.value) }}
              {%- elif cell.fmt == 'g' -%}{{ g(cell.value) }}
              {%- else -%}{{ cell.value }}
              {%- endif -%}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.8.how') }}</p>
  </div>
</section>

{% if gk and gk.home_rank %}
<section class="slide" id="q8b">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.8b.q') }}</h2>
    <p class="slide-a">{{ t('slide.8b.a', n_gk=gk.home_row.n_gk, min=gk.min_minutes, topn=topn,
                          pm=f2(gk.home_row.per_million), rank=gk.home_rank, n=gk.n_peers,
                          gk_age=g(gk.export_age.gk_median_age), out_age=g(gk.export_age.outfield_median_age)) }}</p>
    <div class="slide-proof">
      <figure class="figure-bleed">
        <img src="{{ assets }}gk_export_age.svg" alt="{{ t('slide.8b.alt') }}">
      </figure>
      <details class="fold">
        <summary>{{ t('gk.tier.summary', season=seasons.metrics) }}</summary>
        <table class="kv-table">
          <thead>
            <tr>
              <th>{{ t('gk.tier.th.player') }}</th><th>{{ t('gk.tier.th.club') }}</th>
              <th>{{ t('gk.tier.th.league') }}</th><th>{{ t('gk.tier.th.min') }}</th>
              <th>{{ t('gk.tier.th.club_pct') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for r in gk.club_tier %}
            <tr>
              <td>{{ r.player }}</td><td>{{ r.team }}</td><td>{{ r.league }}</td><td>{{ r.min }}</td>
              <td>{% if r.club_goals_pct is not none %}{{ pct(r.club_goals_pct) }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </details>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.8b.how', min=gk.min_minutes, season=seasons.metrics, phantom=gk.phantom_minutes, topn=topn, history_start=seasons.history_start,
                          censored_pct=('%.0f' | format(gk.export_age.gk_censored_share * 100)),
                          censored_out_pct=('%.0f' | format(gk.export_age.outfield_censored_share * 100)),
                          home_note=(t('slide.8b.home_note', topn=topn) if (domestic_league_code in headline_leagues) else '')) }}</p>
  </div>
</section>
{% endif %}

<section class="slide" id="q9">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.9.q') }}</h2>
    <p class="slide-a">{{ t('slide.9.a', n=cards | length) }}</p>
    <div class="slide-proof">
      <details class="fold">
        <summary>{{ t('ch3.cards.rules.summary', n=cards | length) }}</summary>
        <p class="capita-note">{{ t('ch3.cards.rules', event=nt_core_event) }}</p>
      </details>
      {% for row in card_rows %}
      <p class="cycle-row-kicker">{{ row.kicker }}</p>
      <div class="cycle-grid">
        {% for p in row.cards %}{{ card_article(p) }}{% endfor %}
      </div>
      {% endfor %}
      {% if gk and gk.cards %}
      <p class="cycle-row-kicker">{{ t('ch3.gk.kicker', topn=topn) }}</p>
      <div class="cycle-grid">
        {% for p in gk.cards %}{{ gk_card_article(p) }}{% endfor %}
      </div>
      {% endif %}
      <p class="capita-note">{{ t('ch3.cards.note', current=seasons.current, latest=t('ch3.card.latest_known')) }}</p>
    </div>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.9.how', season=seasons.metrics) }}</p>
