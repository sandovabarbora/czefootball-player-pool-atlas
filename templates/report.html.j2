      <div><dt>{{ t('glossary.interval.term') }}</dt><dd>{{ t('glossary.interval.def') }}</dd></div>
      <div><dt>{{ t('glossary.posterior.term') }}</dt><dd>{{ t('glossary.posterior.def') }}</dd></div>
      <div><dt>{{ t('glossary.oos.term') }}</dt><dd>{{ t('glossary.oos.def') }}</dd></div>
      <div><dt>{{ t('glossary.cluster.term') }}</dt><dd>{{ t('glossary.cluster.def') }}</dd></div>
      <div><dt>{{ t('glossary.changepoint.term') }}</dt><dd>{{ t('glossary.changepoint.def') }}</dd></div>
    </dl>

    <h3 id="references">{{ t('ch4.refs.h3') }}</h3>
