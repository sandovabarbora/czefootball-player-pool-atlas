{# =============================================================================
   HERO BAND — drenched navy with the headline number
   ============================================================================= #}
<section class="hero" id="summary">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-num">
        <span class="hero-num-figure">{{ '%.2f' | format(hero.per_million) }}<span class="ast" aria-hidden="true">*</span></span>
        <span class="hero-num-unit">{{ t('hero.unit', topn=topn, season=seasons.metrics) }}</span>
      </div>
      <div class="hero-lead">
        {# the finding, computed: rank, the headcount of young starters at home
           against the best comparison country, the age of the first move, and
           the break -- the last clause only where the model is at least evens #}
        {% set reg = why_funnel.stage1.regulars %}
        {% set best = (reg[1:] | selectattr('per_club', 'ne', none) | sort(attribute='per_club', reverse=true) | first) if reg | length > 1 else none %}
        {% set move = why_funnel.stage3.rows[0] if why_funnel.stage3.rows else none %}
        {% set clauses = [] %}
        {% if reg and reg[0].per_club is not none and best %}{% set _ = clauses.append(t('hero.finding.youth', per_club='%.1f' | format(reg[0].per_club), best_per_club='%.1f' | format(best.per_club), best=term(why_funnel.countries | selectattr('code', 'equalto', best.code) | map(attribute='name') | first))) %}{% endif %}
        {% if move and move.age is not none %}{% set _ = clauses.append(t('hero.finding.move', age=g(move.age))) %}{% endif %}
        {% if big5 and big5.break_season and big5.break_prob >= 0.5 %}{% set _ = clauses.append(t('hero.finding.break', season=big5.break_season)) %}{% endif %}
        <p class="hero-finding">
          {{ t('hero.finding', rank=ordinal(hero.rank), n=hero.n_peers) }}
          {% if clauses %}{{ t('hero.finding.lead') }} {% for c in clauses %}{% if not loop.first %}{% if loop.last %}; and {% else %}; {% endif %}{% endif %}{{ c }}{% endfor %}.{% endif %}
        </p>
        <p class="hero-path">{{ t('hero.path') }}</p>
        <p class="hero-sublead">
          {{ t('hero.lead') }}
          {% if hero.gap %}{{ t('hero.sublead.gap', group=gt[hero.gap.pos_group] | lower, cohort=hero.gap.cohort, cze_n=hero.gap.cze_n,
                                s=('' if hero.gap.cze_n == 1 or lang != 'en' else 's'), topn=topn, peer=g(hero.gap.peer_median_n)) }}{% endif %}
          {% if hero.export_cze and hero.export_den %}{{ t('hero.sublead.export', topn=topn, cze=g(hero.export_cze.median_export_age_recent), den=g(hero.export_den.median_export_age_recent), b=pc_b) }}{% endif %}
          {{ t('hero.sublead.close') }}
        </p>
      </div>
    </div>
    <p class="hero-footnote">{{ t('hero.footnote', n=hero.n_players, season=seasons.metrics, topn=topn, pop=('%.1f' | format(hero.population_m)), min=feature_defs.min_minutes) }}</p>
  </div>
</section>

{% set pw = pathways %}
{% set squad_peer_rows = (squad_lens.rows | rejectattr('country', 'equalto', home_code) | list) if (squad_lens and squad_lens.rows) else [] %}
{% set squad_cze_row = ((squad_lens.rows | selectattr('country', 'equalto', home_code) | list | first)) if (squad_lens and squad_lens.rows) else none %}
{% set squad_best_row = (squad_peer_rows | sort(attribute='top9_pct', reverse=true) | first) if squad_peer_rows else none %}
{# =============================================================================
   QUICKREAD — the 60-second opener (Task 25a): four computed tiles, each
   linking to the slide that proves it, between the hero and the eleven
   questions. Replaces the old "argument" list (templates/style.css keeps
   the dead .argument rules as commented-out history at Task 25a's commit).
   ============================================================================= #}
<section class="quickread" id="quickread">
  <div class="container">
    <ul class="quickread-grid">
      {% if hero.gap %}
      <li class="quickread-tile">
        <a href="#q2">
          <span class="quickread-figure">{{ hero.gap.cze_n }}</span>
          <span class="quickread-line">{{ t('quickread.2', group=(term(hero.gap.group_title) | lower), cohort=hero.gap.cohort, peer=g(hero.gap.peer_median_n)) }}</span>
        </a>
      </li>
      {% endif %}
      {% if squad_cze_row and squad_best_row %}
      <li class="quickread-tile">
        <a href="#q6">
          <span class="quickread-figure">{{ '%.0f' | format(squad_cze_row.top9_pct) }} %</span>
          <span class="quickread-line">{{ t('quickread.3', event=squad_lens.event, topn=topn, best_pct=('%.0f' | format(squad_best_row.top9_pct))) }}</span>
        </a>
      </li>
      {% endif %}
      {% if big5 and big5.break_season and not big5.no_break %}
      <li class="quickread-tile">
        <a href="#q7">
          <span class="quickread-figure">{{ big5.break_season }}</span>
          <span class="quickread-line">{{ t('quickread.4', break_prob=pct(big5.break_prob)) }}</span>
        </a>
      </li>
      {% endif %}
    </ul>
    <p class="quickread-note">{{ t('quickread.note') }}</p>
    <p class="quickread-note">{{ t('quickread.glossary_note') }}</p>
  </div>
</section>

{# =============================================================================
   WHY THE TRAIN LEFT — a five-stage funnel (Task 26A), right after the
   60-second opener: home nation next to the two compare countries, each
   stage linking to the slide that carries its evidence. Every number here
   is reused from `pathways`, `pipeline_facts` (Task 26B), `peer_compare`,
   `big5` and `gap_decomposition` -- see `src.render._build_why_funnel`.
   ============================================================================= #}
{#- Task 30: one player's card in plain football language, assembled clause
   by clause from src.pool_table's row so nothing is written that the row
   does not carry. Every clause is its own key so the Czech copy can order
   and inflect it on its own terms. -#}
{%- macro pool_card(r) -%}
  {{ t('pool.line.id', age=r.age if r.age is not none else '—', pos=pool_table.labels.pos[r.pos_group], club=r.club, where=(pool_table.labels.tier[r.tier] if r.tier == 'domestic' else (r.league ~ ', ' ~ pool_table.labels.tier[r.tier]) if r.tier else r.league)) }}
  {%- if r.pos_group == 'GK' %}
  {{ t('pool.line.gk', min=r.min, ga=f2(r.ga_p90), save=('%.0f' | format(r.save_pct)) if r.save_pct is not none else '—', cs=r.cs) }}
  {%- else %}
  {%- if r.starts is not none and r.subs is not none %}
  {{ t('pool.line.usage_starts', starts=r.starts, subs=r.subs, compl=r.compl if r.compl is not none else 0, mn=(r.mn_per_start | round | int) if r.mn_per_start else '—', share=('%.0f' | format(r.min_share * 100))) }}
  {%- else %}
  {{ t('pool.line.usage_min', min=r.min, share=('%.0f' | format(r.min_share * 100))) }}
  {%- endif %}
  {{ t('pool.line.prod', npg=f2(r.npg_p90), ast=f2(r.ast_p90), q=f2(r.q), rank=r.rank_q, n=r.n_group, pos_pl=pool_table.labels.pos_pl[r.pos_group]) }}
  {%- if r.crs_p90 is not none and r.tklw_p90 is not none and r.interceptions_p90 is not none %}
  {{ t('pool.line.role', crs=('%.1f' | format(r.crs_p90)), tkl=('%.1f' | format(r.tklw_p90)), int=('%.1f' | format(r.interceptions_p90)), fld=('%.1f' | format(r.fld_p90)) if r.fld_p90 is not none else '—') }}
  {%- endif %}
  {%- if r.moved %}
  {{ t('pool.line.moved', stints=r.stints | map(attribute='team') | join(' → ')) }}
  {%- endif %}
  {%- endif %}
{%- endmacro -%}

{%- macro funnel_cell(cell) -%}
  {%- if cell.value is none -%}—
  {%- elif cell.fmt == 'pct1' -%}{{ pct1(cell.value) }}
  {%- elif cell.fmt == 'pct' -%}{{ pct(cell.value) }}
  {%- elif cell.fmt == 'f1' -%}{% if cell.value is none %}—{% else %}{{ '%.1f' | format(cell.value) }}{% endif %}
  {%- elif cell.fmt == 'f2' -%}{{ f2(cell.value) }}
  {%- else -%}{{ cell.value }}
  {%- endif -%}
{%- endmacro -%}
<section class="why-funnel" id="why-funnel">
  <div class="container">
    <h2>{{ t('why_funnel.h2') }}</h2>
    <p class="funnel-lead">{{ t('why_funnel.lead') }}</p>
    <figure class="figure-bleed" data-chart="funnel">
      <img src="{{ assets }}why_funnel.svg" alt="{{ t('why_funnel.figure.alt', a=pc_a, b=pc_b) }}">
      <figcaption>{{ t('why_funnel.figure.caption') }}</figcaption>
    </figure>
    <ol class="funnel-stages">
      <li class="funnel-stage">
        <a href="#q3"><p class="funnel-stage-line">{{ t('why_funnel.stage1.line') }}</p></a>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage1.metric1') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {{ funnel_cell(why_funnel.stage1.share_u21[loop.index0]) }}</span>
            {% endfor %}
          </div>
        </div>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage1.metric2') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            {% set b = why_funnel.stage1.breadth[loop.index0] %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {% if b.n_total %}{{ t('why_funnel.breadth_cell', above=b.n_above, total=b.n_total) }}{% else %}—{% endif %}</span>
            {% endfor %}
          </div>
        </div>
        {% if why_funnel.stage1.regulars[0].per_club is not none %}
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage1.metric3') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            {% set g = why_funnel.stage1.regulars[loop.index0] %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {% if g.per_club is not none %}{{ t('why_funnel.regulars_cell', per_club='%.2f' | format(g.per_club), n=g.regulars) }}{% else %}—{% endif %}</span>
            {% endfor %}
          </div>
        </div>
        {% set reg0 = why_funnel.stage1.regulars[0] %}
        {% if reg0.per_club_5 is defined and reg0.per_club_5 is not none %}<p class="funnel-note funnel-note-small">{{ t('why_funnel.stage1.threshold', five='%.1f' | format(reg0.per_club_5), ten='%.1f' | format(reg0.per_club), fifteen='%.1f' | format(reg0.per_club_15)) }}</p>{% endif %}
        <p class="funnel-note">{{ t('why_funnel.stage1.note_early' if why_funnel.stage1.early_hook else 'why_funnel.stage1.note',
             starts='%.1f' | format(why_funnel.stage1.starts_share[0].value * 100),
             minutes='%.1f' | format(why_funnel.stage1.share_u21[0].value * 100),
             mn=why_funnel.stage1.mn_per_start | round | int,
             league_mn=why_funnel.stage1.league_mn_per_start | round | int) }}</p>
        {% endif %}
      </li>
      <li class="funnel-stage">
        <a href="#q3"><p class="funnel-stage-line">{{ t('why_funnel.stage2.line') }}</p></a>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage2.metric1') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {{ funnel_cell(why_funnel.stage2.mean_age[loop.index0]) }}</span>
            {% endfor %}
          </div>
        </div>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage2.metric2') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {{ funnel_cell(why_funnel.stage2.share_ge30[loop.index0]) }}</span>
            {% endfor %}
          </div>
        </div>
      </li>
      <li class="funnel-stage">
        <a href="#q4b"><p class="funnel-stage-line">{{ t('why_funnel.stage3.line') }}</p></a>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage3.metric1') }}</p>
          <div class="funnel-metric-row">
            {% for r in why_funnel.stage3.rows %}
            <span class="funnel-country"{% if r.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ r.code }}</span> {% if r.age is none %}—{% else %}{{ t('why_funnel.stage3.age_cell', age=g(r.age)) }}{% endif %}{% if r.n %} <span class="muted small">{{ t('why_funnel.stage3.n_cell', n=r.n) }}</span>{% endif %}</span>
            {% endfor %}
          </div>
        </div>
      </li>
      <li class="funnel-stage">
        <a href="#q4"><p class="funnel-stage-line">{{ t('why_funnel.stage4.line') }}</p></a>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage4.metric1') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {{ funnel_cell(why_funnel.stage4.sideways[loop.index0]) }}</span>
            {% endfor %}
          </div>
        </div>
      </li>
      <li class="funnel-stage">
        <a href="#q1"><p class="funnel-stage-line">{{ t('why_funnel.stage5.line') }}</p></a>
        <div class="funnel-metric">
          <p class="funnel-metric-label">{{ t('why_funnel.stage5.metric1') }}</p>
          <div class="funnel-metric-row">
            {% for c in why_funnel.countries %}
            <span class="funnel-country"{% if c.code == home_code %} data-highlight="cze"{% endif %}><span class="capita-code">{{ c.code }}</span> {{ funnel_cell(why_funnel.stage5.per_million[loop.index0]) }}</span>
            {% endfor %}
          </div>
        </div>
        {% if why_funnel.stage5.break_season %}
        <p class="funnel-metric-note">{{ t('why_funnel.stage5.break', season=why_funnel.stage5.break_season, prob=pctword(why_funnel.stage5.break_prob)) }} <a href="#q7">{{ t('toc.short.series') }}</a>.</p>
        {% endif %}
      </li>
    </ol>
    {% if why_funnel.take_one_thing %}
    <p class="funnel-take-one-thing">
      {% if why_funnel.take_one_thing.same_channel %}
      {{ t('why_funnel.take_one_thing.same', a=pc_a, b=pc_b, channel=term(why_funnel.take_one_thing.channel)) }} {{ t('why_funnel.take_one_thing.note', n=gap_decomposition.n) }}
      {% else %}
      {% set c0 = why_funnel.take_one_thing.by_contrast[0] %}
      {% set c1 = why_funnel.take_one_thing.by_contrast[1] %}
      {{ t('why_funnel.take_one_thing.diff', a=term(c0.contrast), b=term(c1.contrast),
           channel_a=term(c0.channel), channel_b=term(c1.channel)) }} {{ t('why_funnel.take_one_thing.note', n=gap_decomposition.n) }}
      {% endif %}
    </p>
    {% endif %}
    <details class="fold funnel-caveats">
      <summary>{{ t('why_funnel.caveat.h3') }}</summary>
      <ul>
        <li>{{ t('why_funnel.caveat.1') }}</li>
        <li>{{ t('why_funnel.caveat.2') }}</li>
        <li>{{ t('why_funnel.caveat.3') }}</li>
        <li>{{ t('why_funnel.caveat.4') }}</li>
        {% if why_funnel.stage1.bound %}
        <li>{{ t('why_funnel.stage1.bound',
             lo='%.1f' | format(why_funnel.stage1.bound.lo * 100),
             hi='%.1f' | format(why_funnel.stage1.bound.hi * 100)) }} {{ t('why_funnel.stage1.bound_starts') }}</li>
        {% endif %}
      </ul>
    </details>
  </div>
</section>

{# =============================================================================
   SLIDES — nine questions, each one answer sentence + one proof exhibit +
   one "how we know" line. The presentation reads top to bottom; everything
   else (full tables, the remaining exhibits, the player index) is folded
   under "Explore the data" further down.
   ============================================================================= #}
<div class="act">
  <p class="act-kicker">{{ t('act.1.kicker') }}</p>
  <p class="act-line">{{ t('act.1.line') }}</p>
</div>
<section class="slide" id="q1">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.1.q') }}</h2>
    <p class="slide-a">{% if hero.rank == 1 and hero.second %}{{ t('slide.1.a_leader', n=hero.n_peers, pm=f2(hero.per_million), second=term(hero.second.name), second_pm=f2(hero.second.per_million)) }}{% else %}{{ t('slide.1.a', rank=ordinal(hero.rank), n=hero.n_peers, pm=f2(hero.per_million), top=term(hero.top.name), top_pm=f2(hero.top.per_million)) }}{% endif %}</p>
    <div class="slide-proof">
      <div class="capita" role="list" aria-label="{{ t('ch1.capita.aria') }}">
        {% for r in per_capita %}
        <div class="capita-row" role="listitem"
             {% if r.country == home_code %}data-highlight="cze"{% endif %}
             style="--value: {{ r.per_million }}; --max: {{ max_per_million }};">
          <div class="capita-country">
            <span class="capita-code">{{ r.country }}</span>
            {{ term(r.name) }}
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{{ f2(r.per_million) }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
    <details class="fold slide-method">
      <summary>{{ t('slide.method_summary') }}</summary>
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.1.aq', min=feature_defs.min_minutes, season=seasons.metrics, topn=topn, n=hero.n_peers) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.1.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.1.how', min=feature_defs.min_minutes, season=seasons.metrics, topn=topn) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.1.so') }}</p>
  </div>
</section>

<section class="slide" id="q2">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.2.q') }}</h2>
    {% set gap0 = cohort_gaps[0] %}
    <p class="slide-a">{{ t('slide.2.a', group=term(gap0.group_title), cohort=gap0.cohort, cze=gap0.cze_n, peer=g(gap0.peer_median_n)) }}</p>
    <div class="slide-proof">
      {% set cohortgap_peer_max = (cohort_gaps[:5] | map(attribute='peer_median_n') | max) or 1 %}
      <table class="kv-table cohort-gap-table">
        <thead>
          <tr><th>{{ t('cohortgap.th.group') }}</th><th>{{ t('cohortgap.th.cohort') }}</th><th>{{ t('cohortgap.th.cze') }}</th><th>{{ t('cohortgap.th.peer') }}</th></tr>
        </thead>
        <tbody>
          {% for r in cohort_gaps[:5] %}
          <tr>
            <td>{{ term(r.group_title) }}</td>
            <td>{{ r.cohort }}</td>
            <td class="cohort-cze">{{ r.cze_n }}</td>
            <td class="cohortgap-peer" style="--value: {{ r.peer_median_n }}; --max: {{ cohortgap_peer_max }};">{{ g(r.peer_median_n) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <details class="fold slide-method">
      <summary>{{ t('slide.method_summary') }}</summary>
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.2.aq', min=feature_defs.min_minutes, season=seasons.metrics) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.2.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.2.how', min=feature_defs.min_minutes) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.2.so') }}</p>
  </div>
</section>

<div class="act">
  <p class="act-kicker">{{ t('act.2.kicker') }}</p>
  <p class="act-line">{{ t('act.2.line') }}</p>
</div>
<section class="slide" id="q3">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.3.q') }}</h2>
    <p class="slide-a">{% if pw.youth_cze and pw.youth_cze.share_u21 is not none %}{{ t('slide.3.a', cze_pct=('%.1f' | format(pw.youth_cze.share_u21 * 100)), best_name=term(pw.youth_top.name), best_pct=('%.1f' | format(pw.youth_top.share_u21 * 100))) }}{% endif %}</p>
    <div class="slide-proof">
      {% set youth_max = pw.youth | map(attribute='share_u21') | reject('none') | max %}
      {% if youth_panel.between and youth_panel.within %}
      <p class="slide-caveat">{{ t('slide.3.uncertain', n=youth_panel.between.n,
           beta=signed2(youth_panel.between.beta_per_10pp.median), lo=f2(youth_panel.between.beta_per_10pp.lo), hi=f2(youth_panel.between.beta_per_10pp.hi),
           within=signed2(youth_panel.within.beta_per_10pp.median), wlo=f2(youth_panel.within.beta_per_10pp.lo), whi=f2(youth_panel.within.beta_per_10pp.hi),
           topn=topn) }}</p>
      {% endif %}
      <div class="capita" role="list" aria-label="{{ t('ch2.a.aria') }}">
        {% for r in pw.youth %}
        <div class="capita-row" role="listitem"
             {% if r.country == home_code %}data-highlight="cze"{% endif %}
             style="--value: {{ r.share_u21 if r.share_u21 is not none else 0 }}; --max: {{ youth_max }};">
          <div class="capita-country">
            <span class="capita-code">{{ r.country }}</span>
            {{ term(r.name) }}
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{% if r.share_u21 is none %}<span class="muted" title="{{ t('ch2.a.nodata') }}">—</span>{% else %}{{ pct1(r.share_u21) }}{% endif %}</div>
        </div>
        {% endfor %}
      </div>
      {% if youth_panel.between %}
      <details class="fold">
        <summary>{{ t('slide.3.panel.summary') }}</summary>
        <figure class="figure-bleed">
          <img src="{{ assets }}youth_panel.svg" alt="{{ t('slide.3.panel.alt', n_countries=youth_panel.between.n) }}">
        </figure>
      </details>
      {% endif %}
    </div>
    <details class="fold slide-method">
      <summary>{{ t('slide.method_summary') }}</summary>
      {% if pw.panel_beta is defined %}<p class="slide-detail">{{ t('slide.3.panel', n_countries=pw.panel_n_countries, beta=signed2(pw.panel_beta), lo=f2(pw.panel_beta_lo), hi=f2(pw.panel_beta_hi), topn=topn) }}</p>{% endif %}
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.3.aq', season=seasons.metrics) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.3.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.3.how', season=seasons.metrics) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.3.so') }}</p>
  </div>
</section>

<section class="slide" id="q4">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.4.q') }}</h2>
    {% if pathways.destinations %}
    {% set dest = pathways.destinations %}
    {% set top9_bucket = (dest.buckets | selectattr('bucket', 'equalto', 'top9') | list | first) %}
    <p class="slide-a">{{ t('slide.4.a', abroad=dest.n_abroad, total=dest.n_total, topn=topn,
                            top9_pct=(('%.0f' | format(top9_bucket.share_of_abroad * 100)) if top9_bucket else '—'),
                            sideways_pct=('%.0f' | format(dest.sideways_share * 100))) }}</p>
    <div class="slide-proof">
      {% if dest.buckets %}
      {% set dest_max = dest.buckets | map(attribute='share_of_abroad') | max %}
      <div class="capita" role="list" aria-label="{{ t('ch2.e.aria') }}">
        {% for b in dest.buckets %}
        <div class="capita-row" role="listitem" style="--value: {{ b.share_of_abroad }}; --max: {{ dest_max }};">
          <div class="capita-country">
            <span class="capita-code">{{ b.n }}</span>
            {{ term(b.label) }}{% if b.median_multiplier is not none %} <span class="muted small">{{ t('ch2.e.median_mult', m=f3(b.median_multiplier)) }}</span>{% endif %}
          </div>
          <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
          <div class="capita-value">{{ pct(b.share_of_abroad) }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
    <details class="fold slide-method">
      <summary>{{ t('slide.method_summary') }}</summary>
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.4.aq', season=seasons.metrics, topn=topn) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.4.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.4.how', season=seasons.metrics, home_note=(t('slide.home_note', topn=topn, topn_minus_1=(topn - 1)) if (domestic_league_code in headline_leagues) else '')) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.4.so') }}</p>
  </div>
</section>

{% if export_age_model.age_curve %}
{% set eam = export_age_model %}
