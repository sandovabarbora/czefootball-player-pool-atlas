        <line x1="220" y1="54" x2="220" y2="90" class="bp-arrow" marker-end="url(#bp-arrow)"/>
        <g class="bp-node bp-author"><rect x="20" y="94" width="400" height="44" rx="3"/>
          <text x="220" y="121" class="bp-label">{{ t('ch4.built.flow.plan') }}</text></g>
        <line x1="220" y1="138" x2="220" y2="174" class="bp-arrow" marker-end="url(#bp-arrow)"/>
        <g class="bp-node bp-sonnet"><rect x="20" y="178" width="400" height="44" rx="3"/>
          <text x="210" y="205" class="bp-label">{{ t('ch4.built.flow.agent') }}</text>
          <text x="392" y="192" class="bp-badge bp-badge-sonnet">{{ build_process.implementers | upper }}</text></g>
        <line x1="220" y1="222" x2="220" y2="258" class="bp-arrow" marker-end="url(#bp-arrow)"/>
        <g class="bp-node bp-sonnet"><rect x="20" y="262" width="400" height="44" rx="3"/>
          <text x="210" y="284" class="bp-label">{{ t('ch4.built.flow.task_review') }}</text>
          <text x="210" y="298" class="bp-sub">{{ t('ch4.built.flow.task_review_sub') }}</text>
          <text x="392" y="276" class="bp-badge bp-badge-sonnet">{{ build_process.reviewers | upper }}</text></g>
        <line x1="220" y1="306" x2="220" y2="342" class="bp-arrow" marker-end="url(#bp-arrow)"/>
        <g class="bp-node bp-sonnet"><rect x="20" y="346" width="400" height="44" rx="3"/>
          <text x="210" y="373" class="bp-label">{{ t('ch4.built.flow.fix_rounds', n=build_process.max_fix_rounds) }}</text>
          <text x="392" y="360" class="bp-badge bp-badge-sonnet">{{ build_process.implementers | upper }}</text></g>
        <line x1="220" y1="390" x2="220" y2="426" class="bp-arrow" marker-end="url(#bp-arrow)"/>
        <g class="bp-node bp-sonnet"><rect x="20" y="430" width="400" height="44" rx="3"/>
          <text x="210" y="457" class="bp-label">{{ t('ch4.built.flow.whole_branch_review') }}</text>
          <text x="392" y="444" class="bp-badge bp-badge-sonnet">{{ build_process.reviewers | upper }}</text></g>
        <line x1="220" y1="474" x2="220" y2="510" class="bp-arrow" marker-end="url(#bp-arrow)"/>
        <g class="bp-node bp-opus"><rect x="20" y="514" width="400" height="44" rx="3"/>
