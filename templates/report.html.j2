      <li>{{ t('ch4.related.statespace', cite=cite.durbin_koopman_2012) }}</li>
      <li>{{ t('ch4.related.rollingorigin', cite=cite.hyndman_athanasopoulos_2021) }}</li>
      <li>{{ t('ch4.related.decomposition', cite=cite_multi(['oaxaca_1973', 'blinder_1973'])) }}</li>
