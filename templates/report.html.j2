{# =============================================================================
   ONE-PAGE BRIEF (Task 26E2) — the whole argument on one screen, meant to
   print on a single A4 page (see the @media print rules in style.css): the
   funnel's five numbers (home nation vs the two compare countries), the
   two model checks (league strength, the break season), the take-one-thing
   line, and the four what-this-does-not-show lines. Right before Explore,
   so it reads as the report's own executive summary, not a separate document.
   ============================================================================= #}
<section class="brief" id="brief">
  <div class="container">
    <div class="brief-head">
      <h2>{{ t('brief.h2') }}</h2>
      <button type="button" class="print-link" onclick="document.querySelector('.brief-body').open = true; window.print()">{{ t('brief.print') }}</button>
    </div>
    <p class="brief-intro">{{ t('brief.intro') }}</p>
    <details class="fold brief-body">
      <summary>{{ t('brief.open') }}</summary>
    <table class="brief-table">
      <thead>
        <tr>
          <th>{{ t('brief.th.number') }}</th>
          {% for c in why_funnel.countries %}<th{% if c.code == home_code %} class="cohort-cze"{% endif %}>{{ c.code }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        <tr><td>{{ t('why_funnel.stage1.metric1') }}</td>{% for cell in why_funnel.stage1.share_u21 %}<td class="num">{{ funnel_cell(cell) }}</td>{% endfor %}</tr>
        <tr><td>{{ t('why_funnel.stage2.metric1') }}</td>{% for cell in why_funnel.stage2.mean_age %}<td class="num">{{ funnel_cell(cell) }}</td>{% endfor %}</tr>
        <tr><td>{{ t('why_funnel.stage3.metric1') }}</td>{% for r in why_funnel.stage3.rows %}<td class="num">{% if r.age is none %}—{% else %}{{ g(r.age) }}{% endif %}</td>{% endfor %}</tr>
        <tr><td>{{ t('why_funnel.stage4.metric1') }}</td>{% for cell in why_funnel.stage4.sideways %}<td class="num">{{ funnel_cell(cell) }}</td>{% endfor %}</tr>
        <tr><td>{{ t('why_funnel.stage5.metric1') }}</td>{% for cell in why_funnel.stage5.per_million %}<td class="num">{{ funnel_cell(cell) }}</td>{% endfor %}</tr>
      </tbody>
    </table>
    {% if why_funnel.take_one_thing %}
    <p class="brief-take-one-thing">
      {% if why_funnel.take_one_thing.same_channel %}
      {{ t('why_funnel.take_one_thing.same', a=pc_a, b=pc_b, channel=term(why_funnel.take_one_thing.channel)) }} {{ t('why_funnel.take_one_thing.note', n=gap_decomposition.n) }}
      {% else %}
      {% set bc0 = why_funnel.take_one_thing.by_contrast[0] %}
      {% set bc1 = why_funnel.take_one_thing.by_contrast[1] %}
      {{ t('why_funnel.take_one_thing.diff', a=term(bc0.contrast), b=term(bc1.contrast),
           channel_a=term(bc0.channel), channel_b=term(bc1.channel)) }}
      {% endif %}
    </p>
    {% endif %}
    <dl class="brief-checks">
      {% if league_strength.home and not league_strength.home_is_reference %}
      <div><dt>{{ t('brief.check.strength') }}</dt><dd>{{ t('brief.check.strength_value', median=f2(league_strength.home.median), lo=f2(league_strength.home.hdi_lo), hi=f2(league_strength.home.hdi_hi)) }}</dd></div>
      {% endif %}
      {% if big5 and big5.break_season and not big5.no_break %}
      <div><dt>{{ t('brief.check.break') }}</dt><dd>{{ t('brief.check.break_value', season=big5.break_season, prob=pctword(big5.break_prob)) }}</dd></div>
      {% endif %}
    </dl>
    <div class="brief-caveats">
      <h3>{{ t('why_funnel.caveat.h3') }}</h3>
      <ul>
        <li>{{ t('why_funnel.caveat.1') }}</li>
        <li>{{ t('why_funnel.caveat.2') }}</li>
        <li>{{ t('why_funnel.caveat.3') }}</li>
        <li>{{ t('why_funnel.caveat.4') }}</li>
        {% if why_funnel.stage1.bound %}
        <li>{{ t('why_funnel.stage1.bound',
             lo='%.1f' | format(why_funnel.stage1.bound.lo * 100),
             hi='%.1f' | format(why_funnel.stage1.bound.hi * 100)) }} {{ t('why_funnel.stage1.bound_starts') }}</li>
        {% endif %}
      </ul>
    </div>
    </details>
  </div>
</section>

{# =============================================================================
   EXPLORE THE DATA — folded; today's chapters I-III material, minus the
   exhibits already used as a slide's proof above. Six top-level folds
   (Task 13b brief); ids kept so old deep links still land somewhere.
   ============================================================================= #}
<section class="explore" id="explore">
  <div class="container">
    <h2>{{ t('explore.h2') }}</h2>

    <details class="fold">
      <summary>{{ t('toc.benchmark') }}</summary>
      <div class="explore-block">
    <h3 id="benchmark">{{ t('ch1.benchmark.h3') }}</h3>
    <p>{{ t('ch1.benchmark.p') }}</p>

    {% for grp in groups %}
    <h4>{{ t('ch1.cohorts.h4', group=gt[grp] | lower) }}</h4>
    <table class="cohort-grid">
      <thead>
        <tr>
          <th scope="col">{{ t('ch1.cohorts.th') }}</th>
          {% for r in cohorts[grp] %}<th scope="col">{{ r.cohort }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for cc in cohort_countries %}
        <tr{% if cc == home_code %} class="cohort-cze"{% endif %}>
          <th scope="row">{{ cohort_names.get(cc, cc) }}</th>
          {% for r in cohorts[grp] %}
            {% set cell = r.cells[cc] %}
            {% if cell.n > 0 %}
            <td class="cohort-grid-cell" style="background-color: {{ cohort_tint(cell.median, cohort_vmax) }}; color: {{ cohort_text(cell.median, cohort_vmax) }};"
                title="{{ r.cohort }}: n={{ cell.n }}, {{ f2(cell.median) }}">{{ cell.n }}</td>
            {% else %}
            <td class="cohort-grid-cell cohort-grid-empty"><span class="muted" title="{{ t('ch1.cohorts.none') }}">—</span></td>
            {% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endfor %}
    {% set gap_items = [] %}
    {% for r in cohort_gaps[:3] %}{% set _ = gap_items.append(t('ch1.cohorts.gap_item', group=gt[r.pos_group] | lower, cohort=r.cohort, cze=r.cze_n, peer=g(r.peer_median_n))) %}{% endfor %}
    <p class="capita-note">
      {{ t('ch1.cohorts.note', topn=topn, season=seasons.metrics, min=feature_defs.min_minutes, shown=cohort_countries | length,
           n=hero.n_peers, gaps=gap_items | join(', ')) }}
    </p>

    <p class="plain">{{ t('ch1.heatmap.full_lead') }}</p>
    <figure class="figure-bleed" data-atlas="heatmap" title="{{ t('ch1.heatmap.note') }}">
      <img src="{{ assets }}intl_cohort_heatmap.svg"
           alt="{{ t('ch1.heatmap.alt', n=hero.n_peers, season=seasons.metrics) }}">
      <figcaption>{{ t('ch1.heatmap.caption', season=seasons.metrics) }}</figcaption>
    </figure>

    <h3 id="observations">{{ t('ch1.observations.h3') }}</h3>
    <details class="fold">
      <summary>{{ observations | map(attribute='title') | join(' · ') }}</summary>
      <div class="observations">
        {% for obs in observations %}
        <div class="observation">
          <h4>{{ obs.title }}</h4>
          <p>{{ obs.body }}</p>
        </div>
        {% endfor %}
      </div>
    </details>
      </div>
    </details>

    <details class="fold">
      <summary>{{ t('toc.clusters') }}</summary>
      <div class="explore-block">
    <h3 id="clusters">{{ t('ch1.clusters.h3') }}</h3>
    <p>{{ t('ch1.clusters.p', season=seasons.metrics, cite_rousseeuw=cite.rousseeuw_1987, cite_pedregosa=cite.pedregosa_et_al_2011) }}</p>
    {% for grp in groups %}
    {% set note = atlas_notes[grp] %}
    <figure class="figure-bleed" data-atlas="{{ grp | lower }}" data-cluster-names='{{ cluster_names.get(grp, {}) | tojson }}'>
      <img src="{{ assets }}atlas_{{ grp }}.svg"
           alt="{{ t('ch1.atlas.alt', group=gt[grp] | lower, season=seasons.metrics, corpus=note.n_corpus, czech=note.n_czech, nt=note.n_nt, nt_years=facts.nt_years) }}">
      <figcaption>{{ t('ch1.atlas.caption', group=gt[grp] | lower, season=seasons.metrics, corpus=note.n_corpus, czech=note.n_czech, nt=note.n_nt, nt_years=facts.nt_years) }}</figcaption>
    </figure>
    {% endfor %}
    {% for grp in groups %}
    <h4>{{ gt[grp] }}</h4>
    <dl class="cluster-list" data-atlas-clusters="{{ grp | lower }}">
      {% for c in clusters[grp] %}
      <dt>
        <span class="cluster-name" title="{{ c.id }}">
          {{ c.label }}
          <span class="cluster-meta-inline">
            {{ t('ch1.clusters.meta', n=c.n, corpus=c.n_corpus, nt=c.nt_pool, born=('—' if c.median_born is none else c.median_born)) }}
          </span>
        </span>
      </dt>
      <dd>
        {{ t('ch1.clusters.medians', npg=f2(c.medians.npg_p90), ast=f2(c.medians.ast_p90), share=pct(c.medians.min_share), age=g(c.medians.age), cards=f2(c.medians.cards_p90)) }}
        {% if c.tactical %}
        <span class="cluster-tactical"><span class="cluster-tactical-label">{{ t('ch1.clusters.tactical') }}</span>{{ c.tactical }}</span>
        {% endif %}
        {% if c.top %}<span class="cluster-top">{% for name in c.top %}<span class="cluster-top-name" data-player-key="{{ c.top_keys[loop.index0] }}">{{ name }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
      </dd>
      {% endfor %}
    </dl>
    {% endfor %}
      </div>
    </details>

    <details class="fold">
      <summary>{{ t('toc.trajectories') }}</summary>
      <div class="explore-block">
    <h3 id="trajectories">{{ t('ch1.traj.h3', previous=seasons.previous, metrics=seasons.metrics, min=thresholds.min_minutes) }}</h3>
    <p>{{ t('ch1.traj.p', band=f2(thresholds.direction)) }}</p>
    {% for grp in groups %}
    {% set m = movers[grp] %}
    <h4>{{ t('ch1.traj.h4', group=gt[grp], n=m.n_czech, up=m.directions.improving, stable=m.directions.stable, down=m.directions.declining) }}</h4>
    <div class="movers-grid">
      <div class="movers-col">
        <h4>{{ t('ch1.traj.up', metric=t('metric.prod.short')) }}</h4>
        <table class="movers-table">
          <thead><tr><th>{{ t('ch1.traj.th.player') }}</th><th>{{ t('ch1.traj.th.league') }}</th><th>{{ t('ch1.traj.th.min', previous=seasons.previous, metrics=seasons.metrics) }}</th><th>{{ t('ch1.traj.th.delta') }}</th></tr></thead>
          <tbody>
            {% for r in m.up %}
            <tr>
              <td data-player-key="{{ r.player_key }}">{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-up">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">{{ t('ch1.traj.none_up') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="movers-col">
        <h4>{{ t('ch1.traj.down', metric=t('metric.prod.short')) }}</h4>
        <table class="movers-table">
          <thead><tr><th>{{ t('ch1.traj.th.player') }}</th><th>{{ t('ch1.traj.th.league') }}</th><th>{{ t('ch1.traj.th.min', previous=seasons.previous, metrics=seasons.metrics) }}</th><th>{{ t('ch1.traj.th.delta') }}</th></tr></thead>
          <tbody>
            {% for r in m.down %}
            <tr>
              <td data-player-key="{{ r.player_key }}">{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-down">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">{{ t('ch1.traj.none_down') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endfor %}
      </div>
    </details>

{# =============================================================================
