{#- ---------------------------------------------------------------------------
   Czech football · Player pool atlas — English source template.
   Structure and class names follow the hockey report (docs/style.css,
   docs/modern.css, docs/atlas.js and site/ key off them). Every number on the
   page comes from the context; the only literals are years, K = 10 and ±20 %.
   --------------------------------------------------------------------------- -#}
{%- macro f2(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.2f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro f3(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.3f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro g(x) -%}{%- if x is none -%}—{%- else -%}{{ '%g' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro pct(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.0f' | format(x * 100) }} %{%- endif -%}{%- endmacro -%}
{%- macro pct1(x) -%}{%- if x is none -%}—{%- else -%}{{ '%.1f' | format(x * 100) }} %{%- endif -%}{%- endmacro -%}
{%- macro signed(x) -%}{%- if x is none -%}—{%- else -%}{{ '%+.3f' | format(x) }}{%- endif -%}{%- endmacro -%}
{%- macro ordinal(n) -%}{{ n }}{% if n % 100 in [11, 12, 13] %}th{% elif n % 10 == 1 %}st{% elif n % 10 == 2 %}nd{% elif n % 10 == 3 %}rd{% else %}th{% endif %}{%- endmacro -%}
{%- set topn = headline_leagues | length -%}
{%- set cze = per_capita | selectattr('country', 'equalto', 'CZE') | list | first -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Czech football · Player pool atlas</title>
  <meta name="description" content="Structural benchmark of the Czech professional football player pool against {{ hero.n_peers - 1 }} peer countries: per-capita density in Europe's strongest leagues, cohort gaps, PCA atlases by position group, pathways abroad. Descriptive, reproducible, public data only.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>

<a class="skip-link" href="#summary">Skip to content</a>

<nav class="toc-sticky" aria-label="Report contents" id="toc">
  <button type="button" class="toc-toggle" aria-controls="toc" aria-expanded="true"
          aria-label="Hide contents">
    <span class="toc-toggle-glyph" aria-hidden="true"></span>
  </button>
  <p class="toc-heading">Contents</p>
  <ol>
    <li><a href="#summary">Summary</a>
      <ol>
        <li><a href="#benchmark">Benchmark vs peer countries</a></li>
        <li><a href="#observations">Observations</a></li>
        <li><a href="#clusters">Cluster archetypes</a></li>
        <li><a href="#trajectories">Trajectories</a></li>
      </ol>
    </li>
    <li><a href="#pathways">Where the train leaves</a></li>
    <li><a href="#cards">Cards and analogs</a>
      <ol>
        <li><a href="#cards">Player cards</a></li>
        <li><a href="#analogs">Historical analogs</a></li>
      </ol>
    </li>
    <li><a href="#methodology">Methodology</a>
      <ol>
        <li><a href="#multipliers">League multipliers</a></li>
        <li><a href="#shrinkage">Bayesian shrinkage</a></li>
        <li><a href="#pca-loadings">PCA loadings</a></li>
        <li><a href="#sensitivity">Sensitivity analysis</a></li>
        <li><a href="#limitations">Limitations</a></li>
        <li><a href="#reproducibility">Reproducibility</a></li>
      </ol>
    </li>
  </ol>
</nav>

<header class="report-header">
  <div class="container">
    <p class="masthead-kicker">Czech football &middot; football intelligence brief &middot; {{ seasons.current }}</p>
    <h1>Atlas of the <em>player pool</em></h1>
    <p class="masthead-subtitle">
      A structured view of the Czech professional pool, read from a football
      intelligence perspective: how big and how deep it is compared with peer
      countries, and where the structural gaps sit. No predictions, no
      selection recommendations.
    </p>
    <dl class="masthead-meta">
      <div><dt>Pool</dt> <dd><strong>{{ facts.n_pool }}</strong> players</dd></div>
      <div><dt>With {{ seasons.metrics }} metrics</dt> <dd><strong>{{ facts.n_with_metrics }}</strong></dd></div>
      <div><dt>NT call-up 2024–26</dt> <dd><strong>{{ facts.n_nt_flagged }}</strong></dd></div>
    </dl>

    <details class="toc-mobile" open>
      <summary>Report contents</summary>
      <ol>
        <li><a href="#summary">Summary</a> · <a href="#benchmark">Benchmark</a> · <a href="#observations">Observations</a> · <a href="#clusters">Cluster archetypes</a> · <a href="#trajectories">Trajectories</a></li>
        <li><a href="#pathways">Where the train leaves</a> · <a href="#cards">Cards</a> · <a href="#analogs">Analogs</a></li>
        <li><a href="#methodology">Methodology</a> · <a href="#multipliers">Multipliers</a> · <a href="#shrinkage">Shrinkage</a> · <a href="#pca-loadings">PCA</a> · <a href="#sensitivity">Sensitivity</a> · <a href="#limitations">Limitations</a></li>
      </ol>
    </details>
  </div>
</header>

{# =============================================================================
   HERO BAND — drenched navy with the headline number
   ============================================================================= #}
<section class="hero" id="summary">
  <aside class="hero-stamp" aria-label="Document identification">
    <p class="hero-stamp-line">Report</p>
    <p class="hero-stamp-line"><strong>Atlas · {{ seasons.current }}</strong></p>
    <p class="hero-stamp-line">first edition · MIT</p>
  </aside>
  <div class="container">
    <p class="hero-kicker">Summary — structural benchmark vs peer countries</p>
    <h2>Summary</h2>
    <div class="hero-grid">
      <div class="hero-num">
        <span class="hero-num-figure">{{ '%.2f' | format(hero.per_million) }}<span class="ast" aria-hidden="true">*</span></span>
        <span class="hero-num-unit">players in Europe's {{ topn }} strongest leagues per million inhabitants, {{ seasons.current }} rosters</span>
      </div>
      <div class="hero-lead">
        <p>
          Per-capita density of top-{{ topn }} league players puts the Czech pool
          <span class="hero-pull">{{ ordinal(hero.rank) }} of {{ hero.n_peers }}</span> peer countries.
          {{ hero.top.name }} leads with <strong>{{ f2(hero.top.per_million) }}</strong> per million,
          {{ '%.1f' | format(hero.top.per_million / hero.per_million) }} times the Czech density.
        </p>
        <p class="hero-sublead">
          {% if hero.gap %}The largest cohort gap is in <strong>{{ hero.gap.group_title | lower }} aged {{ hero.gap.cohort }}</strong>:
          {{ hero.gap.cze_n }} Czech player{% if hero.gap.cze_n != 1 %}s{% endif %} in the top-{{ topn }} leagues against a peer median of {{ g(hero.gap.peer_median_n) }}.{% endif %}
          {% if hero.export_cze and hero.export_den %}A recent Czech export first reached a top-{{ topn }} roster at a median age of
          {{ g(hero.export_cze.median_export_age_recent) }}; a Danish one at {{ g(hero.export_den.median_export_age_recent) }}.{% endif %}
          Football people recognise these numbers player by player; there is no place where they are aggregated.
        </p>
      </div>
    </div>
    <ul class="hero-tiles" aria-label="Key numbers">
      <li><strong>{{ hero.rank }}<span>/{{ hero.n_peers }}</span></strong><span class="hero-tile-label">per-capita rank among peer countries</span></li>
      {% if hero.gap %}<li><strong>{{ hero.gap.cze_n }}</strong><span class="hero-tile-label">Czech {{ hero.gap.group_title | lower }} aged {{ hero.gap.cohort }} in top-{{ topn }} leagues <em>peer median {{ g(hero.gap.peer_median_n) }}</em></span></li>{% endif %}
      {% if hero.export_cze and hero.export_den %}<li><strong>{{ g(hero.export_cze.median_export_age_recent) }}</strong><span class="hero-tile-label">median age of a recent Czech export <em>DEN {{ g(hero.export_den.median_export_age_recent) }}</em></span></li>{% endif %}
    </ul>
    <p class="hero-footnote">* {{ hero.n_players }} players with FBref nationality CZE on {{ seasons.current }} rosters of the UEFA top-{{ topn }} leagues ÷ {{ '%.1f' | format(hero.population_m) }} M inhabitants (Eurostat 2024); peer countries computed the same way. <a href="#methodology">Methodology</a>.</p>
    <dl class="hero-meta">
      <div><dt>Mapped pool</dt> <dd>{{ facts.n_with_metrics }} players with {{ seasons.metrics }} metrics</dd></div>
      <div><dt>NT call-up 2024–26</dt> <dd>{{ facts.n_nt_flagged }} players</dd></div>
      <div><dt>Data frame</dt> <dd>{{ seasons.previous }} → {{ seasons.metrics }}, rosters {{ seasons.current }}</dd></div>
    </dl>
  </div>
</section>

{# =============================================================================
   CHAPTER I — EXECUTIVE SUMMARY
   ============================================================================= #}
<section class="exec-summary">
  <div class="container">
    <p class="framing">
      A map of the {{ facts.n_with_metrics }} Czech-eligible professionals with a complete
      {{ seasons.metrics }} season in a league FBref covers, segmented by position group and
      statistical profile, and benchmarked against {{ hero.n_peers - 1 }} peer countries.
      A methodological tool for mapping the pool across a national-team cycle, not a
      selection recommendation.
    </p>

    <h3 id="benchmark">Structural benchmark vs peer countries</h3>
    <p>
      Football intuition recognises the Czech pool player by player. <strong>Its structural
      position among the peer countries needs an aggregation nobody holds in one place.</strong>
      Three numbers below that are usually not collected together.
    </p>

    <h4>Per-capita density of top-{{ topn }} league players ({{ seasons.current }} rosters)</h4>
    <div class="capita" role="list" aria-label="Per-capita density of top-league players by country">
      {% for r in per_capita %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.per_million }}; --max: {{ max_per_million }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ r.name }}
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ f2(r.per_million) }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="capita-note">
      * Numerator: players with the country's FBref nationality on a {{ seasons.current }} roster of
      the {{ topn }} headline leagues ({{ headline_leagues | join(', ') }}); denominator: Eurostat 2024
      population. Czechia: {{ cze.n_players }} players ÷ {{ '%.2f' | format(cze.population_m) }} M = {{ f2(cze.per_million) }},
      rank {{ cze.rank }} of {{ per_capita | length }}.
    </p>

    <figure class="figure-bleed" data-atlas="heatmap">
      <img src="intl_cohort_heatmap.svg"
           alt="Heatmap of the international cohort benchmark: {{ hero.n_peers }} countries by position group and age cohort, {{ seasons.metrics }} season. Each cell carries the player count and the median non-penalty goals plus assists per 90 minutes; the Czech row is outlined.">
      <figcaption>
        Median non-penalty goals + assists per 90 by country, position group and age cohort,
        {{ seasons.metrics }}. The outlined row is Czechia; each cell shows the player count and the median.
      </figcaption>
    </figure>

    {% for grp in groups %}
    <h4>Cohort gaps — {{ group_titles[grp] | lower }}</h4>
    <table class="cohort-table">
      <thead>
        <tr>
          <th>Cohort</th>
          {% for cc in cohort_countries %}<th{% if cc == 'CZE' %} class="cohort-cze"{% endif %}>{{ cc }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for r in cohorts[grp] %}
        <tr>
          <td>{{ r.cohort }}</td>
          {% for cc in cohort_countries %}
            {% set cell = r.cells[cc] %}
            <td{% if cc == 'CZE' %} class="cohort-cze"{% endif %}>
              {% if cell.n > 0 %}
                <span class="cohort-cell-n">{{ cell.n }}</span><span class="cohort-cell-median">{{ f2(cell.median) }}</span>
              {% else %}
                <span class="muted" title="no player">—</span>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endfor %}
    <p class="capita-note">
      * Count and median npG+A per 90 of players with the country's nationality in a top-{{ topn }}
      league, {{ seasons.metrics }}, at least {{ feature_defs.min_minutes }} minutes; cohort by age at
      the season's start. {{ cohort_countries | length }} of the {{ hero.n_peers }} countries are shown; the heatmap above carries all of them.
      Largest Czech shortfalls against the peer median count:
      {% for r in cohort_gaps[:3] %}{{ r.group_title | lower }} {{ r.cohort }} ({{ r.cze_n }} vs {{ g(r.peer_median_n) }}){% if not loop.last %}, {% endif %}{% endfor %}.
    </p>

    {% for grp in groups %}
    {% set note = atlas_notes[grp] %}
    <figure class="figure-bleed" data-atlas="{{ grp | lower }}">
      <img src="atlas_{{ grp }}.svg"
           alt="Two-panel atlas of {{ group_titles[grp] | lower }} {{ seasons.metrics }} in PCA projection. Left panel: style map without league multipliers; right panel: quality-adjusted map. Grey points are the whole corpus of {{ note.n_corpus }} players; coloured points are the {{ note.n_czech }} Czech-eligible players by cluster; oxblood rings mark the {{ note.n_nt }} with a national-team call-up since 2024.">
      <figcaption>
        Atlas of {{ group_titles[grp] | lower }} {{ seasons.metrics }} in both projections: {{ note.n_czech }}
        Czech-eligible players in colour against a corpus of {{ note.n_corpus }}. Oxblood rings mark the
        national-team pool (call-up 2024–26, {{ note.n_nt }} players).
      </figcaption>
    </figure>
    {% endfor %}

    <h3 id="observations">Observations</h3>
    <div class="observations">
      {% for obs in observations %}
      <div class="observation">
        <h4>{{ obs.title }}</h4>
        <p>{{ obs.body }}</p>
      </div>
      {% endfor %}
    </div>

    <h3 id="clusters">Cluster archetypes (style projection)</h3>
    <p>
      Clusters are fitted on the whole corpus of {{ seasons.metrics }} player-seasons and read here
      through their Czech members. The label describes the cluster's median footprint; the count is
      Czech members of the corpus cluster; names are the Czech members with the most minutes.
    </p>
    {% for grp in groups %}
    <h4>{{ group_titles[grp] }}</h4>
    <dl class="cluster-list" data-atlas-clusters="{{ grp | lower }}">
      {% for c in clusters[grp] %}
      <dt>
        <span class="cluster-id">{{ c.id }}</span>
        <span>
          {{ c.label }}
          <span class="cluster-meta-inline">
            {{ c.n }} Czech of {{ c.n_corpus }} · NT pool {{ c.nt_pool }} · median born {% if c.median_born is none %}—{% else %}{{ c.median_born }}{% endif %}
          </span>
        </span>
      </dt>
      <dd>
        Corpus medians: {{ f2(c.medians.npg_p90) }} non-penalty goals and {{ f2(c.medians.ast_p90) }} assists per 90,
        {{ pct(c.medians.min_share) }} of the club's minutes, age {{ g(c.medians.age) }}, {{ f2(c.medians.cards_p90) }} cards per 90.
        {% if c.tactical %}
        <span class="cluster-tactical"><span class="cluster-tactical-label">Tactical read</span>{{ c.tactical }}</span>
        {% endif %}
        {% if c.top %}<span class="cluster-top">{{ c.top | join(', ') }}</span>{% endif %}
      </dd>
      {% endfor %}
    </dl>
    {% endfor %}

    <h3 id="trajectories">Trajectories {{ seasons.previous }} → {{ seasons.metrics }} (Czech-eligible, ≥ {{ thresholds.min_minutes }} minutes in both seasons)</h3>
    <p>
      Season-over-season change in quality-adjusted npG+A per 90. A move counts as up or down
      beyond ± {{ f2(thresholds.direction) }}; everything inside that band is stable and not listed.
    </p>
    {% for grp in groups %}
    {% set m = movers[grp] %}
    <h4>{{ group_titles[grp] }} — {{ m.n_czech }} players: {{ m.directions.improving }} up, {{ m.directions.stable }} stable, {{ m.directions.declining }} down</h4>
    <div class="movers-grid">
      <div class="movers-col">
        <h4>Moving up (Δ npG+A/90, quality-adjusted)</h4>
        <table class="movers-table">
          <thead><tr><th>Player</th><th>League</th><th>Min {{ seasons.previous }} / {{ seasons.metrics }}</th><th>Δ</th></tr></thead>
          <tbody>
            {% for r in m.up %}
            <tr>
              <td>{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-up">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">No Czech player moved up beyond the band.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="movers-col">
        <h4>Moving down (Δ npG+A/90, quality-adjusted)</h4>
        <table class="movers-table">
          <thead><tr><th>Player</th><th>League</th><th>Min {{ seasons.previous }} / {{ seasons.metrics }}</th><th>Δ</th></tr></thead>
          <tbody>
            {% for r in m.down %}
            <tr>
              <td>{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-down">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">No Czech player moved down beyond the band.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endfor %}

    <p class="continue">Pathways abroad follow; cards, analogs and the methodology come after them</p>
  </div>
</section>

{# =============================================================================
   CHAPTER II — WHERE THE TRAIN LEAVES (pathways and differences)
   ============================================================================= #}
{% set pw = pathways %}
<aside class="chapter-divider" role="separator" aria-label="Chapter II">
  <p class="chapter-numeral">II</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">Where the train leaves</p>
  <p class="chapter-synopsis">
    Four exhibits on the road from a domestic league to a top-{{ topn }} roster: minutes given to
    a league's own under-21s, the age and door of the export, how the exports fare at the new
    club, and the production profile by tier. Each names a difference; none names a remedy.
  </p>
</aside>

<section class="ai-layer">
  <div class="container">
    <h2 id="pathways">Where the train leaves</h2>
    <p class="framing">
      Pathways and differences between Czechia and the {{ pw.n_countries - 1 }} peer countries,
      computed from the same league tables: exposure at home, export route, how the exports fare,
      and the profile of those who made it.
    </p>

    <h3>Exhibit A — youth exposure at home</h3>
    <p>
      Share of a domestic league's total minutes played by its own nationals aged 21 or under,
      {{ seasons.metrics }}.
      {% if pw.youth_cze and pw.youth_cze.share_u21 is not none %}The Czech First League gives
      <strong>{{ pct1(pw.youth_cze.share_u21) }}</strong> of its minutes to Czech under-21s,
      {{ ordinal(pw.youth_rank) }} of the {{ pw.youth | selectattr('share_u21', 'ne', none) | list | length }} leagues with data*;
      {{ pw.youth_top.name }} leads with {{ pct1(pw.youth_top.share_u21) }}.{% endif %}
    </p>
    {% set youth_max = pw.youth | map(attribute='share_u21') | reject('none') | max %}
    <div class="capita" role="list" aria-label="Share of domestic-league minutes played by own under-21 nationals">
      {% for r in pw.youth %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.share_u21 if r.share_u21 is not none else 0 }}; --max: {{ youth_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ r.league }}
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{% if r.share_u21 is none %}<span class="muted" title="league not on FBref">—</span>{% else %}{{ pct1(r.share_u21) }}{% endif %}</div>
      </div>
      {% endfor %}
    </div>
    <p class="capita-note">
      * Σ minutes of players with the league country's nationality and age ≤ 21 at the season's
      start ÷ Σ minutes of all players in the league, {{ seasons.metrics }}. Under-23 shares:
      {% for r in pw.youth if r.share_u23 is not none %}{{ r.country }} {{ pct1(r.share_u23) }}{% if not loop.last %}, {% endif %}{% endfor %}.
      A league without a bar is not covered by FBref.
    </p>

    <h3>Exhibit B — export route</h3>
    <p>
      For every peer-country player on a {{ seasons.current }} top-{{ topn }} roster: the age at the
      first top-{{ topn }} season (full roster, and recent entrants only) and, for recent entrants, the
      league of the season before it.
      {% if pw.export_cze %}Czech exports: {{ pw.export_cze.n }} players, median export age
      {{ g(pw.export_cze.median_export_age) }} (recent entrants {{ pw.export_cze.n_recent }}, median
      {{ g(pw.export_cze.median_export_age_recent) }}), {{ pct(pw.export_cze.origin.domestic) }} of the recent
      ones straight from the Czech First League*.{% endif %}
    </p>
    <table class="kv-table">
      <thead>
        <tr>
          <th>Country</th><th>n</th><th>Recent</th>
          <th>Export age (all)</th><th>Export age (recent)</th>
          <th>Domestic</th><th>Stepping stone</th><th>Other top-{{ topn }}</th><th>Not covered</th>
          <th>Censored</th>
        </tr>
      </thead>
      <tbody>
        {% for r in pw.export %}
        <tr{% if r.country == 'CZE' %} class="cohort-cze"{% endif %}>
          <td><span class="capita-code">{{ r.country }}</span> {{ r.name }}</td>
          <td>{{ r.n }}</td>
          <td>{{ r.n_recent }}</td>
          <td>{{ g(r.median_export_age) }}</td>
          <td>{{ g(r.median_export_age_recent) }}</td>
          <td>{{ pct(r.origin.domestic) }}</td>
          <td>{{ pct(r.origin.stepping_stone) }}</td>
          <td>{{ pct(r.origin.other_top9) }}</td>
          <td>{{ pct(r.origin.not_covered) }}</td>
          <td class="muted">{{ pct(r.censored_share) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">
      * Export age = age at the first season in any headline league, history back to
      {{ seasons.history_start }}; a first appearance already in {{ seasons.history_start }} is censored.
      Recent entrants: first top-{{ topn }} season {{ seasons.metrics }} or {{ seasons.current }}, the only
      ones whose previous season lies inside the fetched window ({{ facts.coverage_start }} onwards for
      peer domestic leagues). Stepping-stone leagues: {{ stepping_stone | join(', ') }}. Not covered: no
      earlier row in the data.
    </p>

    <h3>Exhibit C — how the exports fare</h3>
    <p>
      Peer-country players at a top-{{ topn }} club in {{ seasons.metrics }}: median share of the club's
      minutes, and the club's strength within its league.
      {% if pw.fare_min_cze and pw.fare_goals_cze %}Czech exports play a median
      <strong>{{ pct(pw.fare_min_cze.value) }}</strong> of their club's minutes ({{ ordinal(pw.fare_min_rank) }} of
      {{ pw.fare_min | length }}) for clubs at the {{ pct(pw.fare_goals_cze.value) }} goals-scored percentile of
      their league ({{ ordinal(pw.fare_goals_rank) }} of {{ pw.fare_goals | length }})*.{% endif %}
    </p>
    <h4>Median minutes share at the top-{{ topn }} club</h4>
    {% set fare_min_max = pw.fare_min | map(attribute='value') | max %}
    <div class="capita" role="list" aria-label="Median minutes share of exports at their club, by country">
      {% for r in pw.fare_min %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.value }}; --max: {{ fare_min_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ r.name }} <span class="muted small">n = {{ r.n }}</span>
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(r.value) }}</div>
      </div>
      {% endfor %}
    </div>
    <h4>Median club strength: goals-scored percentile within the league</h4>
    {% set fare_goals_max = pw.fare_goals | map(attribute='value') | max %}
    <div class="capita" role="list" aria-label="Median club goals-scored percentile of exports' clubs, by country">
      {% for r in pw.fare_goals %}
      <div class="capita-row" role="listitem"
           {% if r.country == 'CZE' %}data-highlight="cze"{% endif %}
           style="--value: {{ r.value }}; --max: {{ fare_goals_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ r.name }} <span class="muted small">n = {{ r.n }}</span>
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(r.value) }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="capita-note">
      * Minutes share = player minutes ÷ (club matches × 90), {{ seasons.metrics }}, one row per player-season.
      Club strength proxy: {{ pw.club_strength_proxy }} — clubs ranked by the goals their own
      roster scored that season (ClubElo was unreachable at run time). Both are medians over the
      country's exports; n per country in the bars.
    </p>

    <h3>Exhibit D — profile of those who made it</h3>
    <p>
      Quality-adjusted npG+A per 90 in {{ seasons.metrics }} by the tier of the player's own league:
      domestic, stepping stone, top-{{ topn }}, or another covered league. Czech count and median
      against the median of the peer countries' values.
    </p>
    <details class="fold fold-table">
      <summary>Profile table by tier and position group</summary>
      <table class="kv-table">
        <thead>
          <tr><th>Tier</th><th>Group</th><th>CZE n</th><th>CZE median</th><th>Peer median n</th><th>Peer median</th></tr>
        </thead>
        <tbody>
          {% for r in pw.profile %}
          <tr>
            <td>{{ r.tier_label }}</td>
            <td>{{ r.pos_group }}</td>
            <td class="cohort-cze">{{ r.cze_n }}</td>
            <td class="cohort-cze">{{ f2(r.cze_median) }}</td>
            <td>{{ g(r.peer_median_n) }}</td>
            <td>{{ f2(r.peer_median) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    <p class="capita-note">
      * Tier = the league of the player's own {{ seasons.metrics }} season. Peer median n and peer
      median are medians across the peer countries present in that tier and group; a tier a country
      has no player in is absent, not zero.
    </p>

    {% if pathways.destinations %}
    {% set dest = pathways.destinations %}
    <h3>Exhibit E — where Czech exports go</h3>
    <p>
      Of the {{ dest.n_total }} mapped Czech players, {{ dest.n_abroad }} play outside the Czech
      First League. Their leagues by bucket, as a share of those abroad:
      {% for b in dest.buckets %}{{ b.label }} {{ pct(b.share_of_abroad) }}{% if not loop.last %}, {% endif %}{% endfor %}.
      <strong>{{ pct(dest.sideways_share) }}</strong> of the moves are sideways* — {{ dest.sideways_definition }}.
    </p>
    {% set dest_max = dest.buckets | map(attribute='share_of_abroad') | max %}
    <div class="capita" role="list" aria-label="Czech players abroad by destination bucket">
      {% for b in dest.buckets %}
      <div class="capita-row" role="listitem" style="--value: {{ b.share_of_abroad }}; --max: {{ dest_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ b.n }}</span>
          {{ b.label }}{% if b.median_multiplier is not none %} <span class="muted small">median multiplier {{ f3(b.median_multiplier) }}</span>{% endif %}
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(b.share_of_abroad) }}</div>
      </div>
      {% endfor %}
    </div>
    <ul class="small dest-examples">
      {% for b in dest.buckets if b.examples %}
      <li><span class="capita-code">{{ b.label }}</span> <code>{{ b.examples | join(' · ') }}</code></li>
      {% endfor %}
    </ul>
    <p class="capita-note">
      * Buckets by the league of the player's own {{ seasons.metrics }} season; the number in front
      of each bar is the player count, the median multiplier is the bucket's median league
      multiplier. Sideways: {{ dest.sideways_definition }}.
    </p>
    {% endif %}
  </div>
</section>

{# =============================================================================
   CHAPTER III — CARDS AND ANALOGS
   ============================================================================= #}
<aside class="chapter-divider" role="separator" aria-label="Chapter III">
  <p class="chapter-numeral">III</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">Cards and analogs</p>
  <p class="chapter-synopsis">
    {{ cards | length }} player cards chosen by rules, not picks — per position group the highest
    quality-adjusted npG+A per 90, the youngest national-team call-up, the most minutes in the
    top-{{ topn }} leagues, and the most domestic minutes among players under 23 without a top-{{ topn }}
    season — each combining stats,
    cluster placement, tactical read, trajectory and the nearest historical analogs at the same
    age from the all-nationality corpus.
  </p>
</aside>

<section class="ai-layer">
  <div class="container">
    <h2 id="cards">Player cards</h2>
    <p class="framing">
      One integrated card per showcase player, one row per selection rule: {{ seasons.metrics }}
      production, cluster placement in both projections, the cluster's tactical read, the
      {{ seasons.previous }} → {{ seasons.metrics }} trajectory and the
      {{ cards[0].analogs | length if cards else 0 }} nearest analogs. The club on the name line is
      the {{ seasons.current }} club; the stats block is {{ seasons.metrics }}.
      Description, not prediction.
    </p>
    {% for row in card_rows %}
    <p class="cycle-row-kicker">{{ row.kicker }}</p>
    <div class="cycle-grid">
      {% for p in row.cards %}
      <article class="cycle-card" id="card-{{ p.fbref_id }}" data-player-key="{{ p.player_key }}" data-fbref-id="{{ p.fbref_id }}" data-rule="{{ p.reason }}">
        <header class="cycle-card-head">
          <h4 class="cycle-card-name">{{ p.name }}</h4>
          <p class="cycle-card-meta">
            {{ p.pos }} &middot; {{ p.age_current }} &middot; {{ p.club }} ({{ seasons.current }}){% if p.nt_flag %} &middot; NT 2024–26{% endif %}
          </p>
        </header>

        <p class="cycle-card-meta cycle-stats-head">{{ seasons.metrics }} &middot; {{ p.club_season }} &middot; {{ p.league }}</p>
        <dl class="cycle-stats">
          <div><dt>npG+A/90 quality</dt><dd>{{ f2(p.stats.npg_ast_q) }}</dd></div>
          <div><dt>npG / A per 90</dt><dd>{{ f2(p.stats.npg_p90) }} / {{ f2(p.stats.ast_p90) }}</dd></div>
          <div><dt>Minutes</dt><dd>{{ p.stats.min }} ({{ pct(p.stats.min_share) }})</dd></div>
        </dl>

        <div class="cycle-cluster">
          <span class="cycle-cluster-row">
            <span class="cycle-cluster-tag">style</span>
            <span class="cycle-cluster-pill">{{ p.clusters.style.id }}</span>
            <span class="cycle-cluster-label">{{ p.clusters.style.label }}</span>
          </span>
          <span class="cycle-cluster-row">
            <span class="cycle-cluster-tag">quality</span>
            <span class="cycle-cluster-pill">{{ p.clusters.quality.id }}</span>
            <span class="cycle-cluster-label">{{ p.clusters.quality.label }}</span>
          </span>
        </div>

        {% if p.tactical %}
        <div class="cycle-section">
          <p class="cycle-section-label">Tactical read</p>
          <p class="cycle-tactical">{{ p.tactical }}</p>
        </div>
        {% endif %}

        {% if p.trajectory %}
        <div class="cycle-section">
          <p class="cycle-section-label">Trajectory {{ seasons.previous }} &rarr; {{ seasons.metrics }}</p>
          <p class="cycle-traj">
            <span class="cycle-traj-delta">Δ {{ signed(p.trajectory.delta) }} npG+A/90</span>
            <span class="cycle-traj-dir">{{ p.trajectory.direction }}</span>
            <span class="cycle-traj-detail">{{ p.trajectory.min_prev }} min &rarr; {{ p.trajectory.min_curr }} min</span>
          </p>
        </div>
        {% endif %}

        {% if p.analogs %}
        <div class="cycle-section">
          <p class="cycle-section-label">Historical analogs at age {{ p.analog_age }}</p>
          <ol class="cycle-analogs">
            {% for a in p.analogs %}
            <li>
              <span class="cycle-analog-name">{{ a.name }}</span>
              <span class="cycle-analog-country">{{ a.nation }}</span>
              <span class="cycle-analog-stats">
                {{ a.league }} {{ a.season }} &middot; {{ a.min }} min &middot; {{ f2(a.npg_ast_q) }} &middot;
                d&nbsp;=&nbsp;{{ f2(a.distance) }}
              </span>
            </li>
            {% endfor %}
          </ol>
        </div>
        {% endif %}

        {% if p.nt_events %}
        <p class="cycle-card-meta">{{ p.nt_events | join(' · ') }}</p>
        {% endif %}
        <p class="muted small">Selected as: {{ p.reason }}.</p>
      </article>
      {% endfor %}
    </div>
    {% endfor %}
    <p class="capita-note">
      * Each card renders the existing dataset; no computation beyond the join. Age on the name line
      is the {{ seasons.current }} season-start age (start year − birth year); the club is from the
      {{ seasons.current }} tables, or from FBref's country page where the player has no
      {{ seasons.current }} row. Age on the analog line follows the analog finder's convention
      (season start year + 1 − birth year).
    </p>

    <h3 id="analogs">Historical analogs</h3>
    <p>
      For each showcase player the finder takes the nearest {{ analog_blocks[0].analogs | length if analog_blocks else 0 }}
      player-seasons at the same age across the whole corpus of the {{ topn }} headline leagues
      back to {{ seasons.history_start }}, all nationalities. Distance is computed on three
      standardised features: <code>npG+A/90 (quality-adjusted)</code>, <code>minutes</code>,
      <code>league multiplier</code>. For every analog the following seasons are shown as they
      happened. <strong>Description, not prediction</strong>: the reader sees the spread of paths;
      the method imposes none.
    </p>
    {% for t in analog_blocks %}
    <div class="analog-block" data-player-key="{{ t.player_key }}">
      <div class="analog-target">
        <p class="analog-label">Target</p>
        <p class="analog-name">{{ t.target.name }}</p>
        <p class="analog-stats">
          {{ t.pos_group }} &middot; age {{ t.target.age }} &middot; {{ t.target.league }} {{ t.target.season }} &middot;
          {{ t.target.min }} min &middot; {{ f2(t.target.npg_ast_q) }} npG+A/90 quality
        </p>
        <p class="analog-cohort">Nearest {{ t.analogs | length }} at the same age</p>
      </div>
      <ol class="analog-list">
        {% for a in t.analogs %}
        <li class="analog-row">
          <div class="analog-row-head">
            <span class="analog-rank">{{ a.rank }}</span>
            <span class="analog-row-name">{{ a.name }}</span>
            <span class="analog-row-country">{{ a.nation }}</span>
            <span class="analog-row-context">
              {{ a.league }} {{ a.season }} &middot; {{ a.min }} min &middot; {{ f2(a.npg_ast_q) }} npG+A/90 &middot;
              d&nbsp;=&nbsp;{{ f2(a.distance) }}
            </span>
          </div>
          {% if a.followed %}
          <div class="analog-row-trajectory">
            <span class="analog-traj-label">Followed by:</span>
            {% for s in a.followed %}
            <span class="analog-traj-step">
              {{ s.season }}&nbsp;
              <span class="analog-traj-detail">{{ s.league }}&nbsp;&middot;&nbsp;{{ s.min }}&nbsp;min&nbsp;&middot;&nbsp;{{ f2(s.npg_ast_q) }}</span>
            </span>
            {% endfor %}
          </div>
          {% else %}
          <div class="analog-row-trajectory"><span class="analog-traj-label">No later season in the corpus.</span></div>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
    <p class="capita-note">
      * Corpus: player-seasons with at least {{ feature_defs.min_minutes }} minutes in the headline leagues,
      {{ seasons.history_start }} → {{ seasons.current }}; the target's own seasons are excluded. A path
      that ends early means the player left the covered leagues, not that the career ended.
    </p>
  </div>
</section>

{# =============================================================================
   CHAPTER IV — METHODOLOGY
   ============================================================================= #}
<aside class="chapter-divider" role="separator" aria-label="Chapter IV">
  <p class="chapter-numeral">IV</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">Methodology</p>
  <p class="chapter-synopsis">
    A replicable pipeline: data sources, league multipliers, Bayesian shrinkage, PCA loadings,
    sensitivity analysis. Limitations and reproducibility.
  </p>
</aside>

<section class="methodology">
  <div class="container">
    <h2 id="methodology">Methodology</h2>

    <h3 id="data-sources">Data sources</h3>
    <ul>
      <li><strong>FBref</strong> (via <code>soccerdata</code>): player season tables (standard, playing time) for the {{ topn }} headline leagues, the Czech First League, the peer domestic leagues and the German second tier; the country page "Players from Czechia" for pool discovery; the nationality column for peer counts</li>
      <li><strong>Wikipedia</strong>: national-team squad tables ({{ facts.nt_events }}) for the call-up flag</li>
      <li><strong>Wikidata / Wikimedia Commons</strong>: player portraits (P18) matched on name, citizenship and date of birth; credits in the footer</li>
      <li><strong>UEFA association coefficients</strong> (via Wikipedia) as the league-strength source, ClubElo being unreachable at run time</li>
      <li><strong>Eurostat</strong>: population estimates, 2024</li>
    </ul>

    <h3 id="multipliers">League multipliers (quality projection)</h3>
    <p class="formula" data-tex="\text{npG/90}_{\text{quality}} = \text{npG/90}_{\text{shrunk}} \times m_{\text{league}}">npG/90_quality = npG/90_shrunk × m_league</p>
    <table class="kv-table">
      <thead><tr><th>League</th><th>Multiplier</th></tr></thead>
      <tbody>
        {% for r in multipliers %}
        <tr><td>{{ r.league }}</td><td>{{ f3(r.value) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="muted small">
      Method: <code>{{ multiplier_method }}</code>. {{ multiplier_source }}
      The sensitivity analysis below shows the ranking's robustness to ±20 % on any one multiplier.
    </p>

    <h3 id="shrinkage">Bayesian shrinkage</h3>
    <p>
      Per-90 rates of players with few minutes are shrunk towards the median of their league and
      season (players with at least {{ feature_defs.phantom_minutes }} minutes) using the empirical
      Bayes formula, with K = 10 phantom matches expressed as {{ feature_defs.phantom_minutes }} minutes:
    </p>
    <p class="formula" data-tex="\text{shrunk rate} = \dfrac{\text{events} + K \cdot \text{league median}}{\text{minutes} / 90 + K},\qquad K = 10">shrunk_rate = (events + K × league_median) / (minutes / 90 + K), &nbsp; K = 10</p>
    <p>
      At {{ feature_defs.min_minutes }} minutes (the inclusion floor) the league median carries
      {{ pct(feature_defs.phantom_minutes / (feature_defs.min_minutes + feature_defs.phantom_minutes)) }}
      of the weight; at {{ feature_defs.phantom_minutes }} minutes the player's own rate and the
      median weigh the same. Minutes share and age are not shrunk.
    </p>

    <h3 id="pca-loadings">PCA loadings</h3>
    <p>
      One five-feature vector per position group ({{ feature_defs.features | join(', ') }}),
      standardised, reduced to two components per projection. Style uses the shrunk rates;
      quality multiplies the rates by the league multiplier first.
    </p>
    <table class="loadings-table">
      <thead>
        <tr>
          <th>Group</th><th>Projection</th><th>PC</th><th>% variance</th>
          <th>npG/90</th><th>A/90</th><th>min share</th><th>age</th><th>cards/90</th>
        </tr>
      </thead>
      <tbody>
        {% for r in loadings %}
        <tr>
          <td>{{ r.position }}</td>
          <td>{{ r.projection }}</td>
          <td>{{ r.pc }}</td>
          <td>{{ r.explained_pct }} %</td>
          <td>{{ f3(r.npg_p90) }}</td>
          <td>{{ f3(r.ast_p90) }}</td>
          <td>{{ f3(r.min_share) }}</td>
          <td>{{ f3(r.age) }}</td>
          <td>{{ f3(r.cards_p90) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h3 id="sensitivity">Sensitivity analysis (±20 % multipliers)</h3>
    <p>
      For each scenario the quality-adjusted ranking of Czech-eligible players within each position
      group was recomputed and compared with the baseline; "top-10" is the union of the {{ groups | length }} groups'
      own top tens ({{ sensitivity.baseline_top10 }} players at baseline). Of the
      {{ sensitivity.n_scenarios }} scenarios, {{ sensitivity.n_zero_churn }} change nobody in that
      set; the largest churn is {{ sensitivity.max_churn }}{% if sensitivity.worst %} ({{ sensitivity.worst.description }}, mean rank shift {{ f2(sensitivity.worst.mean_delta) }} in the top twenty){% endif %}*.
    </p>
    <table class="sensitivity-table">
      <thead>
        <tr>
          <th>Scenario</th><th>Description</th>
          <th>Top-10 overlap</th><th>Top-10 churn</th><th>Mean Δ rank (top 20)</th>
        </tr>
      </thead>
      <tbody>
        {% for r in sensitivity.rows %}
        <tr>
          <td>{{ r.scenario }}</td>
          <td>{{ r.description }}</td>
          <td>{{ r.overlap }} / {{ sensitivity.baseline_top10 }}</td>
          <td>{{ r.churn }}</td>
          <td>{{ f2(r.mean_delta) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">
      * Churn = baseline top-10 members that leave the set under the scenario; mean Δ rank = mean
      absolute rank change over the baseline top-20 union. Scenarios: baseline, every league ±20 %
      on its own, and all leagues ±20 % at once.
    </p>

    <h3 id="limitations">Limitations of this analysis</h3>
    <div class="limitations">
      {% for l in limitations %}
      <p><strong>{{ l.title }}.</strong> {{ l.body }}</p>
      {% endfor %}
    </div>

    <h3 id="reproducibility">Reproducibility</h3>
    <p>
      The full pipeline is public: <a href="{{ repo_url }}">{{ repo_url | replace('https://', '') }}</a>.
      MIT licence. From a clean clone with the data snapshot present, <code>make install &amp;&amp; make all</code>
      renders this report; <code>make pages</code> builds the site. Random seed {{ seed }} for every
      stochastic step (KMeans). Fetchers cache raw pages and are idempotent; the render step never
      touches the network.
    </p>
  </div>
</section>

<footer>
  <div class="container">
    <div class="role-block">
      <p class="role-kicker">Football intelligence consultant</p>
      <p class="role-body">
        Data science, video tracking and tactical reading of the game in one method. I work with
        public statistical sources of European professional leagues and combine them with a
        structural view of the player pool, scouting signals and a roadmap for football analytics.
        The methodology, code and data of this analysis are public and reproducible.
      </p>
      <p class="role-author">
        <span class="role-author-name">Barbora Šandová</span>
        <span class="role-author-contact">
          <a href="mailto:barbora@datasimply.eu">barbora@datasimply.eu</a>
          &middot;
          <a href="{{ repo_url }}">{{ repo_url | replace('https://', '') }}</a>
        </span>
      </p>
    </div>
    <div class="photo-credits" id="photo-credits">
      <details class="fold">
        <summary>Photo credits ({{ photo_credits | length }} portraits, Wikimedia Commons)</summary>
        <ul class="small">
          {% for c in photo_credits %}
          <li data-fbref-id="{{ c.fbref_id }}" data-player-key="{{ c.player_key }}">
            {{ c.name }} — <a href="https://commons.wikimedia.org/wiki/File:{{ c.credit | replace(' ', '_') }}">{{ c.credit }}</a>, {{ c.license }}
          </li>
          {% endfor %}
        </ul>
      </details>
    </div>
    <p class="rendered-at">Rendered: {{ rendered_at }}</p>
  </div>
</footer>

<script>
  (() => {
    const toc = document.getElementById('toc');
    if (!toc) return;
    const btn = toc.querySelector('.toc-toggle');
    if (!btn) return;
    const KEY = 'atlas-toc-collapsed';
    const apply = (collapsed) => {
      toc.dataset.collapsed = collapsed ? 'true' : 'false';
      btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      btn.setAttribute('aria-label', collapsed ? 'Show contents' : 'Hide contents');
    };
    try {
      apply(localStorage.getItem(KEY) === 'true');
    } catch (e) {
      apply(false);
    }
    btn.addEventListener('click', () => {
      const next = toc.dataset.collapsed !== 'true';
      apply(next);
      try { localStorage.setItem(KEY, next ? 'true' : 'false'); } catch (e) {}
    });
  })();
</script>

</body>
</html>
