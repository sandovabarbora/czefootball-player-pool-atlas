    <p class="close-links"><a href="#brief">{{ t('close.link.brief') }}</a> · <a href="#pool">{{ t('close.link.pool') }}</a> · <a href="#downloads">{{ t('close.link.data') }}</a>{% if home_code == 'CZE' %} · <a href="/eng/">{{ t('close.link.eng') }}</a>{% else %} · <a href="/">{{ t('close.link.cze') }}</a>{% endif %}</p>
  </div>
</section>

