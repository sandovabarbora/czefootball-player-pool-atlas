            <td class="cohort-cze">{{ f2(r.cze_median) }}</td>
            <td>{{ g(r.peer_median_n) }}</td>
            <td>{{ f2(r.peer_median) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    <p class="capita-note">{{ t('ch2.d.note', season=seasons.metrics) }}</p>

    {% if pathways.destinations %}
    {% set dest = pathways.destinations %}
    <h4>{{ t('ch2.e.h3') }}</h4>
    <p>{{ t('ch2.e.p', total=dest.n_total, abroad=dest.n_abroad) }}</p>
    {% if dest.buckets %}
    <ul class="small dest-examples">
      {% for b in dest.buckets if b.examples %}
      <li><span class="capita-code">{{ term(b.label) }}</span> <code>{{ b.examples | join(' · ') }}</code></li>
      {% endfor %}
    </ul>
    <p class="capita-note">{{ t('ch2.e.note', season=seasons.metrics, definition=term(dest.sideways_definition)) }}</p>
    {% endif %}
    {% endif %}

    {% if squad_lens and squad_lens.rows %}
    {% set total_unmatched = squad_lens.rows | sum(attribute='unmatched') %}
    <h4 id="exhibit-f">{{ t('ch2.f.h3', event=squad_lens.event) }}</h4>
    {% set squad_peer_names = [] %}
    {% for r in squad_peer_rows %}{% set _ = squad_peer_names.append(term(r.name)) %}{% endfor %}
    <p>
      {{ t('ch2.f.p', n=(squad_cze_row.n if squad_cze_row else 0), event=squad_lens.event, season=squad_lens.season_label, peers=squad_peer_names | join(', ')) }}
    </p>
    <details class="fold fold-table">
      <summary>{{ t('ch2.f.detail') }}</summary>
      <table class="kv-table">
        <thead>
          <tr>
            <th>{{ t('ch2.f.th.country') }}</th>
            <th>{{ t('ch2.f.th.median_min') }}</th><th>{{ t('ch2.f.th.median_mult') }}</th>
            <th>{{ t('ch2.f.th.u22') }}</th><th>{{ t('ch2.f.th.c2325') }}</th>
            <th>{{ t('ch2.f.th.c2629') }}</th><th>{{ t('ch2.f.th.c30plus') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for r in squad_lens.rows %}
          <tr{% if r.country == home_code %} class="cohort-cze"{% endif %}>
            <td><span class="capita-code">{{ r.country }}</span> {{ term(r.name) }}</td>
            <td>{{ g(r.median_minutes) }}</td>
            <td>{{ f3(r.median_multiplier) }}</td>
            <td>{{ r.cohorts['U22'] }}</td>
            <td>{{ r.cohorts['23-25'] }}</td>
            <td>{{ r.cohorts['26-29'] }}</td>
            <td>{{ r.cohorts['30+'] }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    <p class="capita-note">{{ t('ch2.f.note', unmatched=total_unmatched, season=squad_lens.season_label) }}</p>
    {% endif %}
      </div>
    </details>

    <details class="fold">
