                          c3=signed2(gdp.channels[2].contribution), resid=signed2(gdp.residual)) }}</p>
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.8c.aq', n=gap_decomposition.n) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.8c.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.8c.how', n=gap_decomposition.n, n_boot=gap_decomposition.n_boot, cite_ob=cite_multi(['oaxaca_1973', 'blinder_1973'])) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.8c.so') }}</p>
  </div>
</section>
{% endif %}

<section class="slide" id="q9">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.9.q') }}</h2>
    <p class="slide-a">{{ t('slide.9.a', n=cards | length) }}</p>
    <div class="slide-proof">
      <details class="fold">
        <summary>{{ t('ch3.cards.rules.summary', n=cards | length) }}</summary>
        <p class="capita-note">{{ t('ch3.cards.rules', event=nt_core_event, metric=t('metric.prod')) }}</p>
      </details>
      {% for row in card_rows %}
      <p class="cycle-row-kicker">{{ row.kicker }}</p>
      <div class="cycle-grid">
        {% for p in row.cards %}{{ card_article(p) }}{% endfor %}
      </div>
      {% endfor %}
      {% if gk and gk.cards %}
      <p class="cycle-row-kicker">{{ t('ch3.gk.kicker', topn=topn) }}</p>
      <div class="cycle-grid">
        {% for p in gk.cards %}{{ gk_card_article(p) }}{% endfor %}
      </div>
      {% endif %}
      <p class="capita-note">{{ t('ch3.cards.note', current=seasons.current, latest=t('ch3.card.latest_known')) }}</p>
      <div class="atlas-tabs" id="atlas">
        <p class="cycle-row-kicker">{{ t('atlas.kicker', season=seasons.metrics) }}</p>
        {% for grp in groups %}
        <figure class="figure-bleed" data-chart="atlas-{{ grp }}" data-tab="{{ gt[grp] }}">
          <img src="{{ assets }}atlas_{{ grp }}.svg" alt="{{ t('ch1.atlas.alt', group=gt[grp] | lower, season=seasons.metrics, corpus=atlas_notes[grp].n_corpus, czech=atlas_notes[grp].n_czech, nt=atlas_notes[grp].n_nt, nt_years=facts.nt_years) }}">
          <figcaption>{{ t('atlas.read', group=gt[grp] | lower, season=seasons.metrics) }}</figcaption>
        </figure>
        {% endfor %}
      </div>
      {% if pool_table.rows %}
      <details class="fold pool-fold" id="pool">
        <summary>{{ t('pool.summary', n=pool_table.total, season=pool_table.season_label) }}</summary>
        <div class="pool" data-pool>
          <p class="capita-note">{{ t('pool.intro', season=pool_table.season_label, fw=pool_table.groups.FW, mf=pool_table.groups.MF, df=pool_table.groups.DF, gk=pool_table.groups.GK) }}</p>
          <div class="pool-controls">
            <label class="pool-control pool-control-search">{{ t('pool.search') }} <input type="search" data-pool-search autocomplete="off" placeholder="{{ t('pool.search.placeholder') }}"></label>
            <label class="pool-control">{{ t('pool.filter.pos') }} <select data-pool-filter="pos"><option value="">{{ t('pool.filter.all') }}</option>{% for g in ['FW', 'MF', 'DF', 'GK'] %}<option value="{{ g }}">{{ pool_table.labels.pos_pl[g] }}</option>{% endfor %}</select></label>
            <label class="pool-control">{{ t('pool.filter.tier') }} <select data-pool-filter="tier"><option value="">{{ t('pool.filter.all') }}</option>{% for tier in ['domestic', 'stepping_stone', 'top9', 'other'] %}<option value="{{ tier }}">{{ pool_table.labels.tier[tier] }}</option>{% endfor %}</select></label>
            <label class="pool-control">{{ t('pool.filter.age') }} <select data-pool-filter="band"><option value="">{{ t('pool.filter.all') }}</option>{% for b in pool_table.bands %}<option value="{{ b }}">{{ pool_table.labels.band[b] }}</option>{% endfor %}</select></label>
            <span class="pool-count" data-pool-count>{{ t('pool.count', shown=pool_table.total, total=pool_table.total) }}</span>
          </div>
          <div class="pool-head" aria-hidden="true">
            <span class="pool-name">{{ t('pool.col.player') }}</span><span class="pool-age">{{ t('pool.col.age') }}</span><span class="pool-pos">{{ t('pool.col.pos') }}</span><span class="pool-club">{{ t('pool.col.club') }}</span><span class="pool-min">{{ t('pool.col.min') }}</span><span class="pool-rank">{{ t('pool.col.rank') }}</span>
          </div>
          <ol class="pool-rows">
            {% for r in pool_table.rows %}
            <li data-pos="{{ r.pos_group }}" data-tier="{{ r.tier or '' }}" data-band="{{ r.band or '' }}" data-search="{{ r.search }}">
              <details class="pool-row">
                <summary class="pool-summary">
                  <span class="pool-name">{{ r.player }}{% if r.nt_flag %} <span class="pool-nt" title="{{ t('pool.nt_title') }}">NT</span>{% endif %}{% if r.moved %} <span class="pool-moved" title="{{ t('pool.moved_title') }}">⇄</span>{% endif %}</span>
                  <span class="pool-age">{{ r.age if r.age is not none else '—' }}</span>
                  <span class="pool-pos">{{ r.pos_group }}</span>
                  <span class="pool-club">{{ r.club }}</span>
                  <span class="pool-min">{{ '{:,}'.format(r.min).replace(',', ' ') }}</span>
                  <span class="pool-rank">{% if r.pos_group != 'GK' %}{{ r.rank_q }}<span class="pool-rank-of">/{{ r.n_group }}</span>{% else %}—{% endif %}</span>
                </summary>
                {% if r.profile and r.profile | selectattr('pct', 'ne', none) | list %}
                <div class="pool-profile" role="list" aria-label="{{ t('pool.profile.aria') }}">
                  {% for ax in r.profile if ax.pct is not none %}
                  <div class="pool-axis" role="listitem" title="{{ ax.what }}">
                    <span class="pool-axis-label">{{ ax.label }}</span>
                    <span class="pool-axis-bar"><span class="pool-axis-fill" style="width: {{ ax.pct }}%"></span></span>
                    <span class="pool-axis-pct">{{ ax.pct }}</span>
                  </div>
                  {% endfor %}
                  <p class="pool-profile-note">{{ t('pool.profile.note', pos_pl=pool_table.labels.pos_pl[r.pos_group], season=pool_table.season_label) }}</p>
                </div>
                {% endif %}
                <p class="pool-card">{{ pool_card(r) }}</p>
                <p class="pool-link"><a href="atlas/#p/{{ r.player_key | urlencode }}">{{ t('pool.career') }}</a> · <a href="?player={{ r.player | urlencode }}#pool">{{ t('pool.link') }}</a></p>
              </details>
            </li>
            {% endfor %}
          </ol>
          <p class="pool-empty" data-pool-empty hidden>{{ t('pool.empty') }}</p>
        </div>
      </details>
      {% endif %}
    </div>
    <details class="fold slide-method">
      <summary>{{ t('slide.method_summary') }}</summary>
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.9.aq', n=cards | length, season=seasons.metrics) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.9.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.9.how', season=seasons.metrics) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.9.so') }}</p>
  </div>
</section>

{% if season_changes %}
{%- macro changes_col(title, mv, show_curr) -%}
        <div class="movers-col">
          <h4>{{ title }} <span class="changes-count">{{ mv.n }}</span></h4>
          <ul class="changes-list">
            {% for r in mv.names %}
            <li><span class="changes-name">{{ r.player }}</span> <span class="muted">{% if r.league_prev and r.league_curr %}{{ r.league_prev }} → {{ r.league_curr }}{% elif r.league_curr %}{{ r.league_curr }}{% else %}{{ r.league_prev }}{% endif %}</span></li>
            {% else %}
            <li class="muted">—</li>
            {% endfor %}
            {% if mv.n > mv.names | length %}<li class="muted">{{ t('slide.10.more', n=mv.n - (mv.names | length)) }}</li>{% endif %}
          </ul>
        </div>
{%- endmacro -%}
<section class="slide" id="q10">
  <div class="container">
    <h2 class="slide-q">{{ t('slide.10.q') }}</h2>
    <p class="slide-a">{{ t('slide.10.a', up=season_changes.moves.up.n, down=season_changes.moves.down.n, ss_prev=season_changes.stepping.players_prev, ss_curr=season_changes.stepping.players_curr, top_prev=season_changes.top9.players_prev, top_curr=season_changes.top9.players_curr) }}</p>
    <div class="slide-proof">
      <figure class="figure-bleed" data-chart="changes">
        <figcaption>{{ t('slide.10.sankey_caption') }}</figcaption>
      </figure>
      <div class="changes-tiers">
        {% for tr_ in season_changes.tiers %}
        <div class="changes-tier">
          <p class="changes-tier-label">{{ pool_table.labels.tier[tr_.tier] }}</p>
          <p class="changes-tier-n"><span class="changes-prev">{{ tr_.players_prev }}</span> <span class="changes-arrow">→</span> <span class="changes-curr">{{ tr_.players_curr }}</span></p>
          <p class="changes-tier-min">{{ t('slide.10.minutes', prev='{:,}'.format(tr_.prev).replace(',', ' '), curr='{:,}'.format(tr_.curr).replace(',', ' ')) }}</p>
        </div>
        {% endfor %}
      </div>
      <p class="capita-note">{{ t('slide.10.tiers_note', previous=season_changes.previous_label, metrics=season_changes.metrics_label, n_prev=season_changes.n_prev, n_curr=season_changes.n_curr) }}</p>
      <div class="movers-grid changes-moves">
        {{ changes_col(t('slide.10.move_up'), season_changes.moves.up, true) }}
        {{ changes_col(t('slide.10.move_down'), season_changes.moves.down, true) }}
        {{ changes_col(t('slide.10.move_entered'), season_changes.moves.entered, true) }}
        {{ changes_col(t('slide.10.move_left'), season_changes.moves.left, false) }}
      </div>
      <p class="capita-note">{{ t('slide.10.left_note') }}</p>
    </div>
    <details class="fold slide-method">
      <summary>{{ t('slide.method_summary') }}</summary>
    <p class="slide-aq"><span class="slide-aq-label">{{ t('slide.aq_label') }}</span> {{ t('slide.10.aq', previous=season_changes.previous_label, metrics=season_changes.metrics_label, min=season_changes.min_minutes) }}</p>
    <p class="slide-did"><span class="slide-did-label">{{ t('slide.did_label') }}</span> {{ t('slide.10.did') }}</p>
    <p class="slide-how"><span class="slide-how-label">{{ t('slide.how_label') }}</span> {{ t('slide.10.how', min=season_changes.min_minutes) }}</p>
    </details>
    <p class="slide-so">{{ t('slide.10.so') }}</p>
  </div>
</section>
{% endif %}

