          <text x="515" y="256" class="bp-ledger-count">{{ t('ch4.built.svg.rulings', n=facts.n_rulings) }}</text></g>
      </svg>
      <p class="build-diagram-legend">{{ t('ch4.built.legend', impl=build_process.implementers, rev=build_process.reviewers, ctrl=build_process.controller) }}</p>
      <p>{{ t('ch4.built.peer_review', n_reviews=facts.n_reviews, n_tasks=facts.n_tasks) }}</p>
