{# =============================================================================
   EXPLORE THE DATA — folded; today's chapters I-III material, minus the
   exhibits already used as a slide's proof above. Six top-level folds
   (Task 13b brief); ids kept so old deep links still land somewhere.
   ============================================================================= #}
<section class="explore" id="explore">
  <div class="container">
    <h2>{{ t('explore.h2') }}</h2>

    <details class="fold">
      <summary>{{ t('toc.benchmark') }}</summary>
      <div class="explore-block">
    <h3 id="benchmark">{{ t('ch1.benchmark.h3') }}</h3>
    <p>{{ t('ch1.benchmark.p') }}</p>

    <figure class="figure-bleed" data-atlas="heatmap" title="{{ t('ch1.heatmap.note') }}">
      <img src="{{ assets }}intl_cohort_heatmap.svg"
           alt="{{ t('ch1.heatmap.alt', n=hero.n_peers, season=seasons.metrics) }}">
      <figcaption>{{ t('ch1.heatmap.caption', season=seasons.metrics) }}</figcaption>
    </figure>

    {% for grp in groups %}
    <h4>{{ t('ch1.cohorts.h4', group=gt[grp] | lower) }}</h4>
    <table class="cohort-table">
      <thead>
        <tr>
          <th>{{ t('ch1.cohorts.th') }}</th>
          {% for cc in cohort_countries %}<th{% if cc == home_code %} class="cohort-cze"{% endif %}>{{ cc }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for r in cohorts[grp] %}
        <tr>
          <td>{{ r.cohort }}</td>
          {% for cc in cohort_countries %}
            {% set cell = r.cells[cc] %}
            <td{% if cc == home_code %} class="cohort-cze"{% endif %}>
              {% if cell.n > 0 %}
                <span class="cohort-cell-n">{{ cell.n }}</span><span class="cohort-cell-median">{{ f2(cell.median) }}</span>
              {% else %}
                <span class="muted" title="{{ t('ch1.cohorts.none') }}">—</span>
              {% endif %}
            </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endfor %}
    {% set gap_items = [] %}
    {% for r in cohort_gaps[:3] %}{% set _ = gap_items.append(t('ch1.cohorts.gap_item', group=gt[r.pos_group] | lower, cohort=r.cohort, cze=r.cze_n, peer=g(r.peer_median_n))) %}{% endfor %}
    <p class="capita-note">
      {{ t('ch1.cohorts.note', topn=topn, season=seasons.metrics, min=feature_defs.min_minutes, shown=cohort_countries | length,
           n=hero.n_peers, gaps=gap_items | join(', ')) }}
    </p>

    <h3 id="observations">{{ t('ch1.observations.h3') }}</h3>
    <details class="fold">
      <summary>{{ observations | map(attribute='title') | join(' · ') }}</summary>
      <div class="observations">
        {% for obs in observations %}
        <div class="observation">
          <h4>{{ obs.title }}</h4>
          <p>{{ obs.body }}</p>
        </div>
        {% endfor %}
      </div>
    </details>
      </div>
    </details>

    <details class="fold">
      <summary>{{ t('toc.clusters') }}</summary>
      <div class="explore-block">
    <h3 id="clusters">{{ t('ch1.clusters.h3') }}</h3>
    <p>{{ t('ch1.clusters.p', season=seasons.metrics, cite_rousseeuw=cite.rousseeuw_1987, cite_pedregosa=cite.pedregosa_et_al_2011) }}</p>
    {% for grp in groups %}
    {% set note = atlas_notes[grp] %}
    <figure class="figure-bleed" data-atlas="{{ grp | lower }}" data-cluster-names='{{ cluster_names.get(grp, {}) | tojson }}'>
      <img src="{{ assets }}atlas_{{ grp }}.svg"
           alt="{{ t('ch1.atlas.alt', group=gt[grp] | lower, season=seasons.metrics, corpus=note.n_corpus, czech=note.n_czech, nt=note.n_nt, nt_years=facts.nt_years) }}">
      <figcaption>{{ t('ch1.atlas.caption', group=gt[grp] | lower, season=seasons.metrics, corpus=note.n_corpus, czech=note.n_czech, nt=note.n_nt, nt_years=facts.nt_years) }}</figcaption>
    </figure>
    {% endfor %}
    {% for grp in groups %}
    <h4>{{ gt[grp] }}</h4>
    <dl class="cluster-list" data-atlas-clusters="{{ grp | lower }}">
      {% for c in clusters[grp] %}
      <dt>
        <span class="cluster-name" title="{{ c.id }}">
          {{ c.label }}
          <span class="cluster-meta-inline">
            {{ t('ch1.clusters.meta', n=c.n, corpus=c.n_corpus, nt=c.nt_pool, born=('—' if c.median_born is none else c.median_born)) }}
          </span>
        </span>
      </dt>
      <dd>
        {{ t('ch1.clusters.medians', npg=f2(c.medians.npg_p90), ast=f2(c.medians.ast_p90), share=pct(c.medians.min_share), age=g(c.medians.age), cards=f2(c.medians.cards_p90)) }}
        {% if c.tactical %}
        <span class="cluster-tactical"><span class="cluster-tactical-label">{{ t('ch1.clusters.tactical') }}</span>{{ c.tactical }}</span>
        {% endif %}
        {% if c.top %}<span class="cluster-top">{% for name in c.top %}<span class="cluster-top-name" data-player-key="{{ c.top_keys[loop.index0] }}">{{ name }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
      </dd>
      {% endfor %}
    </dl>
    {% endfor %}
      </div>
    </details>

    <details class="fold">
      <summary>{{ t('toc.trajectories') }}</summary>
      <div class="explore-block">
    <h3 id="trajectories">{{ t('ch1.traj.h3', previous=seasons.previous, metrics=seasons.metrics, min=thresholds.min_minutes) }}</h3>
    <p>{{ t('ch1.traj.p', band=f2(thresholds.direction)) }}</p>
    {% for grp in groups %}
    {% set m = movers[grp] %}
    <h4>{{ t('ch1.traj.h4', group=gt[grp], n=m.n_czech, up=m.directions.improving, stable=m.directions.stable, down=m.directions.declining) }}</h4>
    <div class="movers-grid">
      <div class="movers-col">
        <h4>{{ t('ch1.traj.up', metric=t('metric.prod.short')) }}</h4>
        <table class="movers-table">
          <thead><tr><th>{{ t('ch1.traj.th.player') }}</th><th>{{ t('ch1.traj.th.league') }}</th><th>{{ t('ch1.traj.th.min', previous=seasons.previous, metrics=seasons.metrics) }}</th><th>{{ t('ch1.traj.th.delta') }}</th></tr></thead>
          <tbody>
            {% for r in m.up %}
            <tr>
              <td data-player-key="{{ r.player_key }}">{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-up">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">{{ t('ch1.traj.none_up') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="movers-col">
        <h4>{{ t('ch1.traj.down', metric=t('metric.prod.short')) }}</h4>
        <table class="movers-table">
          <thead><tr><th>{{ t('ch1.traj.th.player') }}</th><th>{{ t('ch1.traj.th.league') }}</th><th>{{ t('ch1.traj.th.min', previous=seasons.previous, metrics=seasons.metrics) }}</th><th>{{ t('ch1.traj.th.delta') }}</th></tr></thead>
          <tbody>
            {% for r in m.down %}
            <tr>
              <td data-player-key="{{ r.player_key }}">{{ r.name }}</td>
              <td class="muted">{{ r.league }}</td>
              <td class="muted">{{ r.min_prev }} / {{ r.min_curr }}</td>
              <td class="arrow-down">{{ signed(r.delta) }}</td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="muted">{{ t('ch1.traj.none_down') }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    {% endfor %}
      </div>
    </details>

{# =============================================================================
   CHAPTER II material — pathways exhibits A-F, folded together
   ============================================================================= #}
    <details class="fold">
      <summary>{{ t('toc.pathways') }}</summary>
      <div class="explore-block">
    <h3 id="pathways">{{ t('toc.pathways') }}</h3>
    <p>{{ t('ch2.framing', n=pw.n_countries - 1) }}</p>

    <h4>{{ t('ch2.a.h3') }}</h4>
    <p>{{ t('ch2.a.p', season=seasons.metrics) }}</p>
    {% set u23 = [] %}
    {% for r in pw.youth if r.share_u23 is not none %}{% set _ = u23.append(r.country ~ ' ' ~ pct1(r.share_u23)) %}{% endfor %}
    <p class="capita-note">{{ t('ch2.a.note', season=seasons.metrics, u23=u23 | join(', ')) }}</p>

    <h4>{{ t('ch2.b.h3') }}</h4>
    <p>
      {{ t('ch2.b.p', current=seasons.current, topn=topn) }}{% if domestic_league_code in headline_leagues %} {{ t('ch2.headline_note', topn=topn) }}{% endif %}
      {% if pw.export_cze %}{{ t('ch2.b.cze', n=pw.export_cze.n, age=g(pw.export_cze.median_export_age), n_recent=pw.export_cze.n_recent,
           age_recent=g(pw.export_cze.median_export_age_recent), domestic=pct(pw.export_cze.origin.domestic)) }}{% endif %}
    </p>
    <table class="kv-table">
      <thead>
        <tr>
          <th>{{ t('ch2.b.th.country') }}</th><th>n</th><th>{{ t('ch2.b.th.recent') }}</th>
          <th>{{ t('ch2.b.th.age_all') }}</th><th>{{ t('ch2.b.th.age_recent') }}</th>
          <th>{{ t('ch2.b.th.domestic') }}</th><th>{{ t('ch2.b.th.stepping') }}</th><th>{{ t('ch2.b.th.other', topn=topn) }}</th><th>{{ t('ch2.b.th.not_covered') }}</th>
          <th>{{ t('ch2.b.th.censored') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in pw.export %}
        <tr{% if r.country == home_code %} class="cohort-cze"{% endif %}>
          <td><span class="capita-code">{{ r.country }}</span> {{ term(r.name) }}</td>
          <td>{{ r.n }}</td>
          <td>{{ r.n_recent }}</td>
          <td>{{ g(r.median_export_age) }}</td>
          <td>{{ g(r.median_export_age_recent) }}</td>
          <td>{{ pct(r.origin.domestic) }}</td>
          <td>{{ pct(r.origin.stepping_stone) }}</td>
          <td>{{ pct(r.origin.other_top9) }}</td>
          <td>{{ pct(r.origin.not_covered) }}</td>
          <td class="muted">{{ pct(r.censored_share) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">
      {{ t('ch2.b.note', start=seasons.history_start, topn=topn, metrics=seasons.metrics, current=seasons.current, coverage=facts.coverage_start, stepping=stepping_stone | join(', ')) }}
    </p>

    <h4>{{ t('ch2.c.h3') }}</h4>
    <p>{{ t('ch2.c.p', topn=topn, season=seasons.metrics) }}</p>
    {% set fare_goals_max = pw.fare_goals | map(attribute='value') | max %}
    <div class="capita" role="list" aria-label="{{ t('ch2.c.aria.goals') }}">
      {% for r in pw.fare_goals %}
      <div class="capita-row" role="listitem"
           {% if r.country == home_code %}data-highlight="cze"{% endif %}
           style="--value: {{ r.value }}; --max: {{ fare_goals_max }};">
        <div class="capita-country">
          <span class="capita-code">{{ r.country }}</span>
          {{ term(r.name) }} <span class="muted small">n = {{ r.n }}</span>
        </div>
        <div class="capita-bar" aria-hidden="true"><div class="capita-bar-fill"></div></div>
        <div class="capita-value">{{ pct(r.value) }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="capita-note">{{ t('ch2.c.note', season=seasons.metrics, proxy=term(pw.club_strength_proxy)) }}</p>

    <h4>{{ t('ch2.d.h3') }}</h4>
    <p>{{ t('ch2.d.p', season=seasons.metrics, topn=topn) }}{% if domestic_league_code in headline_leagues %} {{ t('ch2.headline_note', topn=topn) }}{% endif %}</p>
    <details class="fold fold-table">
      <summary>{{ t('ch2.d.summary') }}</summary>
      <table class="kv-table">
        <thead>
          <tr><th>{{ t('ch2.d.th.tier') }}</th><th>{{ t('ch2.d.th.group') }}</th><th>{{ t('ch2.d.th.cze_n') }}</th><th>{{ t('ch2.d.th.cze_median') }}</th><th>{{ t('ch2.d.th.peer_n') }}</th><th>{{ t('ch2.d.th.peer_median') }}</th></tr>
        </thead>
        <tbody>
          {% for r in pw.profile %}
          <tr>
            <td>{{ term(r.tier_label) }}</td>
            <td>{{ r.pos_group }}</td>
            <td class="cohort-cze">{{ r.cze_n }}</td>
            <td class="cohort-cze">{{ f2(r.cze_median) }}</td>
            <td>{{ g(r.peer_median_n) }}</td>
            <td>{{ f2(r.peer_median) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    <p class="capita-note">{{ t('ch2.d.note', season=seasons.metrics) }}</p>

    {% if pathways.destinations %}
    {% set dest = pathways.destinations %}
    <h4>{{ t('ch2.e.h3') }}</h4>
    <p>{{ t('ch2.e.p', total=dest.n_total, abroad=dest.n_abroad) }}</p>
    {% if dest.buckets %}
    <ul class="small dest-examples">
      {% for b in dest.buckets if b.examples %}
      <li><span class="capita-code">{{ term(b.label) }}</span> <code>{{ b.examples | join(' · ') }}</code></li>
      {% endfor %}
    </ul>
    <p class="capita-note">{{ t('ch2.e.note', season=seasons.metrics, definition=term(dest.sideways_definition)) }}</p>
    {% endif %}
    {% endif %}

    {% if squad_lens and squad_lens.rows %}
    {% set total_unmatched = squad_lens.rows | sum(attribute='unmatched') %}
    <h4 id="exhibit-f">{{ t('ch2.f.h3', event=squad_lens.event) }}</h4>
    {% set squad_peer_names = [] %}
    {% for r in squad_peer_rows %}{% set _ = squad_peer_names.append(term(r.name)) %}{% endfor %}
    <p>
      {{ t('ch2.f.p', n=(squad_cze_row.n if squad_cze_row else 0), event=squad_lens.event, season=squad_lens.season_label, peers=squad_peer_names | join(', ')) }}
    </p>
    <details class="fold fold-table">
      <summary>{{ t('ch2.f.detail') }}</summary>
      <table class="kv-table">
        <thead>
          <tr>
            <th>{{ t('ch2.f.th.country') }}</th>
            <th>{{ t('ch2.f.th.median_min') }}</th><th>{{ t('ch2.f.th.median_mult') }}</th>
            <th>{{ t('ch2.f.th.u22') }}</th><th>{{ t('ch2.f.th.c2325') }}</th>
            <th>{{ t('ch2.f.th.c2629') }}</th><th>{{ t('ch2.f.th.c30plus') }}</th>
          </tr>
        </thead>
        <tbody>
          {% for r in squad_lens.rows %}
          <tr{% if r.country == home_code %} class="cohort-cze"{% endif %}>
            <td><span class="capita-code">{{ r.country }}</span> {{ term(r.name) }}</td>
            <td>{{ g(r.median_minutes) }}</td>
            <td>{{ f3(r.median_multiplier) }}</td>
            <td>{{ r.cohorts['U22'] }}</td>
            <td>{{ r.cohorts['23-25'] }}</td>
            <td>{{ r.cohorts['26-29'] }}</td>
            <td>{{ r.cohorts['30+'] }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>
    <p class="capita-note">{{ t('ch2.f.note', unmatched=total_unmatched, season=squad_lens.season_label) }}</p>
    {% endif %}
      </div>
    </details>

    <details class="fold">
      <summary>{{ t('toc.analogs') }}</summary>
      <div class="explore-block">
    <h3 id="analogs">{{ t('ch3.analogs.h3') }}</h3>
    <p>{{ t('ch3.analogs.p', n=(analog_blocks[0].analogs | length if analog_blocks else 0), topn=topn, start=seasons.history_start, coverage=facts.coverage_start) }}</p>
    {% for tb in analog_blocks %}
    <div class="analog-block" data-player-key="{{ tb.player_key }}">
      <div class="analog-target">
        <p class="analog-label">{{ t('ch3.analogs.target') }}</p>
        <p class="analog-name">{{ tb.target.name }}</p>
        <p class="analog-stats">
          {{ t('ch3.analogs.target_stats', group=tb.pos_group, age=tb.target.age, league=tb.target.league, season=tb.target.season, min=tb.target.min, q=f2(tb.target.npg_ast_q)) }}
        </p>
        <p class="analog-cohort">{{ t('ch3.analogs.cohort', n=tb.analogs | length) }}</p>
      </div>
      <ol class="analog-list">
        {% for a in tb.analogs %}
        <li class="analog-row">
          <div class="analog-row-head">
            <span class="analog-rank">{{ a.rank }}</span>
            <span class="analog-row-name">{{ a.name }}</span>
            <span class="analog-row-country">{{ a.nation }}</span>
            <span class="analog-row-context">
              {{ t('ch3.analogs.row', league=a.league, season=a.season, min=a.min, q=f2(a.npg_ast_q), d=f2(a.distance)) }}
            </span>
          </div>
          {% if a.followed %}
          <div class="analog-row-trajectory">
            <span class="analog-traj-label">{{ t('ch3.analogs.followed') }}</span>
            {% for s in a.followed %}
            <span class="analog-traj-step">
              {{ s.season }}&nbsp;
              <span class="analog-traj-detail">{{ s.league }}&nbsp;&middot;&nbsp;{{ s.min }}&nbsp;{{ t('ch3.card.min') }}&nbsp;&middot;&nbsp;{{ f2(s.npg_ast_q) }}</span>
            </span>
            {% endfor %}
          </div>
          {% else %}
          <div class="analog-row-trajectory"><span class="analog-traj-label">{{ t('ch3.analogs.none') }}</span></div>
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </div>
    {% endfor %}
    <p class="capita-note">{{ t('ch3.analogs.note', min=feature_defs.min_minutes, start=seasons.history_start, current=seasons.current, coverage=facts.coverage_start) }}</p>
      </div>
    </details>

    <details class="fold">
      <summary>{{ t('toc.players') }}</summary>
      <div class="explore-block">
    <h3 id="players">{{ t('pi.h2') }}</h3>
    <p class="framing">{{ t('pi.framing', season=seasons.metrics, n=player_index | length) }}</p>
    <div class="player-index-tools">
      <label for="player-search">{{ t('pi.search') }}</label>
      <input type="search" id="player-search" placeholder="{{ t('pi.search.placeholder') }}" autocomplete="off" spellcheck="false">
      <span class="player-index-count" aria-live="polite" data-total="{{ player_index | length }}">{{ player_index | length }}</span>
    </div>
    <details class="fold fold-table player-index-fold">
      <summary>{{ t('pi.summary', n=player_index | length) }}</summary>
    <table class="player-index-table">
      <thead>
        <tr>
          <th>{{ t('pi.th.player') }}</th><th>{{ t('pi.th.pos') }}</th><th>{{ t('pi.th.age') }}</th>
          <th>{{ t('pi.th.club') }}</th><th>{{ t('pi.th.league') }}</th><th>{{ t('pi.th.min') }}</th>
          <th title="{{ t('metric.prod') }}">{{ t('metric.prod.short') }}</th><th>{{ t('pi.th.cluster') }}</th><th>{{ t('pi.th.nt') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in player_index %}
        <tr data-player-key="{{ r.player_key }}" data-fbref-id="{{ r.fbref_id }}" data-name="{{ r.ascii_name }}">
          <td>{% if r.card_id %}<a href="#card-{{ r.card_id }}">{{ r.player }}</a>{% else %}{{ r.player }}{% endif %}</td>
          <td>{{ r.pos_group }}</td>
          <td>{{ r.age if r.age is not none else '—' }}</td>
          <td>{{ r.club }}</td>
          <td class="muted">{{ r.league }}</td>
          <td>{{ r.min }}</td>
          <td>{{ f2(r.npg_ast_q) }}</td>
          <td title="{{ r.cluster_style }}">{{ r.cluster_label }}</td>
          <td>{% if r.nt_flag %}{{ t('pi.nt_yes') }}{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </details>
    <p class="capita-note">{{ t('pi.note', season=seasons.metrics, min=feature_defs.min_minutes, nt_years=facts.nt_years) }}</p>
      </div>
    </details>
  </div>
</section>


{# =============================================================================
   CHAPTER IV — METHODOLOGY
   ============================================================================= #}
<aside class="chapter-divider" role="separator" aria-label="{{ t('ch4.aria') }}">
  <p class="chapter-numeral">IV</p>
  <span class="chapter-mark" aria-hidden="true"></span>
  <p class="chapter-title">{{ t('ch4.title') }}</p>
  <p class="chapter-synopsis">{{ t('ch4.synopsis') }}</p>
</aside>

<section class="methodology">
  <div class="container">
    <h2 id="methodology">{{ t('ch4.h2') }}</h2>

    <h3 id="data-sources">{{ t('ch4.sources.h3') }}</h3>
    <ul>
      <li>{{ t('ch4.sources.fbref', topn=topn) }}</li>
      <li>{{ t('ch4.sources.wikipedia', events=facts.nt_events) }}</li>
      <li>{{ t('ch4.sources.wikidata') }}</li>
      <li>{{ t('ch4.sources.uefa') }}</li>
      <li>{{ t('ch4.sources.eurostat') }}</li>
    </ul>

    {% if feature_eda.raw_row %}
    <h3 id="features-from-raw">{{ t('ch4.eda.h3') }}</h3>
    <p>{{ t('ch4.eda.intro', season=feature_eda.metrics_season, player=feature_eda.feature_player) }}</p>

    <details class="fold">
      <summary>{{ t('ch4.eda.tables.summary', player=feature_eda.feature_player) }}</summary>
      <table class="kv-table">
        <caption>{{ t('ch4.eda.raw.caption', season=feature_eda.metrics_season) }}</caption>
        <thead><tr><th>{{ t('ch4.eda.raw.th.column') }}</th><th>{{ t('ch4.eda.raw.th.value') }}</th></tr></thead>
        <tbody>
          {% for col in feature_eda.raw_columns %}
          <tr><td><code>{{ col }}</code></td><td>{{ feature_eda.raw_row[col] if feature_eda.raw_row[col] is not none else '—' }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
      <table class="kv-table">
        <caption>{{ t('ch4.eda.feature.caption') }}</caption>
        <thead><tr>
          <th>{{ t('ch4.eda.feature.th.feature') }}</th><th>{{ t('ch4.eda.feature.th.raw') }}</th>
          <th>{{ t('ch4.eda.feature.th.shrunk') }}</th><th>{{ t('ch4.eda.feature.th.quality') }}</th>
          <th>{{ t('ch4.eda.feature.th.z') }}</th>
        </tr></thead>
        <tbody>
          {% for f in feature_eda.feature_rows %}
          <tr>
            <td><code>{{ f.name }}</code></td><td>{{ f3(f.raw) }}</td><td>{{ f3(f.shrunk) }}</td>
            <td>{{ f3(f.quality) }}</td><td>{{ f2(f.z) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </details>

    <p>{{ t('ch4.eda.cleaning.p') }}</p>
    <ul>
      {% for c in data_quality.checks %}
      <li>{{ c.label }}: {{ c.count if c.count is not none else '—' }} {{ c.unit }}.</li>
      {% endfor %}
    </ul>
    <p class="capita-note">{{ t('ch4.eda.cleaning.link') }}</p>

    <p>{{ t('ch4.eda.features.p', cite_efron_morris=cite.efron_morris_1975) }}</p>
    <ul class="eda-feature-list">
      <li><code>npg_p90</code> — {{ t('ch4.eda.features.npg_p90.def') }}: {{ t('ch4.eda.features.npg_p90.why') }}</li>
      <li><code>ast_p90</code> — {{ t('ch4.eda.features.ast_p90.def') }}: {{ t('ch4.eda.features.ast_p90.why') }}</li>
      <li><code>min_share</code> — {{ t('ch4.eda.features.min_share.def') }}: {{ t('ch4.eda.features.min_share.why') }}</li>
      <li><code>age</code> — {{ t('ch4.eda.features.age.def') }}: {{ t('ch4.eda.features.age.why') }}</li>
      <li><code>cards_p90</code> — {{ t('ch4.eda.features.cards_p90.def') }}: {{ t('ch4.eda.features.cards_p90.why') }}</li>
    </ul>

    <p>{{ t('ch4.eda.rejected.p', season=feature_eda.metrics_season) }}</p>
    <table class="kv-table">
      <thead><tr>
        <th>{{ t('ch4.eda.rejected.th.candidate') }}</th><th>{{ t('ch4.eda.rejected.th.statistic') }}</th>
        <th>{{ t('ch4.eda.rejected.th.value') }}</th><th>{{ t('ch4.eda.rejected.th.decision') }}</th>
      </tr></thead>
      <tbody>
        {% for r in feature_eda.rejected %}
        <tr><td><code>{{ r.candidate }}</code></td><td>{{ r.statistic }}</td><td>{{ f3(r.value) }}</td><td>{{ r.decision }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">{{ t('ch4.eda.rejected.note', top3=feature_eda.penalty_top_text, age_range=feature_eda.age_band_range) }}</p>

    <p>{{ t('ch4.eda.fig1.caption') }}</p>
    <figure class="figure-bleed">
      <img src="{{ assets }}eda_distributions.svg" alt="{{ t('ch4.eda.fig1.alt', n=feature_eda.n_leagues) }}">
    </figure>

    {% if feature_eda.most_shrunk %}
    <p>{{ t('ch4.eda.fig2.caption', phantom=feature_defs.phantom_minutes, player=feature_eda.most_shrunk.player) }}</p>
    <figure class="figure-bleed">
      <img src="{{ assets }}eda_shrinkage.svg" alt="{{ t('ch4.eda.fig2.alt') }}">
    </figure>
    {% endif %}
    {% endif %}

    <h3 id="multipliers">{{ t('ch4.mult.h3') }}</h3>
    <p class="formula" data-tex="{{ t('ch4.mult.tex') }}">{{ t('ch4.mult.formula') }}</p>
    <table class="kv-table">
      <thead><tr><th>{{ t('ch4.mult.th.league') }}</th><th>{{ t('ch4.mult.th.value') }}</th></tr></thead>
      <tbody>
        {% for r in multipliers %}
        <tr><td>{{ r.league }}</td><td>{{ f3(r.value) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="muted small">{{ t('ch4.mult.method', method=multiplier_method, source=term(multiplier_source)) }}</p>

    {% if league_strength.leagues %}
    <h3 id="league-strength">{{ t('ch4.strength.h3') }}</h3>
    <p>{{ t('ch4.strength.p1_is_ref') if league_strength.home_is_reference else t('ch4.strength.p1') }}</p>
    <p>{{ t('ch4.strength.design', players=league_strength.fit.players, rows=league_strength.fit.rows,
             cite_bda=cite.gelman_et_al_2013, cite_nuts=cite.hoffman_gelman_2014, cite_pymc=cite.abril_pla_et_al_2023,
             cite_arviz=cite.kumar_et_al_2019, cite_rapm=cite_multi(['kharrat_mchale_pena_2020', 'hvattum_2019'])) }}</p>
    <figure class="figure-bleed">
      <img src="{{ assets }}league_strength.svg" alt="{{ t('ch4.strength.fig_alt') }}">
    </figure>
    {% if league_strength.home_is_reference %}
    <p>{{ t('ch4.strength.home_is_ref') }}</p>
    {% elif league_strength.home %}
    <p>{{ t('ch4.strength.home', median=f2(league_strength.home.median),
             lo=f2(league_strength.home.hdi_lo), hi=f2(league_strength.home.hdi_hi)) }}</p>
    {% endif %}
    <table class="kv-table strength-table">
      <thead><tr>
        <th>{{ t('ch4.strength.th.league') }}</th><th>{{ t('ch4.strength.th.median') }}</th>
        <th>{{ t('ch4.strength.th.hdi') }}</th><th>{{ t('ch4.strength.th.transitions') }}</th>
        <th>{{ t('ch4.strength.th.uefa') }}</th>
      </tr></thead>
      <tbody>
        {% for r in league_strength.leagues %}
        <tr {% if r.league == domestic_league_code %}data-highlight="cze"{% endif %}>
          <td>{{ r.league }}</td><td>{{ f3(r.median) }}</td>
          <td>{{ f3(r.hdi_lo) }}–{{ f3(r.hdi_hi) }}</td>
          <td class="num">{{ r.n_transitions }}</td>
          <td>{{ f3(r.uefa) if r.uefa is not none else '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <p>{{ t('ch4.strength.oos.p', season=league_strength.oos.metrics_season, n=league_strength.oos.n_candidates,
             cite_cies=cite.poli_ravenel_besson_2024) }}</p>
    <table class="kv-table">
      <thead><tr>
        <th>{{ t('ch4.strength.oos.th.method') }}</th><th>{{ t('ch4.strength.oos.th.logpd') }}</th>
        <th>{{ t('ch4.strength.oos.th.mae') }}</th>
      </tr></thead>
      <tbody>
        {% for r in league_strength.oos.rows %}
        <tr>
          <td>{{ r.method_label }}</td>
          <td>{{ f3(r.log_pred_density) }}</td>
          <td>{{ f3(r.mae) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <p>{{ t('ch4.strength.spearman', n=league_strength.spearman.n, rho=f2(league_strength.spearman.rho)) }}</p>
    <ul class="disagreements">
      {% for d in league_strength.disagreements %}
      <li>{{ t('ch4.strength.disagreement', league=d.league, model_rank=d.model_rank, uefa_rank=d.uefa_rank,
                model_median=f2(d.model_median), uefa=f2(d.uefa)) }}</li>
      {% endfor %}
    </ul>

    <p>{{ t('ch4.strength.diagnostics', rhat=f3(league_strength.diagnostics.max_rhat),
             ess=(league_strength.diagnostics.min_ess_bulk | round | int), div=league_strength.diagnostics.n_divergences,
             rows=league_strength.fit.rows, players=league_strength.fit.players,
             runtime=(league_strength.fit.runtime_s | round | int)) }}</p>

    <details class="fold">
      <summary>{{ t('ch4.strength.ppc.summary') }}</summary>
      <p>{{ t('ch4.strength.ppc.p', obs_zero=pct(league_strength.ppc.observed.zero_share), rep_zero=pct(league_strength.ppc.replicated.zero_share),
               obs_mean=f2(league_strength.ppc.observed.mean), rep_mean=f2(league_strength.ppc.replicated.mean),
               obs_p90=f2(league_strength.ppc.observed.p90), rep_p90=f2(league_strength.ppc.replicated.p90),
               cite_ppc=cite.vehtari_gelman_gabry_2017) }}</p>
      <figure class="figure-bleed">
        <img src="{{ assets }}league_strength_ppc.svg" alt="{{ t('ch4.strength.ppc.fig_alt') }}">
      </figure>
    </details>
    <p>{{ t('ch4.strength.selection') }}</p>

    <p>{{ t('ch4.strength.ranking') }}</p>
    {% endif %}

    {% if model_comparison.table %}
    <h3 id="model-comparison">{{ t('ch4.compare.h3') }}</h3>
    <p>{{ t('ch4.compare.q', min=feature_defs.min_minutes) }}</p>
    <p>{{ t('ch4.compare.design', n_origins=model_comparison.origins | length, cite_ro=cite.hyndman_athanasopoulos_2021,
             chains=model_comparison.bayes_chains, draws=model_comparison.bayes_draws, cite_bayes=cite.gelman_et_al_2013,
             cite_sklearn=cite.pedregosa_et_al_2011, max_train=model_comparison.bayes_max_train) }}</p>
    <figure class="figure-bleed">
      <img src="{{ assets }}model_comparison.svg" alt="{{ t('ch4.compare.fig_alt') }}">
    </figure>
    <table class="kv-table compare-table">
      <thead><tr>
        <th>{{ t('ch4.compare.th.model') }}</th>
        {% for o in model_comparison.origin_labels %}<th>{{ o }}</th>{% endfor %}
        <th>{{ t('ch4.compare.th.pooled') }}</th>
      </tr></thead>
      <tbody>
        {% for row in model_comparison.table %}
        <tr {% if model_comparison.winner and row.model == model_comparison.winner.model %}data-highlight="winner"{% endif %}>
          <td>{{ row.label }}</td>
          {% for cell in row.cells %}
          <td>{% if cell %}{{ f3(cell.rmse) }} ({{ f3(cell.mae) }}){% else %}—{% endif %}</td>
          {% endfor %}
          <td>{{ f3(row.pooled.rmse) }} ({{ f3(row.pooled.mae) }})</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">{{ t('ch4.compare.note') }}</p>

    {% if model_comparison.bayesian_coverage %}
    <p>{{ t('ch4.compare.coverage', pooled=pct(model_comparison.bayesian_pooled_coverage), n=model_comparison.bayesian_coverage | length,
             per_origin=model_comparison.bayesian_coverage_text) }}</p>
    {% endif %}

    {% if model_comparison.winner %}
    <p>{{ t('ch4.compare.winner', winner=model_comparison.winner_label, rmse=f3(model_comparison.winner.rmse),
             persistence_rmse=f3(model_comparison.persistence_pooled_rmse), margin=pct(model_comparison.margin)) }}</p>
    {% endif %}
    {% if model_comparison.drift %}
    <p>{{ t('ch4.compare.drift', from=model_comparison.drift.from, to=model_comparison.drift.to, value=f3(model_comparison.drift.value)) }}</p>
    {% endif %}
    {% endif %}

    {% if series_model.break %}
    <h3 id="series-model">{{ t('ch4.series.h3') }}</h3>
    <p>{{ t('ch4.series.design', cite_ss=cite.durbin_koopman_2012, margin=series_model.margin, cite_marg=cite.gelman_et_al_2013,
             cite_cp=cite.adams_mackay_2007, cite_ro=cite.hyndman_athanasopoulos_2021,
             n_backtest=series_model.backtest.rows | length) }}</p>
    <figure class="figure-bleed">
      <img src="{{ assets }}series_model.svg" alt="{{ t('ch4.series.fig_alt') }}">
    </figure>
    <p>{{ t('ch4.series.break.p', season=series_model.break.season, prob=pct(series_model.break.prob),
             delta=f2(series_model.break.delta), lo=f2(series_model.break.lo), hi=f2(series_model.break.hi),
             sigma=f3(series_model.break.sigma)) }}</p>
    <ul class="break-top">
      {% for r in series_model.break.top %}
      <li>{{ t('ch4.series.break.top_item', season=r.season, prob=pct(r.prob)) }}</li>
      {% endfor %}
    </ul>
    <p>{{ t('ch4.series.contrast.p') }}</p>
    <ul class="contrast-break">
      {% for c in series_model.contrast %}
      <li>{{ t('ch4.series.contrast.item', name=term(c.name), season=c.season, prob=pct(c.prob),
                delta=f2(c.delta), lo=f2(c.lo), hi=f2(c.hi)) }}</li>
      {% endfor %}
    </ul>

    <p>{{ t('ch4.series.backtest.p', n=series_model.backtest.rows | length, start=series_model.backtest.start, end=series_model.backtest.end) }}</p>
    <table class="kv-table series-backtest-table">
      <thead><tr>
        <th>{{ t('ch4.series.backtest.th.origin') }}</th><th>{{ t('ch4.series.backtest.th.next') }}</th>
        <th>{{ t('ch4.series.backtest.th.actual') }}</th><th>{{ t('ch4.series.backtest.th.model') }}</th>
        <th>{{ t('ch4.series.backtest.th.naive') }}</th>
      </tr></thead>
      <tbody>
        {% for r in series_model.backtest.rows %}
        <tr>
          <td>{{ r.origin }}</td><td>{{ r.next_season }}</td><td class="num">{{ g(r.actual) }}</td>
          <td class="num">{{ g(r.median) }} ({{ g(r.lo) }}–{{ g(r.hi) }})</td><td class="num">{{ g(r.naive) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p>{{ t('ch4.series.backtest.note', n=series_model.backtest.rows | length, mae_model=f2(series_model.backtest.pooled.mae_model),
             mae_naive=f2(series_model.backtest.pooled.mae_naive), coverage=pct(series_model.backtest.pooled.coverage90)) }}</p>

    <p>{{ t('ch4.series.forecast.p', season=series_model.forecast[0].season) }}</p>
    <table class="kv-table series-forecast-table">
      <thead><tr>
        <th>{{ t('ch4.series.forecast.th.country') }}</th><th>{{ t('ch4.series.forecast.th.season') }}</th>
        <th>{{ t('ch4.series.forecast.th.median') }}</th><th>{{ t('ch4.series.forecast.th.interval') }}</th>
      </tr></thead>
      <tbody>
        {% for f in series_model.forecast %}
        <tr {% if f.code == home_code %}data-highlight="cze"{% endif %}>
          <td>{{ term(f.name) }}</td><td>{{ f.season }}</td><td class="num">{{ g(f.median) }}</td>
          <td class="num">{{ g(f.lo) }}–{{ g(f.hi) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">{{ t('ch4.series.forecast.note') }}</p>

    <p>{{ t('ch4.series.diagnostics', rhat=f3(series_model.diagnostics.max_rhat),
             ess=(series_model.diagnostics.min_ess_bulk | round | int), div=series_model.diagnostics.n_divergences,
             t=(big5.seasons | length)) }}</p>
    {% endif %}

    <h3 id="shrinkage">{{ t('ch4.shrink.h3') }}</h3>
    <p>{{ t('ch4.shrink.p1', phantom=feature_defs.phantom_minutes, cite_efron_morris=cite.efron_morris_1975) }}</p>
    <p class="formula" data-tex="{{ t('ch4.shrink.tex') }}">{{ t('ch4.shrink.formula') }}</p>
    <p>{{ t('ch4.shrink.p2', min=feature_defs.min_minutes, weight=pct(feature_defs.phantom_minutes / (feature_defs.min_minutes + feature_defs.phantom_minutes)), phantom=feature_defs.phantom_minutes) }}</p>
    {% if gk %}
    <p>{{ t('ch4.gk.p', phantom=gk.phantom_minutes) }}</p>
    {% endif %}

    <h3 id="pca-loadings">{{ t('ch4.pca.h3') }}</h3>
    <p>{{ t('ch4.pca.p', features=feature_defs.features | join(', ')) }}</p>
    <table class="loadings-table">
      <thead>
        <tr>
          <th>{{ t('ch4.pca.th.group') }}</th><th>{{ t('ch4.pca.th.projection') }}</th><th>PC</th><th>{{ t('ch4.pca.th.variance') }}</th>
          <th>npG/90</th><th>A/90</th><th>{{ t('ch4.pca.th.share') }}</th><th>{{ t('ch4.pca.th.age') }}</th><th>cards/90</th>
        </tr>
      </thead>
      <tbody>
        {% for r in loadings %}
        <tr>
          <td>{{ r.position }}</td>
          <td>{{ r.projection }}</td>
          <td>{{ r.pc }}</td>
          <td>{{ r.explained_pct }} %</td>
          <td>{{ f3(r.npg_p90) }}</td>
          <td>{{ f3(r.ast_p90) }}</td>
          <td>{{ f3(r.min_share) }}</td>
          <td>{{ f3(r.age) }}</td>
          <td>{{ f3(r.cards_p90) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h3 id="sensitivity">{{ t('ch4.sens.h3') }}</h3>
    <p>
      {{ t('ch4.sens.p', groups=groups | length, base=sensitivity.baseline_top10, n=sensitivity.n_scenarios, zero=sensitivity.n_zero_churn, churn=sensitivity.max_churn,
           worst=(t('ch4.sens.worst', description=sensitivity.worst.description, delta=f2(sensitivity.worst.mean_delta)) if sensitivity.worst else '')) }}
    </p>
    <table class="sensitivity-table">
      <thead>
        <tr>
          <th>{{ t('ch4.sens.th.scenario') }}</th><th>{{ t('ch4.sens.th.description') }}</th>
          <th>{{ t('ch4.sens.th.overlap') }}</th><th>{{ t('ch4.sens.th.churn') }}</th><th>{{ t('ch4.sens.th.delta') }}</th>
        </tr>
      </thead>
      <tbody>
        {% for r in sensitivity.rows %}
        <tr>
          <td>{{ r.scenario }}</td>
          <td>{{ r.description }}</td>
          <td>{{ r.overlap }} / {{ sensitivity.baseline_top10 }}</td>
          <td>{{ r.churn }}</td>
          <td>{{ f2(r.mean_delta) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="capita-note">{{ t('ch4.sens.note') }}</p>

    {% if data_quality.checks or data_quality.events %}
    <h3 id="data-quality">{{ t('ch4.dq.h3') }}</h3>
    <details class="fold">
      <summary>{{ t('ch4.dq.summary', n_checks=data_quality.checks | length, n_events=data_quality.events | length) }}</summary>
      <p>{{ t('ch4.dq.p') }}</p>
      <table class="dq-table"><thead><tr><th>{{ t('ch4.dq.col.check') }}</th><th>{{ t('ch4.dq.col.count') }}</th><th>{{ t('ch4.dq.col.what') }}</th></tr></thead>
      <tbody>{% for r in data_quality.checks %}<tr><td>{{ r.label }}</td><td class="num">{{ r.count if r.count is not none else '—' }} {{ r.unit }}</td><td>{{ r.what }}</td></tr>{% endfor %}</tbody></table>
      <ul class="dq-events">{% for e in data_quality.events %}<li><span class="mono">{{ e.date }}</span> {{ e.text }}{% if e.recorded_count %} <span class="mono">({{ t('ch4.dq.recorded', n=e.recorded_count, unit=e.unit) }})</span>{% endif %}</li>{% endfor %}</ul>
    </details>
    {% endif %}

    <h3 id="limitations">{{ t('ch4.lim.h3') }}</h3>
    <div class="limitations">
      {% for l in limitations %}
      <p><strong>{{ l.title }}.</strong> {{ l.body }}</p>
      {% endfor %}
    </div>

    <h3 id="validation-robustness">{{ t('ch4.validation.h3') }}</h3>
    <p>{{ t('ch4.validation.stub') }}</p>
    <ul>
      {% if model_comparison.table %}
      <li>{{ t('ch4.validation.m1', n_origins=model_comparison.origins | length, winner=model_comparison.winner_label,
                rmse=f3(model_comparison.winner.rmse), persistence_rmse=f3(model_comparison.persistence_pooled_rmse),
                coverage=pct(model_comparison.bayesian_pooled_coverage)) }}</li>
      {% endif %}
      {% if league_strength.leagues %}
      <li>{{ t('ch4.validation.m2', rhat=f3(league_strength.diagnostics.max_rhat), div=league_strength.diagnostics.n_divergences,
                oos_winner=(league_strength.oos.winner.method_label if league_strength.oos.winner else '—'),
                oos_logpd=(f3(league_strength.oos.winner.log_pred_density) if league_strength.oos.winner else '—'),
                rho=f2(league_strength.spearman.rho)) }}</li>
      {% endif %}
      {% if series_model.break %}
      <li>{{ t('ch4.validation.m3', season=series_model.break.season, prob=pct(series_model.break.prob),
                delta=f2(series_model.break.delta), mae_model=f2(series_model.backtest.pooled.mae_model),
                mae_naive=f2(series_model.backtest.pooled.mae_naive), coverage=pct(series_model.backtest.pooled.coverage90),
                n=series_model.backtest.rows | length) }}</li>
      {% endif %}
    </ul>

    <h3 id="reproducibility">{{ t('ch4.repro.h3') }}</h3>
    <p>{{ t('ch4.repro.p', url=repo_url, url_short=repo_url | replace('https://', ''), seed=seed) }}</p>

    <h3 id="how-built">{{ t('ch4.built.h3') }}</h3>
    <details class="fold">
      <summary>{{ t('ch4.built.summary', n_rulings=facts.n_rulings, n_tests=facts.n_tests) }}</summary>
      <p>{{ t('ch4.built.p1', n_rulings=facts.n_rulings, n_tests=facts.n_tests) }}</p>
      <ol class="build-flow">
        <li>{{ t('ch4.built.flow.spec') }}</li>
        <li>{{ t('ch4.built.flow.plan') }}</li>
        <li>{{ t('ch4.built.flow.agent') }}</li>
        <li>{{ t('ch4.built.flow.review') }}</li>
        <li>{{ t('ch4.built.flow.ledger') }}</li>
      </ol>
      <p>{{ t('ch4.built.p2', spec=spec_url, plan=plan_url, ledger=ledger_url) }}</p>
    </details>

    <h3 id="references">{{ t('ch4.refs.h3') }}</h3>
    <ul class="references-list">
      {% for r in references %}
      <li id="ref-{{ r.key }}">{% if r.href %}<a href="{{ r.href }}">{{ r.citation }}</a>{% else %}{{ r.citation }}{% endif %}</li>
      {% endfor %}
    </ul>
  </div>
</section>

<footer>
  <div class="container">
    <div class="role-block">
      <p class="role-kicker">{{ t('foot.kicker') }}</p>
      <p class="role-body">{{ t('foot.body') }}</p>
      <p class="role-author">
        <span class="role-author-name">Barbora Šandová</span>
        <span class="role-author-contact">
          <a href="mailto:barbora@datasimply.eu">barbora@datasimply.eu</a>
          &middot;
          <a href="{{ repo_url }}">{{ repo_url | replace('https://', '') }}</a>
        </span>
      </p>
    </div>
    <div class="photo-credits" id="photo-credits">
      <details class="fold">
        <summary>{{ t('foot.credits', n=photo_credits | length) }}</summary>
        <ul class="small">
          {% for c in photo_credits %}
          <li data-fbref-id="{{ c.fbref_id }}" data-player-key="{{ c.player_key }}">
            {{ c.name }} — <a href="https://commons.wikimedia.org/wiki/File:{{ c.credit | replace(' ', '_') }}">{{ c.credit }}</a>, {{ c.license }}
          </li>
          {% endfor %}
        </ul>
      </details>
    </div>
    <p class="rendered-at">{{ t('foot.rendered', at=rendered_at) }}</p>
  </div>
</footer>

<script>
  (() => {
    const toc = document.getElementById('toc');
    if (!toc) return;
    const btn = toc.querySelector('.toc-toggle');
    if (!btn) return;
    const KEY = 'atlas-toc-collapsed';
    const apply = (collapsed) => {
      toc.dataset.collapsed = collapsed ? 'true' : 'false';
      btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      btn.setAttribute('aria-label', collapsed ? btn.dataset.labelShow : btn.dataset.labelHide);
    };
    try {
      apply(localStorage.getItem(KEY) === 'true');
    } catch (e) {
      apply(false);
    }
    btn.addEventListener('click', () => {
      const next = toc.dataset.collapsed !== 'true';
      apply(next);
      try { localStorage.setItem(KEY, next ? 'true' : 'false'); } catch (e) {}
    });
  })();
</script>

</body>
</html>
